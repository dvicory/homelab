+def recover_pending_workspace_finalizations(conn: sqlite3.Connection) -> list[str]:
+    """Replay durable completion intents before crashed workers are reclaimed."""
+    rows = conn.execute(
+        """
+        SELECT o.operation_id, o.task_id, o.run_id, o.request_json
+          FROM task_workspace_operations AS o
+          JOIN tasks AS t ON t.id = o.task_id
+         WHERE o.kind = 'publication'
+           AND o.state = 'pending'
+           AND t.status = 'running'
+           AND t.current_run_id = o.run_id
+         ORDER BY o.created_at ASC
+        """
+    ).fetchall()
+    recovered: list[str] = []
+    for row in rows:
+        try:
+            request = json.loads(row["request_json"])
+            completion = request.get("completion")
+            selected_roots = request.get("selected_roots")
+            if not isinstance(completion, dict) or not isinstance(selected_roots, list):
+                raise RuntimeError("workspace completion journal is invalid")
+            if complete_task(
+                conn,
+                row["task_id"],
+                result=completion.get("result"),
+                summary=completion.get("summary"),
+                metadata=completion.get("metadata"),
+                created_cards=completion.get("created_cards"),
+                workspace_outputs=selected_roots,
+                expected_run_id=int(row["run_id"]),
+            ):
+                recovered.append(row["task_id"])
+        except Exception as error:
+            record_workspace_operation_error(
+                conn, operation_id=row["operation_id"], error=error
+            )
+            _log.warning(
+                "workspace finalization replay failed for %s: %s",
+                row["task_id"],
+                error,
+            )
+    return recovered
+
 
