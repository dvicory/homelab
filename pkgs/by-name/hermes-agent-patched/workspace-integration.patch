+def _relation_digest(
+    *, board: str, source_task_id: str, destination_task_id: str, tenant: str | None
+) -> str:
+    facts = {
+        "board": board,
+        "destinationTaskId": destination_task_id,
+        "sourceTaskId": source_task_id,
+        "tenant": tenant,
+    }
+    encoded = json.dumps(facts, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
