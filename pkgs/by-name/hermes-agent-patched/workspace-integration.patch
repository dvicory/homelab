+    (workspace / "output").mkdir(parents=True)
+    declared = workspace / "output" / "report.txt"
+    declared.write_text("native")
+    prose_only = workspace / "outside-secret.txt"
+    prose_only.write_text("must not upload")
+    kb.init_db()
+    with kb.connect() as conn:
+        task_id = kb.create_task(
