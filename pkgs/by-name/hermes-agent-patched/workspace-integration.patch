+        if route.endswith("/status"):
+            return {
+                "workspaceId": "workspace-recovered",
+                "workspaceLeaseId": "lease-recovered",
+                "policyDigest": "b" * 64,
+            }
+        if route.endswith("/activate"):
+            return {"activationId": "activation-recovered", "epoch": 1}
+        raise AssertionError(route)
+
+    monkeypatch.setattr(plugin, "_request", request)
+
+    with pytest.raises(RuntimeError, match="broker offline"):
+        plugin._on_prepare_worker_environment(
+            task_id=child.id,
+            run_id=child.current_run_id,
+            board=kb.get_current_board(),
+        )
+    with kb.connect() as connection:
+        operation = connection.execute(
+            "SELECT state, last_error FROM task_workspace_operations "
+            "WHERE task_id=? AND kind='preparation'",
+            (child.id,),
+        ).fetchone()
+        assert operation["state"] == "pending"
+        assert "broker offline" in operation["last_error"]
+
+    recovered = plugin._on_prepare_worker_environment(
+        task_id=child.id,
+        run_id=child.current_run_id,
+        board=kb.get_current_board(),
+    )
+    assert recovered["environment"]["HERMES_WORKSPACE_ID"] == "workspace-recovered"
+    assert len(preparation_ids) == 2
+    assert preparation_ids[0] == preparation_ids[1]
+    with kb.connect() as connection:
+        assert connection.execute(
+            "SELECT state FROM task_workspace_operations "
+            "WHERE task_id=? AND kind='preparation'",
+            (child.id,),
+        ).fetchone()["state"] == "ready"
+
