+"""Broker-backed workspace capture/import/export lifecycle hooks.
+
+Hermes owns only intent rows in the existing task_events table.  The broker
+owns every activation, handoff, import, export, lease, and replay journal.
+"""
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import os
+import secrets
+from typing import Any
+
+from hermes_cli import kanban_db as kb
+from tools.environments.gondolin import BrokerClient, BrokerError, broker_environment_key
+
+_CONTROL_ENV = "GONDOLIN_EFFECT_CONTROL_SOCKET"
+_HANDOFF_ENV = "HERMES_WORKSPACE_HANDOFF"
+_MAX_ATTEMPT_SECONDS = 300
+
+
+def _enabled() -> bool:
+    return os.environ.get(_HANDOFF_ENV, "").strip() == "1"
+
+
+def _client() -> BrokerClient:
+    endpoint = os.environ.get(_CONTROL_ENV, "").strip()
+    if not endpoint:
+        raise RuntimeError("workspace control socket is missing")
+    return BrokerClient(endpoint, timeout=30.0)
+
+
+def _board_name(board: str | None) -> str:
+    if not board or not str(board).strip():
+        raise RuntimeError("workspace board context is missing")
+    return str(board).strip()
+
+
+def _opaque_id(prefix: str) -> str:
+    return f"{prefix}_{secrets.token_hex(16)}"
+
+
+def _stable_delivery_id(intent_id: str, relative_path: str) -> str:
+    digest = hashlib.sha256(f"{intent_id}\x00{relative_path}".encode()).hexdigest()
+    return f"d_{digest[:32]}"
+
+
+def _stable_preparation_id(task_id: str, run_id: int, source_run_id: int) -> str:
+    digest = hashlib.sha256(f"{task_id}\x00{run_id}\x00{source_run_id}".encode()).hexdigest()
+    return f"p_{digest[:32]}"
+
+
+def _capture_replay(
+    client: BrokerClient,
+    task_id: str,
+    run_id: int,
+    finalization_id: str,
+    artifacts: list[str],
+) -> dict:
+    return client.capture_handoff(
+        finalization_id=finalization_id,
+        environment_key=broker_environment_key(task_id),
+        task_id=task_id,
+        run_id=run_id,
+        selected_artifacts=list(artifacts),
+    )
+
+
+def _prepare_and_release_selected(
+    client: BrokerClient, handoff_id: str, intent_id: str, artifacts: list[str]
+) -> None:
+    # Completion must prove every selected file exists in the frozen broker
+    # tree before Hermes closes the run. Tokens are intentionally released;
+    # notifier delivery prepares fresh, subscriber-specific exports later.
+    for relative_path in artifacts:
+        delivery_id = _stable_delivery_id(intent_id, relative_path)
+        prepared = client.prepare_export(
+            delivery_id=delivery_id,
+            handoff_id=handoff_id,
+            relative_path=relative_path.removeprefix("output/"),
+        )
+        try:
+            if prepared["size"] < 0:
+                raise RuntimeError("broker returned a negative export size")
+        finally:
+            client.release_export(prepared["exportToken"])
+
+
+def _on_completion_intent(
+    *, task_id: str, board: str, run_id: int, finalization_id: str,
+    artifacts: list[str], **_: Any,
+) -> dict[str, bool]:
+    if not _enabled():
+        raise RuntimeError("workspace handoff is disabled")
+    board = _board_name(board)
+    with contextlib.closing(kb.connect(board=board)) as conn:
+        task = kb.get_task(conn, task_id)
+        if task is None or task.workspace_kind != "broker" or task.status != "running":
+            raise RuntimeError("workspace completion task is stale")
+        if task.current_run_id != int(run_id):
+            raise RuntimeError("workspace completion run is stale")
+    client = _client()
+    try:
+        captured = _capture_replay(
+            client, task_id, int(run_id), finalization_id, list(artifacts)
+        )
+        intent = f"{finalization_id}:{task_id}:{run_id}"
+        _prepare_and_release_selected(client, captured["handoffId"], intent, list(artifacts))
+    finally:
+        client.close()
+    with contextlib.closing(kb.connect(board=board)) as conn:
+        kb.append_workspace_capture(
+            conn, task_id, run_id=int(run_id),
+            handoff_id=str(captured["handoffId"]),
+            finalization_id=str(finalization_id),
+            artifacts=list(artifacts),
+            board=board,
+        )
+    return {"ready": True}
+
+
+def _source_facts(conn: Any, task_id: str, board: str, run_id: int) -> tuple[Any, Any, dict]:
+    task = kb.get_task(conn, task_id)
+    if task is None or task.workspace_kind != "broker" or task.status != "running":
+        raise RuntimeError("workspace destination is stale")
+    if task.current_run_id != int(run_id):
+        raise RuntimeError("workspace destination run is stale")
+    inheritance = kb.get_inheritance_intent(conn, task_id)
+    if not isinstance(inheritance, dict):
+        return task, None, {}
+    source_id = inheritance.get("source_task_id")
+    source_run_id = inheritance.get("source_run_id")
+    if not isinstance(source_id, str) or not source_id or not isinstance(source_run_id, int):
+        raise RuntimeError("workspace inheritance intent is malformed")
+    if kb.parent_ids(conn, task_id) != [source_id]:
+        raise RuntimeError("workspace inheritance requires one direct parent")
+    source = kb.get_task(conn, source_id)
+    if source is None or source.status != "done" or source.workspace_kind != "broker":
+        raise RuntimeError("workspace source is not complete")
+    if source.tenant != task.tenant or inheritance.get("tenant") != task.tenant:
+        raise RuntimeError("workspace source and destination tenants differ")
+    if inheritance.get("creator") is not None and inheritance.get("creator") != task.created_by:
+        raise RuntimeError("workspace inheritance creator changed")
+    source_intent = kb.get_completion_intent(conn, source_id, source_run_id)
+    if not isinstance(source_intent, dict) or not source_intent.get("finalization_id"):
+        raise RuntimeError("workspace source completion intent is unavailable")
+    return task, source, {"inheritance": inheritance, "source_intent": source_intent, "source_run_id": source_run_id}
+
+
+def _on_pre_spawn(*, task_id: str, board: str, run_id: int, **_: Any) -> dict[str, bool]:
+    if not _enabled():
+        raise RuntimeError("workspace handoff is disabled")
+    board = _board_name(board)
+    client = _client()
+    try:
+        with contextlib.closing(kb.connect(board=board)) as conn:
+            task, source, facts = _source_facts(conn, task_id, board, int(run_id))
+            destination_key = broker_environment_key(task_id)
+            if source is not None:
+                source_run_id = int(facts["source_run_id"])
+                source_capture = _capture_replay(
+                    client, source.id, source_run_id,
+                    str(facts["source_intent"]["finalization_id"]),
+                )
+                import_intent = kb.get_workspace_import_intent(conn, task_id, int(run_id))
+                if not isinstance(import_intent, dict) or not import_intent.get("preparation_id"):
+                    preparation_id = _stable_preparation_id(task_id, int(run_id), source_run_id)
+                    import_intent = kb.append_workspace_import_intent(
+                        conn, task_id, run_id=int(run_id),
+                        preparation_id=preparation_id, board=board,
+                    )
+                imported = client.import_handoff(
+                    preparation_id=str(import_intent["preparation_id"]),
+                    source_handoff_id=source_capture["handoffId"],
+                    source_task_id=source.id,
+                    destination_task_id=task_id,
+                    destination_run_id=int(run_id),
+                    destination_environment_key=destination_key,
+                )
+                if imported["ownerEnvironmentKey"] != destination_key:
+                    raise RuntimeError("broker import owner does not match destination")
+                binding = client.acquire_workspace(
+                    destination_key, workspace_id=imported["workspaceId"]
+                )
+            else:
+                binding = client.acquire_workspace(destination_key)
+            client.activate_task_run(
+                environment_key=destination_key, task_id=task_id, run_id=int(run_id),
+                workspace_id=binding["workspaceId"],
+                workspace_lease_id=binding["workspaceLeaseId"],
+            )
+    except BrokerError:
+        raise
+    finally:
+        client.close()
+    return {"ready": True}
+
+
+def _on_spawn_failed(*, task_id: str, board: str, run_id: int | None = None, **_: Any) -> None:
+    if not _enabled() or run_id is None:
+        return
+    try:
+        client = _client()
+        try:
+            client.consume_task_run(
+                environment_key=broker_environment_key(task_id),
+                task_id=task_id, run_id=int(run_id),
+            )
+        finally:
+            client.close()
+    except Exception:
+        # The broker activation remains durable and its reclaim/TTL path is the
+        # authority if a local failure prevents immediate consumption.
+        return
+
+
+def _on_terminal_workspace(
+    *, task_id: str, board: str, run_id: int | None = None, **_: Any
+) -> None:
+    """Consume a broker activation after a terminal worker transition."""
+    if not _enabled() or run_id is None:
+        return
+    try:
+        client = _client()
+        try:
+            client.consume_task_run(
+                environment_key=broker_environment_key(task_id),
+                task_id=task_id,
+                run_id=int(run_id),
+            )
+        finally:
+            client.close()
+    except Exception:
+        # The broker's durable lease/reclaim path remains authoritative if
+        # notification or process teardown cannot reach it immediately.
+        return
+
+
+def _on_recovery(*, task_id: str, board: str, run_id: int, **_: Any) -> dict[str, bool]:
+    board = _board_name(board)
+    with contextlib.closing(kb.connect(board=board)) as conn:
+        completion_intent = kb.get_completion_intent(conn, task_id, int(run_id))
+        import_intent = kb.get_workspace_import_intent(conn, task_id, int(run_id))
+    if isinstance(import_intent, dict) and import_intent.get("preparation_id"):
+        return _on_pre_spawn(task_id=task_id, board=board, run_id=int(run_id))
+    if not isinstance(completion_intent, dict) or not completion_intent.get("finalization_id"):
+        raise RuntimeError("workspace recovery intent is unavailable")
+    return _on_completion_intent(
+        task_id=task_id, board=board, run_id=int(run_id),
+        finalization_id=str(completion_intent["finalization_id"]),
+        artifacts=list(completion_intent.get("artifacts", [])),
+    )
+
+
+def register(ctx) -> None:
+    ctx.register_hook("kanban_workspace_completion_intent", _on_completion_intent)
+    ctx.register_hook("kanban_workspace_pre_spawn", _on_pre_spawn)
+    ctx.register_hook("kanban_workspace_spawn_failed", _on_spawn_failed)
+    ctx.register_hook("kanban_workspace_recovery", _on_recovery)
+    ctx.register_hook("kanban_task_blocked", _on_terminal_workspace)
+    ctx.register_hook("kanban_task_reclaimed", _on_terminal_workspace)
+    ctx.register_hook("kanban_task_timed_out", _on_terminal_workspace)
