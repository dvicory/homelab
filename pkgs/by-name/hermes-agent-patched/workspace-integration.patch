@@ -0,0 +1,112 @@
+"""Focused zero-schema Hermes workspace recovery contracts."""
+from __future__ import annotations
+
+import importlib.util
+import time
+from pathlib import Path
+
+from hermes_cli import kanban_db as kb
+
+
+def test_broker_workspace_uses_existing_schema_and_hides_intent(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    kb.init_db()
+    with kb.connect(board="default") as conn:
+        task_id = kb.create_task(
+            conn, title="broker", assignee="worker", workspace_kind="broker",
+            tenant="tenant-a",
+        )
+        task = kb.get_task(conn, task_id)
+        assert task is not None and task.workspace_path is None
+        kb.claim_task(conn, task_id)
+        run_id = kb.get_task(conn, task_id).current_run_id
+        try:
+            kb.complete_task(
+                conn, task_id, summary="ready", artifacts=["output/report.txt"],
+                expected_run_id=run_id, board="default",
+            )
+        except RuntimeError:
+            pass
+        assert kb.get_completion_intent(conn, task_id, run_id)["artifacts"] == ["output/report.txt"]
+        assert not any(event.kind == "completion_intent" for event in kb.list_events(conn, task_id))
+        tables = {
+            row[0] for row in conn.execute(
+                "SELECT name FROM sqlite_master WHERE type='table'"
+            )
+        }
+        forbidden = {"task_" + "workspace_operations", "task_" + "workspace_deliveries"}
+        assert not forbidden & tables
+
+
+def test_native_artifacts_are_relative_and_attachment_backed(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    workspace = tmp_path / "work"
+    (workspace / "output").mkdir(parents=True)
+    (workspace / "output" / "report.txt").write_text("ok")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    kb.init_db()
+    with kb.connect(board="default") as conn:
+        task_id = kb.create_task(
+            conn, title="native", assignee="worker", workspace_kind="dir",
+            workspace_path=str(workspace),
+        )
+        kb.claim_task(conn, task_id)
+        assert kb.complete_task(conn, task_id, summary="done", artifacts=["output/report.txt"])
+        attachments = kb.list_attachments(conn, task_id)
+        assert len(attachments) == 1
+        assert attachments[0].filename == "output/report.txt"
+        assert Path(attachments[0].stored_path).read_text() == "ok"
+
+
+def test_completion_intent_replay_excludes_reclaim_and_dry_run(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / ".hermes"))
+    kb.init_db()
+    with kb.connect(board="intent-board") as conn:
+        task_id = kb.create_task(
+            conn, title="replay", assignee="worker", workspace_kind="broker"
+        )
+        kb.claim_task(conn, task_id)
+        run_id = kb.get_task(conn, task_id).current_run_id
+        try:
+            kb.complete_task(
+                conn, task_id, summary="done", artifacts=[],
+                expected_run_id=run_id, board="intent-board",
+            )
+        except RuntimeError:
+            pass
+        conn.execute(
+            "UPDATE tasks SET claim_expires = ?, worker_pid = NULL WHERE id = ?",
+            (int(time.time()) - 1, task_id),
+        )
+        assert kb.release_stale_claims(conn, board="intent-board") == 0
+        assert kb.get_task(conn, task_id).status == "running"
+        monkeypatch.setattr(
+            kb, "_run_required_workspace_hook",
+            lambda *args, **kwargs: {"ready": True},
+        )
+        assert kb.recover_completion_intents(conn, board="intent-board") == [task_id]
+        assert kb.get_task(conn, task_id).status == "done"
+
+
+
+
+def test_terminal_hook_failure_is_best_effort(tmp_path, monkeypatch):
+    plugin_path = Path(__file__).parents[2] / "plugins" / "workspace-service" / "__init__.py"
+    spec = importlib.util.spec_from_file_location("workspace_service_test", plugin_path)
+    assert spec and spec.loader
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    monkeypatch.setenv("HERMES_WORKSPACE_HANDOFF", "1")
+
+    class FailingClient:
+        def consume_task_run(self, **kwargs):
+            raise RuntimeError("broker unavailable")
+
+        def close(self):
+            return None
+
+    monkeypatch.setattr(module, "_client", lambda: FailingClient())
+    module._on_terminal_workspace(
+        task_id="t_board_safe", board="terminal-board", run_id=7
+    )
