+        "ORDER BY run_id DESC LIMIT 1",
+        (task_id,),
+    ).fetchone()
+    if row is None:
+        return None
+    result = json.loads(row["result_json"])
+    if not isinstance(result, dict):
+        raise RuntimeError("workspace.invalid_state: preparation result is invalid")
+    return result
+
+
