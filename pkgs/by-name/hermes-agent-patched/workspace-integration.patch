+"""Focused zero-schema Hermes workspace recovery contracts."""
+from __future__ import annotations
+
+import importlib.util
+import time
+from pathlib import Path
+
+from hermes_cli import kanban_db as kb
+
+
+def test_broker_workspace_uses_existing_schema_and_hides_intent(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    kb.init_db()
+    with kb.connect(board="default") as conn:
+        task_id = kb.create_task(
+            conn, title="broker", assignee="worker", workspace_kind="broker",
+            tenant="tenant-a",
+        )
+        task = kb.get_task(conn, task_id)
+        assert task is not None and task.workspace_path is None
+        kb.claim_task(conn, task_id)
+        run_id = kb.get_task(conn, task_id).current_run_id
+        try:
+            kb.complete_task(
+                conn, task_id, summary="ready", artifacts=["output/report.txt"],
+                expected_run_id=run_id, board="default",
+            )
+        except RuntimeError:
+            pass
+        assert kb.get_completion_intent(conn, task_id, run_id)["artifacts"] == ["output/report.txt"]
+        assert not any(event.kind == "completion_intent" for event in kb.list_events(conn, task_id))
+        tables = {
+            row[0] for row in conn.execute(
+                "SELECT name FROM sqlite_master WHERE type='table'"
+            )
+        }
+        forbidden = {"task_" + "workspace_operations", "task_" + "workspace_deliveries"}
+        assert not forbidden & tables
+
+
+def test_native_artifacts_are_relative_and_attachment_backed(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    workspace = tmp_path / "work"
+    (workspace / "output").mkdir(parents=True)
+    (workspace / "output" / "report.txt").write_text("ok")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    kb.init_db()
+    with kb.connect(board="default") as conn:
