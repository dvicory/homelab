+def kanban_worker_env(task, workspace, *, board=None, base=None) -> "dict[str, Any]":
+    """Add legacy workspace paths to the opaque worker identity contract."""
+    from hermes_cli import kanban_db as kb  # local import: avoids import cycle
+
+    env = kanban_worker_identity_env(task, board=board, base=base)
+    if getattr(task, "workspace_kind", "") == "broker":
+        env["HERMES_WORKSPACE_MODE"] = "broker"
+        env["HERMES_BROKER_WORKSPACE"] = "/workspace"
+        from tools.environments.gondolin import broker_environment_key
+
+        env["HERMES_BROKER_ENVIRONMENT_KEY"] = broker_environment_key(task.id)
+    if workspace:
+        env["HERMES_KANBAN_WORKSPACE"] = workspace
+    env["HERMES_KANBAN_WORKSPACES_ROOT"] = str(kb.workspaces_root(board=board))
