+    def resolve_project_source(
+        self,
+        *,
+        repository_id: str,
+        project: str,
+        project_revision: str,
+        source_revision: str,
+    ) -> dict:
+        """Bind a source generation for one Project through the trusted control plane.
+
+        Idempotent: the broker returns the same generation for unchanged
+        upstream content and records provenance for audit. Only the broker
+        ever sees acquisition credentials.
+        """
+        body = self._json_post(
+            "/v1/control/project-sources/resolve",
+            {
+                "repositoryId": str(repository_id),
+                "project": str(project),
+                "projectRevision": str(project_revision),
+                "sourceRevision": str(source_revision),
+            },
+            timeout=max(self._timeout, 600.0),
+        )
+        return {
+            "sourceGeneration": self._required_text(body, "sourceGeneration"),
+            "resolvedRevision": self._required_text(body, "resolvedRevision"),
+            "adapterRevision": self._required_text(body, "adapterRevision"),
+        }
