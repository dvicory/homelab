+def _bind_source_generation(conn: Any, client: BrokerClient, task_id: str, run_id: int, specification: Any) -> Any:
+    """Resolve and durably record the Project source generation for this run.
+
+    Trusted dispatch binds the generation once; a retried pre-spawn reuses
+    the recorded generation and the broker revalidates it at activation.
+    """
+    import json as _json
+    from dataclasses import replace as _replace
+
+    from hermes_cli.worker_catalogue import load_worker_catalogue
+
+    if specification.project is None:
+        return specification
+    if specification.source_generation is not None:
+        return specification
+    catalogue = load_worker_catalogue(required=True)
+    assert catalogue is not None
+    project_spec = catalogue["projects"].get(specification.project)
+    if not isinstance(project_spec, dict):
+        raise RuntimeError("worker specification Project is not in the trusted catalogue")
+    source = project_spec.get("source")
+    repository_id = source.get("repositoryId") if isinstance(source, dict) else None
+    source_revision = catalogue["sourceRevisions"].get(repository_id)
+    if not isinstance(repository_id, str) or not isinstance(source_revision, str):
+        raise RuntimeError("worker specification Project source revision is unavailable")
+    resolution = client.resolve_project_source(
+        repository_id=repository_id,
+        project=specification.project,
+        project_revision=str(specification.project_revision),
+        source_revision=source_revision,
+    )
+    rebound = _replace(
+        specification, source_generation=str(resolution["sourceGeneration"])
+    )
+    conn.execute(
+        "UPDATE task_runs SET metadata = ? WHERE id = ? AND task_id = ?",
+        (
+            _json.dumps(
+                {"worker_spec": rebound.as_dict()},
+                sort_keys=True,
+                separators=(",", ":"),
+            ),
+            int(run_id),
+            task_id,
+        ),
+    )
+    kb._append_worker_specification(conn, task_id, rebound, run_id=int(run_id))
+    return rebound
+
+
 def _on_pre_spawn(*, task_id: str, board: str, run_id: int, **_: Any) -> dict[str, bool]:
