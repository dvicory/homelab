From 4cc6216d2e0c7a7c1a8cde31c85e4b91e97f8bce Mon Sep 17 00:00:00 2001
From: Daniel Vicory <dvicory@gmail.com>
Date: Tue, 21 Jul 2026 19:30:00 -0700
Subject: [PATCH] feat(approvals): return effective approval choice

Let trusted plugin integrations attenuate their own capability grants to the
scope the user selected. Existing callers continue to consume the approved
boolean; the additional choice field is generic approval metadata.
---
 tests/tools/test_approval_choice_result.py | 50 +++++++++++++++++++++++
 tools/approval.py                          | 30 ++++++++++----
 2 files changed, 72 insertions(+), 8 deletions(-)
 create mode 100644 tests/tools/test_approval_choice_result.py

diff --git a/tools/approval.py b/tools/approval.py
index 57383f5..436520f 100644
--- a/tools/approval.py
+++ b/tools/approval.py
@@ -1572,6 +1572,18 @@ def is_approved(session_key: str, pattern_key: str) -> bool:
         return any(alias in session_approvals for alias in aliases)
 
 
+def approved_scope(session_key: str, pattern_key: str) -> Optional[str]:
+    """Return the narrowest persisted approval scope for a pattern."""
+    aliases = _approval_key_aliases(pattern_key)
+    with _lock:
+        if any(alias in _permanent_approved for alias in aliases):
+            return "always"
+        session_approvals = _session_approved.get(session_key, set())
+        if any(alias in session_approvals for alias in aliases):
+            return "session"
+    return None
+
+
 def approve_permanent(pattern_key: str):
     """Add a pattern to the permanent allowlist."""
     with _lock:
@@ -2051,11 +2064,12 @@ def _run_approval_gate(
     # Hardline blocks are handled by the caller BEFORE this gate, so yolo
     # here only skips the recoverable approval layer.
     if _YOLO_MODE_FROZEN or is_current_session_yolo_enabled():
-        return {"approved": True, "message": None}
+        return {"approved": True, "message": None, "choice": "once"}
 
     session_key = get_current_session_key()
-    if is_approved(session_key, pattern_key):
-        return {"approved": True, "message": None}
+    cached_scope = approved_scope(session_key, pattern_key)
+    if cached_scope is not None:
+        return {"approved": True, "message": None, "choice": cached_scope}
 
     if approval_callback is None:
         try:
@@ -2103,5 +2117,5 @@ def _run_approval_gate(
             autoapprove_log_prefix, pattern_key, description,
         )
-        return {"approved": True, "message": None}
+        return {"approved": True, "message": None, "choice": "once"}
 
     if is_gateway or env_var_enabled("HERMES_EXEC_ASK"):
@@ -2168,6 +2182,6 @@ def _run_approval_gate(
                 approve_session(session_key, pattern_key)
                 approve_permanent(pattern_key)
                 save_permanent_allowlist(_permanent_approved)
-            return {"approved": True, "message": None}
+            return {"approved": True, "message": None, "choice": choice}
 
         # No notify callback (e.g. API server without an attached chat):
@@ -2211,7 +2225,7 @@ def _run_approval_gate(
         approve_permanent(pattern_key)
         save_permanent_allowlist(_permanent_approved)
 
-    return {"approved": True, "message": None}
+    return {"approved": True, "message": None, "choice": choice}
 
 
 # =========================================================================
diff --git a/tests/tools/test_approval_choice_result.py b/tests/tools/test_approval_choice_result.py
new file mode 100644
index 0000000..b392266
--- /dev/null
+++ b/tests/tools/test_approval_choice_result.py
@@ -0,0 +1,49 @@
+"""Effective scope results from the generic Hermes approval gate."""
+
+from __future__ import annotations
+
+import pytest
+
+from tools import approval
+
+
+@pytest.fixture(autouse=True)
+def _clean_approval_state(monkeypatch):
+    monkeypatch.setattr(approval, "_YOLO_MODE_FROZEN", False)
+    monkeypatch.setattr(approval, "_is_interactive_cli", lambda: True)
+    monkeypatch.setattr(approval, "_is_gateway_approval_context", lambda: False)
+    monkeypatch.setattr(approval, "get_current_session_key", lambda default=None: "scope-test")
+    approval.clear_session("scope-test")
+    approval._permanent_approved.clear()
+    yield
+    approval.clear_session("scope-test")
+    approval._permanent_approved.clear()
+
+
+def _request(monkeypatch, choice):
+    monkeypatch.setattr(approval, "prompt_dangerous_approval", lambda *args, **kwargs: choice)
+    return approval.request_tool_approval(
+        "sandbox_request_access",
+        "canonical capability request",
+        rule_key="scope-test-rule",
+    )
+
+
+@pytest.mark.parametrize("choice", ["once", "session", "always"])
+def test_new_approval_reports_selected_choice(monkeypatch, choice):
+    result = _request(monkeypatch, choice)
+
+    assert result["approved"] is True
+    assert result["choice"] == choice
+
+
+def test_cached_session_and_permanent_approvals_report_scope(monkeypatch):
+    session = _request(monkeypatch, "session")
+    assert session["choice"] == "session"
+    assert _request(monkeypatch, "once")["choice"] == "session"
+
+    approval.clear_session("scope-test")
+    permanent = _request(monkeypatch, "always")
+    assert permanent["choice"] == "always"
+    approval.clear_session("scope-test")
+    assert _request(monkeypatch, "once")["choice"] == "always"
-- 
