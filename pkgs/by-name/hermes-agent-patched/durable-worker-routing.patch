+from __future__ import annotations
+
+import hashlib
+import json
+
+import pytest
+
+from hermes_cli import config as config_mod
+from hermes_cli import kanban_db as kb
+import model_tools
+from tools import kanban_tools
+from hermes_cli.worker_catalogue import (
+    WorkerResolutionError,
+    load_worker_catalogue,
+    resolve_worker_specification,
+)
+
+
+def _hash(value):
+    return hashlib.sha256(
+        json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    ).hexdigest()
+
+
+def _catalogue():
+    lanes = {
+        "worker": {
+            "description": "bounded worker",
+            "runtime": "hermes",
+            "profile": "default",
+            "agent": {"model": "test/model", "reasoningEffort": "high", "tools": ["terminal"]},
+            "memory": "disabled",
+            "workspace": {
+                "projectMode": "none",
+                "scratchProvider": "local-scratch",
+                "maximumPermission": "workspace-write",
+                "supportedSourceKinds": [],
+            },
+            "policy": {"worklane": "default"},
+            "execution": {"timeoutSeconds": 90, "maxTurns": 7},
+            "maxConcurrency": 2,
+        }
+    }
+    boards = {"default": {"allowedLanes": ["worker"], "allowedProjects": []}}
+    projects = {}
+    lane_revisions = {name: _hash(lane) for name, lane in lanes.items()}
+    project_revisions = {name: _hash(project) for name, project in projects.items()}
+    payload = {
+        "version": 1,
+        "instance": "test",
+        "workerLanes": lanes,
+        "laneRevisions": lane_revisions,
+        "boards": boards,
+        "projects": projects,
+        "projectRevisions": project_revisions,
+        "sourceRevisions": {},
+        "providerRevisions": {},
+    }
+    revision = _hash(payload)
+    return {
+        "version": 1,
+        "instance": "test",
+        "revision": revision,
+        "lanes": lanes,
+        "laneRevisions": lane_revisions,
+        "boards": boards,
+        "projects": projects,
+        "projectRevisions": project_revisions,
+        "sourceRevisions": {},
+        "providerRevisions": {},
+    }
+
+
+@pytest.fixture
+def managed_catalogue(monkeypatch):
+    holder = {"value": _catalogue()}
+    monkeypatch.setattr(
+        config_mod,
+        "load_config_readonly",
+        lambda: {"kanban": {"worker_catalogue": holder["value"]}},
+    )
+    return holder
+
+
+def test_catalogue_digest_and_resolution_are_fail_closed(managed_catalogue):
+    catalogue = load_worker_catalogue(required=True)
+    assert catalogue["instance"] == "test"
+    spec = resolve_worker_specification("worker", board="default")
+    assert spec.profile == "default"
+    assert spec.execution["timeoutSeconds"] == 90
+    assert spec.workspace_generation == 0
+
+    with pytest.raises(WorkerResolutionError, match="unknown_lane"):
+        resolve_worker_specification("default", board="default")
+    with pytest.raises(WorkerResolutionError, match="unknown_board"):
+        resolve_worker_specification("worker", board="other")
+
+    managed_catalogue["value"]["revision"] = "0" * 64
+    with pytest.raises(WorkerResolutionError, match="catalogue_revision_invalid"):
+        load_worker_catalogue(required=True)
+
+
+def test_source_and_provider_revisions_are_digest_validated(managed_catalogue):
+    catalogue = load_worker_catalogue(required=True)
+    assert catalogue["sourceRevisions"] == {}
+    assert catalogue["providerRevisions"] == {}
+
+    managed_catalogue["value"]["sourceRevisions"]["homelab"] = "1" * 64
+    with pytest.raises(WorkerResolutionError, match="catalogue_revision_invalid"):
+        load_worker_catalogue(required=True)
+
+    managed_catalogue["value"] = _catalogue()
+    managed_catalogue["value"]["sourceRevisions"]["homelab"] = "not-a-digest"
+    with pytest.raises(WorkerResolutionError, match="catalogue_invalid"):
+        load_worker_catalogue(required=True)
+
+
+def test_task_persists_spec_event_and_run_metadata(tmp_path, managed_catalogue):
+    conn = kb.connect(tmp_path / "kanban.db")
+    task_id = kb.create_task(conn, title="work", assignee="worker", board="default")
+
+    spec = kb.get_task_worker_specification(conn, task_id)
+    assert spec is not None
+    assert spec.lane == "worker"
+    assert spec.task_id == task_id
+    assert spec.run_id is None
+    task = kb.get_task(conn, task_id)
+    assert task.workspace_kind == "scratch"
+    assert task.max_runtime_seconds == 90
+    assert task.goal_max_turns == 7
+
+    claimed = kb.claim_task(conn, task_id)
+    assert claimed is not None
+    run = conn.execute(
+        "SELECT metadata FROM task_runs WHERE id = ?", (claimed.current_run_id,)
+    ).fetchone()
+    metadata = json.loads(run["metadata"])
+    run_spec = metadata["worker_spec"]
+    assert run_spec["catalogue_revision"] == managed_catalogue["value"]["revision"]
+    assert run_spec["lane_revision"] == managed_catalogue["value"]["laneRevisions"]["worker"]
+    assert run_spec["task_id"] == task_id
+    assert run_spec["run_id"] == claimed.current_run_id
+    assert run_spec["workspace_generation"] == claimed.current_run_id
+    assert run_spec["workspace_id"].endswith(f":{task_id}:{claimed.current_run_id}")
+    assert run_spec["lease_id"] == claimed.claim_lock
+
+
+def test_catalogue_change_creates_coherent_new_run_binding(tmp_path, managed_catalogue):
+    conn = kb.connect(tmp_path / "kanban.db")
+    task_id = kb.create_task(conn, title="work", assignee="worker", board="default")
+    changed = _catalogue()
+    changed["lanes"]["worker"]["description"] = "changed"
+    changed["laneRevisions"]["worker"] = _hash(changed["lanes"]["worker"])
+    payload = {
+        "version": 1,
+        "instance": changed["instance"],
+        "workerLanes": changed["lanes"],
+        "laneRevisions": changed["laneRevisions"],
+        "boards": changed["boards"],
+        "projects": changed["projects"],
+        "projectRevisions": changed["projectRevisions"],
+        "sourceRevisions": changed["sourceRevisions"],
+        "providerRevisions": changed["providerRevisions"],
+    }
+    changed["revision"] = _hash(payload)
+    managed_catalogue["value"] = changed
+
+    claimed = kb.claim_task(conn, task_id)
+    assert claimed is not None
+    run_spec = kb.get_task_worker_specification(
+        conn, task_id, run_id=claimed.current_run_id
+    )
+    assert run_spec.catalogue_revision == changed["revision"]
+    assert run_spec.lane_revision == changed["laneRevisions"]["worker"]
+
+
+def test_worker_spec_overrides_behavior_without_mutating_base(monkeypatch, managed_catalogue):
+    base_config = {
+        "model": {"default": "base/model"},
+        "agent": {"reasoning_effort": "low", "max_turns": 20},
+        "memory": {"memory_enabled": True, "user_profile_enabled": True},
+    }
+    spec = resolve_worker_specification("worker", board="default").bind_run(
+        task_id="t_worker",
+        run_id=1,
+        workspace_id="default:local-scratch:t_worker:1",
+        workspace_generation=1,
+        lease_id="test:1",
+    )
+    monkeypatch.setenv("HERMES_WORKER_SPEC", spec.to_json())
+    resolved = config_mod._apply_worker_spec_config(base_config)
+    assert resolved["model"]["default"] == "test/model"
+    assert resolved["agent"] == {"reasoning_effort": "high", "max_turns": 7}
+    assert resolved["memory"]["memory_enabled"] is False
+    assert base_config["model"]["default"] == "base/model"
+
+
+def test_worker_tool_ceiling_is_derived_only_from_frozen_spec(
+    monkeypatch, managed_catalogue
+):
+    spec = resolve_worker_specification("worker", board="default").bind_run(
+        task_id="t_worker",
+        run_id=1,
+        workspace_id="default:local-scratch:t_worker:1",
+        workspace_generation=1,
+        lease_id="test:1",
+    )
+    monkeypatch.setenv("HERMES_WORKER_SPEC", spec.to_json())
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "t_worker")
+
+    allowed = model_tools._worker_allowed_tools()
+    assert "terminal" in allowed
+    assert set(("kanban_complete", "kanban_block")) <= allowed
+    assert "web_search" not in allowed
+
+
+def test_managed_schema_retains_assignee_and_hides_infrastructure(monkeypatch, managed_catalogue):
+    monkeypatch.setenv("HERMES_KANBAN_BOARD", "default")
+    overrides = kanban_tools._kanban_create_schema_overrides()
+    parameters = overrides["parameters"]
+    assert parameters["required"] == ["title", "assignee"]
+    assert parameters["properties"]["assignee"]["enum"] == ["worker"]
+    assert "lane" not in parameters["properties"]
+    for field in ("workspace_kind", "workspace_path", "skills", "max_runtime_seconds"):
+        assert field not in parameters["properties"]
+
+
+def test_managed_handler_rejects_lane_alias_and_infrastructure(managed_catalogue):
+    result = kanban_tools._handle_create(
+        {"title": "work", "assignee": "worker", "workspace_path": "/tmp/escape"}
+    )
+    assert "do not accept infrastructure fields" in result
+    result = kanban_tools._handle_create({"title": "work", "lane": "worker"})
+    assert "do not accept infrastructure fields: lane" in result
