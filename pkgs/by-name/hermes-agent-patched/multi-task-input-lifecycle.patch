diff --git hermes-lifecycle-before/tests/hermes_cli/test_input_reclaim_guards.py hermes-lifecycle-after/tests/hermes_cli/test_input_reclaim_guards.py
index e69de29..d5baa9a 100644
--- hermes-lifecycle-before/tests/hermes_cli/test_input_reclaim_guards.py
+++ hermes-lifecycle-after/tests/hermes_cli/test_input_reclaim_guards.py
@@ -0,0 +1,154 @@
+from __future__ import annotations
+
+import argparse
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban as kc
+from hermes_cli import kanban_db as kb
+
+
+@pytest.fixture
+def conn(tmp_path, monkeypatch):
+    monkeypatch.setattr("hermes_cli.worker_catalogue.load_worker_catalogue", lambda: None)
+    connection = kb.connect(tmp_path / "kanban.db")
+    try:
+        yield connection
+    finally:
+        connection.close()
+
+
+def test_archive_refuses_live_input_consumers(conn):
+    producer = kb.create_task(conn, title="producer")
+    destination = kb.create_task(conn, title="destination", inputs_from=[producer])
+
+    with pytest.raises(ValueError, match=rf"live input consumers:.*{destination}"):
+        kb.archive_task(conn, producer)
+
+    assert kb.get_task(conn, producer).status != "archived"
+
+
+def test_archive_allows_done_and_archived_input_consumers(conn):
+    producer = kb.create_task(conn, title="producer")
+    done_destination = kb.create_task(
+        conn, title="done destination", inputs_from=[producer]
+    )
+    archived_destination = kb.create_task(
+        conn, title="archived destination", inputs_from=[producer]
+    )
+    conn.execute(
+        "UPDATE tasks SET status = 'done' WHERE id = ?", (done_destination,)
+    )
+    conn.execute(
+        "UPDATE tasks SET status = 'archived' WHERE id = ?", (archived_destination,)
+    )
+    conn.commit()
+
+    assert kb.archive_task(conn, producer) is True
+    assert kb.get_task(conn, producer).status == "archived"
+
+
+def test_create_rejects_archived_input_producer(conn):
+    producer = kb.create_task(conn, title="producer")
+    assert kb.archive_task(conn, producer) is True
+
+    with pytest.raises(
+        ValueError, match=rf"inputs_from producer {producer} is archived"
+    ):
+        kb.create_task(conn, title="destination", inputs_from=[producer])
+
+
+def test_archive_broker_hook_is_noop_without_control_socket(
+    tmp_path, monkeypatch
+):
+    monkeypatch.setattr("hermes_cli.worker_catalogue.load_worker_catalogue", lambda: None)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "home"))
+    monkeypatch.delenv("GONDOLIN_EFFECT_CONTROL_SOCKET", raising=False)
+    kb.init_db()
+    with kb.connect_closing() as connection:
+        task_id = kb.create_task(connection, title="broker task", workspace_kind="broker")
+
+    result = kc._cmd_archive(
+        argparse.Namespace(task_ids=[task_id], purge_ids=None)
+    )
+
+    assert result == 0
+    with kb.connect_closing() as connection:
+        assert kb.get_task(connection, task_id).status == "archived"
+
+
+@pytest.mark.parametrize(
+    ("release_fails", "mark_fails"),
+    [(True, False), (False, True), (True, True)],
+)
+def test_archive_reconciliation_retries_partial_broker_delivery(
+    conn, monkeypatch, release_fails, mark_fails
+):
+    monkeypatch.setenv("HERMES_SANDBOX_AUTHORITY_BINDING", "reclaim-test")
+    producer = kb.create_task(conn, title="producer", workspace_kind="broker")
+    conn.execute(
+        "UPDATE tasks SET status = 'done', completed_at = 10 WHERE id = ?",
+        (producer,),
+    )
+    conn.commit()
+    kb.append_workspace_capture(
+        conn,
+        producer,
+        run_id=1,
+        handoff_id="handoff-producer-1",
+        finalization_id="finalization-producer-1",
+        artifacts=[],
+    )
+    assert kb.archive_task(conn, producer) is True
+
+    plugin_path = (
+        Path(__file__).parents[2] / "plugins" / "workspace-service" / "__init__.py"
+    )
+    spec = importlib.util.spec_from_file_location(
+        f"workspace_service_reclaim_{release_fails}_{mark_fails}", plugin_path
+    )
+    assert spec and spec.loader
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+
+    class Client:
+        def __init__(self):
+            self.release_fails = release_fails
+            self.mark_fails = mark_fails
+            self.release_calls = []
+            self.mark_calls = []
+
+        def release_task_run_inputs(self, **kwargs):
+            self.release_calls.append(kwargs)
+            if self.release_fails:
+                raise ConnectionError("release unavailable")
+
+        def mark_handoffs_reclaimable(self, handoff_ids):
+            self.mark_calls.append(handoff_ids)
+            if self.mark_fails:
+                raise ConnectionError("mark unavailable")
+
+    client = Client()
+    module._reconcile_archived_once(conn, client, "default")
+    assert len(client.release_calls) == 1
+    assert client.mark_calls == [["handoff-producer-1"]]
+
+    client.release_fails = False
+    client.mark_fails = False
+    module._reconcile_archived_once(conn, client, "default")
+    assert len(client.release_calls) == 2
+    assert client.mark_calls == [
+        ["handoff-producer-1"],
+        ["handoff-producer-1"],
+    ]
+    assert client.release_calls[-1] == {
+        "environment_key": module.broker_environment_key(producer),
+        "board": "default",
+        "task_id": producer,
+    }
+
+    module._reconcile_archived_once(conn, client, "default")
+    assert len(client.release_calls) == 2
+    assert len(client.mark_calls) == 2
