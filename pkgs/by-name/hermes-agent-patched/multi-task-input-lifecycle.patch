diff -r hermes-lifecycle-before/tests/hermes_cli/test_input_reclaim_guards.py hermes-lifecycle-after/tests/hermes_cli/test_input_reclaim_guards.py
--- hermes-lifecycle-before/tests/hermes_cli/test_input_reclaim_guards.py
+++ hermes-lifecycle-after/tests/hermes_cli/test_input_reclaim_guards.py
@@ -0,0 +1,77 @@
+from __future__ import annotations
+
+import argparse
+
+import pytest
+
+from hermes_cli import kanban as kc
+from hermes_cli import kanban_db as kb
+
+
+@pytest.fixture
+def conn(tmp_path, monkeypatch):
+    monkeypatch.setattr("hermes_cli.worker_catalogue.load_worker_catalogue", lambda: None)
+    connection = kb.connect(tmp_path / "kanban.db")
+    try:
+        yield connection
+    finally:
+        connection.close()
+
+
+def test_archive_refuses_live_input_consumers(conn):
+    producer = kb.create_task(conn, title="producer")
+    destination = kb.create_task(conn, title="destination", inputs_from=[producer])
+
+    with pytest.raises(ValueError, match=rf"live input consumers:.*{destination}"):
+        kb.archive_task(conn, producer)
+
+    assert kb.get_task(conn, producer).status != "archived"
+
+
+def test_archive_allows_done_and_archived_input_consumers(conn):
+    producer = kb.create_task(conn, title="producer")
+    done_destination = kb.create_task(
+        conn, title="done destination", inputs_from=[producer]
+    )
+    archived_destination = kb.create_task(
+        conn, title="archived destination", inputs_from=[producer]
+    )
+    conn.execute(
+        "UPDATE tasks SET status = 'done' WHERE id = ?", (done_destination,)
+    )
+    conn.execute(
+        "UPDATE tasks SET status = 'archived' WHERE id = ?", (archived_destination,)
+    )
+    conn.commit()
+
+    assert kb.archive_task(conn, producer) is True
+    assert kb.get_task(conn, producer).status == "archived"
+
+
+def test_create_rejects_archived_input_producer(conn):
+    producer = kb.create_task(conn, title="producer")
+    assert kb.archive_task(conn, producer) is True
+
+    with pytest.raises(
+        ValueError, match=rf"inputs_from producer {producer} is archived"
+    ):
+        kb.create_task(conn, title="destination", inputs_from=[producer])
+
+
+def test_archive_broker_hook_is_noop_without_control_socket(
+    tmp_path, monkeypatch
+):
+    monkeypatch.setattr("hermes_cli.worker_catalogue.load_worker_catalogue", lambda: None)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "home"))
+    monkeypatch.delenv("GONDOLIN_EFFECT_CONTROL_SOCKET", raising=False)
+    kb.init_db()
+    with kb.connect_closing() as connection:
+        task_id = kb.create_task(connection, title="broker task", workspace_kind="broker")
+
+    result = kc._cmd_archive(
+        argparse.Namespace(task_ids=[task_id], purge_ids=None)
+    )
+
+    assert result == 0
+    with kb.connect_closing() as connection:
+        assert kb.get_task(connection, task_id).status == "archived"
