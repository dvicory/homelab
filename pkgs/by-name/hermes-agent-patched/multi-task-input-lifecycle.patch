+def _push_archive_reclaim(conn: Any, client: BrokerClient, board: str, task_id: str) -> None:
+    """Best-effort broker pushes for one archived task.
+
+    Releases any input preparations the task held as a destination and marks
+    every handoff it produced reclaimable.  Idempotent on the broker side.
+    """
+    try:
+        client.release_task_run_inputs(
+            environment_key=broker_environment_key(task_id),
+            board=board,
+            task_id=task_id,
+        )
+    except Exception:
+        pass
+    handoff_ids: list[str] = []
+    for event in kb._internal_events_for(conn, task_id, "workspace_capture"):
+        payload = event.payload if isinstance(event.payload, dict) else {}
+        handoff_id = payload.get("handoff_id")
+        if isinstance(handoff_id, str) and handoff_id:
+            handoff_ids.append(handoff_id)
+    if handoff_ids:
+        try:
+            client.mark_handoffs_reclaimable(handoff_ids)
+        except Exception:
+            pass
+
+
+def _reconcile_archived_once(conn: Any, client: BrokerClient, board: str) -> None:
+    """Re-push archive reclaim for every archived capture-holding task once.
+
+    Closes gaps left by archives made while the broker or control socket was
+    unreachable; everything derives from durable kanban records.
+    """
+    if board in _reconciled_boards:
+        return
+    _reconciled_boards.add(board)
+    try:
+        rows = conn.execute(
+            "SELECT DISTINCT task_id FROM task_events "
+            "WHERE kind = 'workspace_capture' AND task_id IN "
+            "(SELECT id FROM tasks WHERE status = 'archived')"
+        ).fetchall()
+        for row in rows:
+            _push_archive_reclaim(conn, client, board, row[0])
+    except Exception:
+        _reconciled_boards.discard(board)
+
+
+def _input_generation_for(conn: Any, task_id: str, run_id: int) -> Any:
+    """Resolve the pinned input generation, tolerating pre-input-edge schemas.
+
+    A kanban database created before input edges existed cannot contain
+    ``inputs_from`` edges, so missing tables mean "no inputs" rather than an
+    error.  Once the tables exist the helpers stay strict.
+    """
+    import sqlite3 as _sqlite3
+
+    try:
+        generation = kb.get_task_input_generation(conn, task_id)
+        if generation is None and kb.task_has_input_edges(conn, task_id):
+            generation = kb.resolve_task_input_generation(conn, task_id, run_id=run_id)
+        return generation
+    except _sqlite3.OperationalError as exc:
+        if "no such table" not in str(exc):
+            raise
+        return None
+
