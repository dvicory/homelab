+def _reclaim_archived_broker_task(
+    conn: Any, task_id: str
+) -> None:
+    """Best-effort broker cleanup after archiving a broker workspace task."""
+    endpoint = os.environ.get(_CONTROL_ENV, "").strip()
+    if not endpoint:
+        return
+    task = kb.get_task(conn, task_id)
+    if task is None or task.workspace_kind != "broker":
+        return
+    board = kb._board_for_connection(conn)
+    try:
+        from tools.environments.gondolin import (
+            BrokerClient,
+            broker_environment_key,
+        )
+        client = BrokerClient(endpoint, timeout=30.0)
+    except Exception as exc:
+        _log.warning("archive broker reclaim setup failed for %s: %s", task_id, exc)
+        return
+    try:
+        try:
+            client.release_task_run_inputs(
+                environment_key=broker_environment_key(task_id),
+                board=board,
+                task_id=task_id,
+            )
+        except Exception as exc:
+            _log.warning("archive broker input release failed for %s: %s", task_id, exc)
+
+        handoff_ids: list[str] = []
+        try:
+            completed_runs = kb.list_runs(
+                conn,
+                task_id,
+                include_active=False,
+                state_type="outcome",
+                state_name="completed",
+            )
+            seen: set[str] = set()
+            for run in completed_runs:
+                capture = kb.get_workspace_capture(conn, task_id, run_id=run.id)
+                if not capture:
+                    continue
+                handoff_id = capture.get("handoff_id", capture.get("handoffId"))
+                if handoff_id and str(handoff_id) not in seen:
+                    seen.add(str(handoff_id))
+                    handoff_ids.append(str(handoff_id))
+        except Exception as exc:
+            _log.warning("archive broker capture lookup failed for %s: %s", task_id, exc)
+        try:
+            client.mark_handoffs_reclaimable(handoff_ids)
+        except Exception as exc:
+            _log.warning("archive broker handoff reclaim failed for %s: %s", task_id, exc)
+    finally:
+        try:
+            client.close()
+        except Exception as exc:
+            _log.warning("archive broker client close failed for %s: %s", task_id, exc)
+
