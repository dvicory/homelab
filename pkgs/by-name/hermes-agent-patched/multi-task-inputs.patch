+def test_stable_capture_failure_reasons(conn, state, expected):
+    producer = kb.create_task(conn, title="producer")
+    conn.execute("UPDATE tasks SET status = 'done', completed_at = 10 WHERE id = ?", (producer,))
+    conn.commit()
+    with kb.write_txn(conn):
