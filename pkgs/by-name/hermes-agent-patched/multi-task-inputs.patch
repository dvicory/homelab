+def _find_archived_input_producers(
+    conn: sqlite3.Connection, producer_ids: Iterable[str]
+) -> list[str]:
+    producer_ids = list(producer_ids)
+    if not producer_ids:
+        return []
+    placeholders = ",".join("?" * len(producer_ids))
+    rows = conn.execute(
+        f"SELECT id, status FROM tasks WHERE id IN ({placeholders})",
+        producer_ids,
+    ).fetchall()
+    statuses = {row["id"]: row["status"] for row in rows}
+    return [
+        producer_id
+        for producer_id in producer_ids
+        if statuses.get(producer_id) == "archived"
+    ]
+
 
 def get_task(conn: sqlite3.Connection, task_id: str) -> Optional[Task]:
     row = conn.execute("SELECT * FROM tasks WHERE id = ?", (task_id,)).fetchone()
@@ -3024,6 +3082,225 @@ def child_ids(conn: sqlite3.Connection, task_id: str) -> list[str]:
     return [r["child_id"] for r in rows]
 
 
+INPUT_READINESS_REASONS = (
+    "missing",
+    "incomplete",
+    "failed",
+    "ambiguous",
+    "expired",
+    "quarantined",
+    "publication_failed",
+)
+
+
+def input_ids(conn: sqlite3.Connection, task_id: str) -> list[str]:
+    """Return board-local producer ids for a destination task."""
+    rows = conn.execute(
+        "SELECT producer_id FROM task_input_edges "
+        "WHERE board = ? AND destination_id = ? ORDER BY producer_id",
+        (_board_for_connection(conn), task_id),
+    ).fetchall()
+    return [r["producer_id"] for r in rows]
+
+
+def _capture_failure_reason(payload: dict[str, Any]) -> Optional[str]:
+    value = str(
+        payload.get("reason")
+        or payload.get("state")
+        or payload.get("status")
+        or ""
+    ).strip().lower().replace("-", "_").replace(".", "_")
+    for reason in ("publication_failed", "quarantined", "ambiguous", "incomplete", "expired", "failed", "missing"):
+        if reason in value:
+            return reason
+    if value and value not in {"ready", "published", "complete", "completed"}:
+        return "incomplete"
+    if payload.get("ready") is False:
+        return "incomplete"
+    return None
+
+
+def _producer_input_readiness(
+    conn: sqlite3.Connection, producer_id: str
+) -> tuple[Optional[str], Optional[dict[str, Any]]]:
+    """Return ``(stable_reason, ready_capture)`` for one producer."""
+    task = get_task(conn, producer_id)
+    if task is None:
+        return "missing", None
+    if task.status != "done":
+        latest = conn.execute(
+            "SELECT outcome, status FROM task_runs WHERE task_id = ? "
+            "ORDER BY id DESC LIMIT 1",
+            (producer_id,),
+        ).fetchone()
+        if latest and str(latest["outcome"] or latest["status"] or "").lower() in {
+            "failed", "spawn_failed", "crashed", "timed_out", "gave_up", "reclaimed",
+        }:
+            return "failed", None
+        return "incomplete", None
+    rows = conn.execute(
+        "SELECT payload, run_id FROM task_events "
+        "WHERE task_id = ? AND kind = 'workspace_capture' ORDER BY id DESC",
+        (producer_id,),
+    ).fetchall()
+    if not rows:
+        return "incomplete", None
+    completed = conn.execute(
+        "SELECT id FROM task_runs WHERE task_id = ? AND outcome = 'completed' "
+        "ORDER BY ended_at DESC, id DESC LIMIT 1",
+        (producer_id,),
+    ).fetchone()
+    selected = rows
+    if completed is not None:
+        selected = [r for r in rows if r["run_id"] == completed["id"]]
+        if not selected:
+            return "incomplete", None
+    if len(selected) != 1:
+        return "ambiguous", None
+    try:
+        payload = json.loads(selected[0]["payload"] or "{}")
+    except (TypeError, json.JSONDecodeError):
+        return "incomplete", None
+    if not isinstance(payload, dict):
+        return "incomplete", None
+    reason = _capture_failure_reason(payload)
+    if reason:
+        return reason, None
+    handoff_id = payload.get("handoff_id", payload.get("handoffId"))
+    finalization_id = payload.get("finalization_id", payload.get("finalizationId"))
+    if not handoff_id or not finalization_id:
+        return "incomplete", None
+    payload = dict(payload)
+    payload["run_id"] = int(payload.get("run_id", selected[0]["run_id"] or 0))
+    payload["handoff_id"] = str(handoff_id)
+    payload["finalization_id"] = str(finalization_id)
+    payload["artifacts"] = list(payload.get("artifacts") or [])
+    return None, payload
+
+
+def _task_input_readiness_reasons(
+    conn: sqlite3.Connection,
+    task_id: Optional[str],
+    *,
+    producer_ids: Optional[Iterable[str]] = None,
+) -> list[str]:
+    ids = list(producer_ids) if producer_ids is not None else input_ids(conn, str(task_id))
+    return [reason for producer_id in ids
+            if (reason := _producer_input_readiness(conn, producer_id)[0]) is not None]
+
+
+def task_input_readiness(
+    conn: sqlite3.Connection, task_id: str
+) -> list[dict[str, str]]:
+    """Return stable non-runnable input reasons, one item per producer."""
+    out: list[dict[str, str]] = []
+    for producer_id in input_ids(conn, task_id):
+        reason, _ = _producer_input_readiness(conn, producer_id)
+        if reason:
+            out.append({"producer_id": producer_id, "reason": reason})
+    return out
+
+
+def input_readiness_reasons(conn: sqlite3.Connection, task_id: str) -> list[str]:
+    """Return stable ``inputs.<reason>`` values for dispatcher diagnostics."""
+    return [f"inputs.{item['reason']}" for item in task_input_readiness(conn, task_id)]
+
+
+def task_has_input_edges(conn: sqlite3.Connection, task_id: str) -> bool:
+    return bool(input_ids(conn, task_id))
+
+
+def _input_generation_dict(row: sqlite3.Row) -> dict[str, Any]:
+    try:
+        bindings = json.loads(row["bindings_json"])
+    except (TypeError, json.JSONDecodeError):
+        bindings = []
+    return {
+        "board": row["board"],
+        "destination_id": row["destination_id"],
+        "generation": int(row["generation"]),
+        "state": row["state"],
+        "bindings_json": row["bindings_json"],
+        "bindings": bindings,
+        "digest": row["digest"],
+        "created_at": int(row["created_at"]),
+    }
+
+
+def get_task_input_generation(
+    conn: sqlite3.Connection, task_id: str
+) -> Optional[dict[str, Any]]:
+    row = conn.execute(
+        "SELECT * FROM task_input_generations WHERE board = ? "
+        "AND destination_id = ? ORDER BY generation DESC LIMIT 1",
+        (_board_for_connection(conn), task_id),
+    ).fetchone()
+    return _input_generation_dict(row) if row else None
+
+
+def _resolve_task_input_generation_in_txn(
+    conn: sqlite3.Connection, task_id: str
+) -> Optional[dict[str, Any]]:
+    existing = get_task_input_generation(conn, task_id)
+    if existing is not None:
+        return existing
+    task = get_task(conn, task_id)
+    if task is None:
+        raise ValueError(f"unknown task {task_id}")
+    producers = input_ids(conn, task_id)
+    if not producers:
+        return None
+    bindings: list[dict[str, Any]] = []
+    for producer_id in producers:
+        reason, capture = _producer_input_readiness(conn, producer_id)
+        if reason or capture is None:
+            raise ValueError(f"inputs.{reason or 'incomplete'}: producer {producer_id}")
+        producer = get_task(conn, producer_id)
+        spec = get_task_worker_specification(
+            conn, producer_id, run_id=int(capture["run_id"])
+        )
+        lane = spec.lane if spec is not None else producer.assignee
+        project = (
+            spec.project if spec is not None and spec.project is not None
+            else producer.project_id
+        )
+        source_generation = (
+            spec.source_generation if spec is not None else None
+        )
+        bindings.append({
+            "producerTaskId": producer_id,
+            "producerRunId": int(capture["run_id"]),
+            "producerLane": lane,
+            "handoffId": capture["handoff_id"],
+            "finalizationId": capture["finalization_id"],
+            "artifacts": list(capture.get("artifacts") or []),
+            "project": project,
+            "sourceGeneration": source_generation,
+        })
+    bindings.sort(key=lambda item: item["producerTaskId"])
+    bindings_json = json.dumps(
+        bindings, ensure_ascii=False, sort_keys=True, separators=(",", ":")
+    )
+    digest = hashlib.sha256(bindings_json.encode("utf-8")).hexdigest()
+    now = int(time.time())
+    board = _board_for_connection(conn)
+    conn.execute(
+        "INSERT INTO task_input_generations "
+        "(board, destination_id, generation, state, bindings_json, digest, created_at) "
+        "VALUES (?, ?, 1, 'bound', ?, ?, ?)",
+        (board, task_id, bindings_json, digest, now),
+    )
+    return get_task_input_generation(conn, task_id)  # type: ignore[return-value]
+
+
+def resolve_task_input_generation(
+    conn: sqlite3.Connection, task_id: str, *, run_id: Optional[int] = None
+) -> Optional[dict[str, Any]]:
+    """Pin and return exact producer bindings for a destination."""
+    with write_txn(conn):
+        return _resolve_task_input_generation_in_txn(conn, task_id)
+
+
 def parent_results(conn: sqlite3.Connection, task_id: str) -> list[tuple[str, Optional[str]]]:
     """Return ``(parent_id, result)`` for every done parent of ``task_id``."""
     rows = conn.execute(
@@ -3799,7 +4076,11 @@ def recompute_ready(
