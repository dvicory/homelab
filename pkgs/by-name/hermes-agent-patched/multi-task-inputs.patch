+from __future__ import annotations
+
+import hashlib
+import json
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+
+
+@pytest.fixture
+def conn(tmp_path, monkeypatch):
+    monkeypatch.setattr("hermes_cli.worker_catalogue.load_worker_catalogue", lambda: None)
+    connection = kb.connect(tmp_path / "kanban.db")
+    try:
+        yield connection
+    finally:
+        connection.close()
+
+
+def _done_with_capture(conn, task_id, *, run_id=1, handoff="h1", finalization="f1", artifacts=None):
+    conn.execute("UPDATE tasks SET status = 'done', completed_at = 10 WHERE id = ?", (task_id,))
+    conn.commit()
+    kb.append_workspace_capture(
+        conn,
+        task_id,
+        run_id=run_id,
+        handoff_id=handoff,
+        finalization_id=finalization,
+        artifacts=list(artifacts or []),
+    )
+
+
+def test_creation_normalizes_duplicate_edges(conn):
+    producer = kb.create_task(conn, title="producer")
+    destination = kb.create_task(
+        conn,
+        title="destination",
+        parents=[producer, producer],
+        inputs_from=[producer, producer],
+    )
+    assert kb.parent_ids(conn, destination) == []
+    assert kb.input_ids(conn, destination) == [producer]
+    assert kb.get_task(conn, destination).status == "todo"
+
+
+def test_input_readiness_fails_closed_until_ready_handoff(conn):
+    producer = kb.create_task(conn, title="producer")
+    destination = kb.create_task(conn, title="destination", inputs_from=[producer])
+    assert kb.task_input_readiness(conn, destination) == [
+        {"producer_id": producer, "reason": "incomplete"}
+    ]
+    assert kb.get_task(conn, destination).status == "todo"
+    _done_with_capture(conn, producer)
+    assert kb.recompute_ready(conn) == 1
+    assert kb.get_task(conn, destination).status == "ready"
+
+
+def test_generation_binds_exact_handoff_and_reuses_on_retry(conn):
+    producer = kb.create_task(conn, title="producer", assignee="research")
+    _done_with_capture(conn, producer, run_id=3, handoff="h-old", finalization="f-old", artifacts=["a"])
+    destination = kb.create_task(conn, title="destination", inputs_from=[producer])
+    generation = kb.resolve_task_input_generation(conn, destination)
+    assert generation["generation"] == 1
+    assert generation["bindings"][0]["producerRunId"] == 3
+    assert generation["bindings"][0]["handoffId"] == "h-old"
+    digest = hashlib.sha256(generation["bindings_json"].encode()).hexdigest()
+    assert generation["digest"] == digest
+    _done_with_capture(conn, producer, run_id=4, handoff="h-new", finalization="f-new")
+    assert kb.resolve_task_input_generation(conn, destination)["bindings"][0]["handoffId"] == "h-old"
+
+
+def test_cross_board_producer_is_rejected(tmp_path, monkeypatch):
+    monkeypatch.setattr("hermes_cli.worker_catalogue.load_worker_catalogue", lambda: None)
+    first = kb.connect(tmp_path / "one.db")
+    second = kb.connect(tmp_path / "two.db")
+    try:
+        producer = kb.create_task(first, title="producer")
+        with pytest.raises(ValueError, match="unknown task"):
+            kb.create_task(second, title="destination", inputs_from=[producer])
+    finally:
+        first.close()
+        second.close()
+
