+def test_precreated_research_graph_fans_out_then_fans_in(conn):
+    seed = kb.create_task(conn, title="collect sources", assignee="research")
+    analyst_a = kb.create_task(
+        conn, title="analyze alpha", assignee="research", inputs_from=[seed]
+    )
+    analyst_b = kb.create_task(
+        conn, title="analyze beta", assignee="research", inputs_from=[seed]
+    )
+    synthesis = kb.create_task(
+        conn,
+        title="synthesize",
+        assignee="writer",
+        inputs_from=[analyst_a, analyst_b],
+    )
+
+    assert kb.get_task(conn, analyst_a).status == "todo"
+    assert kb.get_task(conn, analyst_b).status == "todo"
+    assert kb.get_task(conn, synthesis).status == "todo"
+
+    _done_with_capture(conn, seed, handoff="seed")
+    assert kb.recompute_ready(conn) == 2
+    assert kb.get_task(conn, analyst_a).status == "ready"
+    assert kb.get_task(conn, analyst_b).status == "ready"
+
+    _done_with_capture(conn, analyst_a, handoff="alpha")
+    assert kb.recompute_ready(conn) == 0
+    _done_with_capture(conn, analyst_b, handoff="beta")
+    assert kb.recompute_ready(conn) == 1
+    assert kb.get_task(conn, synthesis).status == "ready"
+    generation = kb.resolve_task_input_generation(conn, synthesis)
+    assert {item["handoffId"] for item in generation["bindings"]} == {
+        "alpha",
+        "beta",
+    }
+
