+def test_worker_context_lists_namespaced_inputs(conn):
+    producer = kb.create_task(conn, title="report", assignee="research")
+    _done_with_capture(conn, producer, run_id=2, handoff="h", finalization="f")
+    destination = kb.create_task(conn, title="synthesis", assignee="writer", workspace_kind="broker", inputs_from=[producer])
+    kb.resolve_task_input_generation(conn, destination)
+    context = kb.build_worker_context(conn, destination)
+    assert "Inputs (read-only):" in context
