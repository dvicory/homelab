+def _worker_allowed_tools() -> Optional[set[str]]:
+    """Derive the model-visible ceiling from the single frozen worker spec."""
+    raw = os.environ.get("HERMES_WORKER_SPEC")
+    if not raw:
+        return None
+    from hermes_cli.worker_catalogue import WorkerSpecification
+
+    spec = WorkerSpecification.from_json(raw)
+    explicit = spec.agent.get("tools", [])
+    toolsets = spec.agent.get("toolsets", [])
+    if not isinstance(explicit, list) or not all(isinstance(name, str) for name in explicit):
+        raise RuntimeError("worker_spec_invalid: agent.tools must be a string list")
+    if not isinstance(toolsets, list) or not all(isinstance(name, str) for name in toolsets):
+        raise RuntimeError("worker_spec_invalid: agent.toolsets must be a string list")
+    allowed = set(explicit)
+    for toolset_name in toolsets:
+        if not validate_toolset(toolset_name):
+            raise RuntimeError(
+                f"worker_spec_invalid: unknown worker toolset {toolset_name!r}"
+            )
+        allowed.update(resolve_toolset(toolset_name))
+    if os.environ.get("HERMES_KANBAN_TASK"):
+        allowed.update(resolve_toolset("kanban"))
+    allowed.update({"tool_search", "tool_describe", "tool_call"})
+    return allowed
