+def _apply_worker_spec_config(config: Dict[str, Any]) -> Dict[str, Any]:
+    """Apply behavior-only overrides from a dispatcher-frozen worker spec."""
+    raw = os.environ.get("HERMES_WORKER_SPEC")
+    if not raw:
+        return config
+    from hermes_cli.worker_catalogue import WorkerSpecification
+    try:
+        worker_spec = WorkerSpecification.from_json(raw)
+    except Exception as exc:
+        raise RuntimeError("HERMES_WORKER_SPEC is invalid") from exc
+    spec = worker_spec.as_dict()
+    resolved = copy.deepcopy(config)
+    agent_spec = spec.get("agent") if isinstance(spec.get("agent"), dict) else {}
+    if agent_spec.get("model"):
+        resolved.setdefault("model", {})["default"] = str(agent_spec["model"])
+    if agent_spec.get("reasoningEffort"):
+        resolved.setdefault("agent", {})["reasoning_effort"] = str(agent_spec["reasoningEffort"])
+    execution = spec.get("execution") if isinstance(spec.get("execution"), dict) else {}
+    if execution.get("maxTurns"):
+        resolved.setdefault("agent", {})["max_turns"] = int(execution["maxTurns"])
+    memory_mode = worker_spec.memory
+    memory = resolved.setdefault("memory", {})
+    if memory_mode == "disabled":
+        memory["memory_enabled"] = False
+        memory["user_profile_enabled"] = False
+        memory["nudge_interval"] = 0
+    else:
+        memory["memory_enabled"] = True
+        memory["user_profile_enabled"] = True
+    return resolved
+
