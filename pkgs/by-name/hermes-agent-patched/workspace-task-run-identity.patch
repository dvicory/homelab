--- a/tests/tools/test_gondolin_backend.py
+++ b/tests/tools/test_gondolin_backend.py
@@ -13,6 +13,7 @@
 import pytest
 from tools.environments.gondolin import (
     BrokerError,
+    BrokerClient,
     GondolinEnvironment,
     check_gondolin_available,
 )
@@ -275,7 +276,46 @@
 
