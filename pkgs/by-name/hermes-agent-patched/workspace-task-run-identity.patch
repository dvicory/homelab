     assert "[broker error] policy.denied: command blocked" in handle.output
+
+
+def test_control_activation_matches_worker_execution_identity(monkeypatch):
+    calls = []
+    client = BrokerClient.__new__(BrokerClient)
+    client._timeout = 1.0
+
+    def fake_post(route, payload, timeout=None):
+        calls.append((route, payload))
+        if route == "/v1/control/authority/bind-default":
+            return {"policyDigest": "a" * 64}
+        if route == "/v1/control/task-runs/activate":
+            return {"activation": {"activationId": "activation-test"}}
+        raise AssertionError(route)
+
+    client._json_post = fake_post
+    environment_key = "authority-test"
+    monkeypatch.setenv("HERMES_BROKER_ENVIRONMENT_KEY", environment_key)
+    monkeypatch.setenv("HERMES_KANBAN_BOARD", "homelab")
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "t_identity")
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", "142")
 
+    client.activate_task_run(
+        environment_key=environment_key,
+        board="homelab",
+        task_id="t_identity",
+        run_id=142,
+        workspace_id="workspace-test",
+        workspace_lease_id="lease-test",
+    )
+    activation_payload = calls[-1][1]
+    execution_payload = client._execution_payload(
+        environment_key,
+        {"environmentKey": environment_key},
+    )
+
+    assert activation_payload["taskId"] == execution_payload["taskRun"]["taskId"]
+    assert activation_payload["runId"] == execution_payload["taskRun"]["runId"]
+
+
