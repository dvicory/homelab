+def _kanban_complete_schema_overrides() -> dict[str, Any]:
+    """Scope completion artifact guidance to the trusted workspace mode."""
+    broker = _workspace_mode() == "broker"
+    if broker:
+        description = (
+            "automation. If you produced deliverable files, select them with "
+            "relative paths under ``output/...`` in ``artifacts``. Absolute host "
+            "paths, prose/result discovery, and paths copied from another task "
+            "are rejected. Only the trusted manifest is uploaded as an attachment."
+        )
+        artifact_description = (
+            "Optional list of deliverable paths under ``output/...`` in this "
+            "workspace. Paths must be non-empty, relative POSIX paths with no "
+            "traversal or host prefix. Example: [\"output/report.pdf\"]. The "
+            "trusted manifest is copied to attachment storage; summary, result, "
+            "and metadata text are never scanned for paths. A missing selected "
+            "file keeps the task in-flight so the path can be corrected and retried."
+        )
+    else:
+        description = (
+            "automation. If you produced deliverable files, select them with "
+            "paths relative to your assigned workspace in ``artifacts``. Absolute "
+            "host paths, prose/result discovery, and paths copied from another "
+            "task are rejected. Only the trusted manifest is uploaded as an "
+            "attachment."
+        )
+        artifact_description = (
+            "Optional list of deliverable paths relative to this workspace. Paths "
+            "must be non-empty, relative POSIX paths with no traversal or host "
+            "prefix. Example: [\"results/chart.png\"]. The trusted manifest is "
+            "copied to attachment storage; summary, result, and metadata text "
+            "are never scanned for paths. A missing selected file keeps the task "
+            "in-flight so the path can be corrected and retried."
+        )
+    parameters = dict(KANBAN_COMPLETE_SCHEMA["parameters"])
+    properties = dict(parameters["properties"])
+    artifacts = dict(properties["artifacts"])
+    artifacts["description"] = artifact_description
+    properties["artifacts"] = artifacts
+    parameters["properties"] = properties
+    return {"description": description, "parameters": parameters}
 
