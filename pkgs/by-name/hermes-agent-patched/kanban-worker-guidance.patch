+def test_artifact_schema_is_scoped_to_workspace_mode(monkeypatch):
+    from tools import kanban_tools as kt
+    from tools.registry import invalidate_check_fn_cache, registry
+
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "t-schema")
+    invalidate_check_fn_cache()
+
+    monkeypatch.delenv("HERMES_WORKSPACE_MODE", raising=False)
+    native = registry.get_definitions({"kanban_complete"}, quiet=True)[0]["function"]
+    native_description = native["parameters"]["properties"]["artifacts"]["description"]
+    assert "relative POSIX" in native_description
+    assert "output/..." not in native_description
+    assert "host prefix" in native_description
+    assert "summary, result" in native_description
+    assert "never scanned" in native_description
+
+    monkeypatch.setenv("HERMES_WORKSPACE_MODE", "broker")
+    broker = registry.get_definitions({"kanban_complete"}, quiet=True)[0]["function"]
+    broker_description = broker["parameters"]["properties"]["artifacts"]["description"]
+    assert "relative POSIX" in broker_description
+    assert "output/..." in broker_description
+    assert "host prefix" in broker_description
+    assert "summary, result" in broker_description
+    assert "never scanned" in broker_description
+    assert "native" not in broker["description"].lower()
