+def test_cached_workspace_is_revalidated_before_tool_execution(monkeypatch):
+    plugin = load_plugin(monkeypatch)
+    monkeypatch.setattr(plugin.terminal_tool, "register_task_authority_binding", lambda *_: None)
+    monkeypatch.setattr(plugin.terminal_tool, "environment_key", lambda *_: "authority-task")
+    plugin._bindings["authority-task"] = {
+        "environmentKey": "authority-task",
+        "workspaceId": "workspace-opaque",
+        "workspaceLeaseId": "lease-opaque",
+        "guestPath": "/workspace",
+    }
+    monkeypatch.setattr(
+        plugin, "_request", lambda *_: (_ for _ in ()).throw(RuntimeError("broker offline"))
+    )
+
+    blocked = plugin._on_pre_tool_call(tool_name="terminal", task_id="task-a")
+
+    assert blocked["action"] == "block"
+    assert "broker offline" in blocked["message"]
+
+
+def test_terminal_task_state_closes_live_environment(monkeypatch):
+    plugin = load_plugin(monkeypatch)
+    cleaned = []
+    monkeypatch.setattr(plugin.terminal_tool, "cleanup_vm", cleaned.append)
+
+    plugin._on_task_terminal(task_id="task-a", summary="done")
+    plugin._on_task_terminal(task_id="task-b", reason="blocked")
+    plugin._on_task_terminal(task_id="")
+
+    assert cleaned == ["task-a", "task-b"]
+
