+)
 
 
+def test_only_choice_aware_adapters_render_restricted_buttons():
+    class LegacyAdapter:
+        async def send_exec_approval(self):
+            pass
+
+    class ChoiceAwareAdapter:
+        supports_restricted_exec_approval = True
+
+        async def send_exec_approval(self):
+            pass
+
+    assert _adapter_supports_exec_approval_choices(LegacyAdapter(), True) is True
+    assert _adapter_supports_exec_approval_choices(LegacyAdapter(), False) is False
+    assert _adapter_supports_exec_approval_choices(ChoiceAwareAdapter(), False) is True
+
