+def _adapter_supports_exec_approval_choices(adapter, allow_permanent: bool) -> bool:
+    """Return whether an adapter can render every choice this prompt permits."""
+    if getattr(type(adapter), "send_exec_approval", None) is None:
+        return False
+    return allow_permanent or (
+        getattr(type(adapter), "supports_restricted_exec_approval", False) is True
+    )
