+
+def _kanban_create_schema_overrides() -> dict:
+    """Advertise every assignee dispatchable by this gateway process."""
+    try:
+        from hermes_cli.worker_lanes import list_worker_lanes
+
+        lanes = list_worker_lanes()
+    except (ImportError, AttributeError):
+        # Worker lanes are an optional extension.
+        lanes = []
+
+    try:
+        from hermes_cli.profiles import list_profiles
+
+        profiles = list_profiles()
+    except Exception:
+        # Schema construction must survive a missing or damaged profile home.
+        profiles = []
+
+    lane_names = {lane.name for lane in lanes}
+    lines = []
+    for profile in sorted(profiles, key=lambda item: item.name):
+        # A registered lane wins dispatcher resolution when names collide, so
+        # do not advertise an unreachable profile with the same routing key.
+        if profile.name in lane_names:
+            continue
+        description = " ".join(str(getattr(profile, "description", "") or "").split())
+        suffix = description or "no capability description"
+        lines.append(f"- {profile.name} [Hermes profile]: {suffix}")
+    for lane in sorted(lanes, key=lambda item: item.name):
+        description = " ".join(str(getattr(lane, "description", "") or "").split())
+        suffix = description or "no capability description"
+        lines.append(f"- {lane.name} [external worker lane]: {suffix}")
+
+    if not lines:
+        return {}
+
+    parameters = {**KANBAN_CREATE_SCHEMA["parameters"]}
+    parameters["properties"] = {
+        name: dict(schema)
+        for name, schema in KANBAN_CREATE_SCHEMA["parameters"]["properties"].items()
+    }
+    assignee = parameters["properties"]["assignee"]
+    assignee["description"] = (
+        assignee["description"]
+        + "\n\nDispatchable assignees in this gateway:\n"
+        + "\n".join(lines)
+        + "\nChoose an assignee by matching the task to its described capability. "
+        + "Addressing the current orchestrator as 'you' does not by itself select "
+        + "the current/default profile; an explicit executor instruction takes "
+        + "precedence. Hermes profiles remain valid."
+    )
+    return {"parameters": parameters}
+
+
 KANBAN_UNBLOCK_SCHEMA = {
     "name": "kanban_unblock",
     "description": (
@@ -2009,6 +2067,7 @@ registry.register(
     handler=_handle_create,
     check_fn=_check_kanban_mode,
     emoji="➕",
+    dynamic_schema_overrides=_kanban_create_schema_overrides,
 )
 
