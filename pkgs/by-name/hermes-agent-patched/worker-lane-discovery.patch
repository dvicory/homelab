index 0000000000000000000000000000000000000000..90aa8b97bcd752e8bc112021b218b0a135d193d0
--- /dev/null
+++ b/tests/hermes_cli/test_worker_lane_discovery.py
@@ -0,0 +1,140 @@
+"""Model-facing discovery tests for registered external worker lanes."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import profiles as profiles_mod
+from hermes_cli import worker_lanes as wl
+
+
+@pytest.fixture(autouse=True)
+def _isolated_worker_lanes(monkeypatch):
+    wl.clear_worker_lanes()
+    monkeypatch.setattr(profiles_mod, "list_profiles", lambda: [])
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "schema-probe")
+    yield
+    wl.clear_worker_lanes()
+
+
+def _spawn(_task, _workspace, *, board=None):
+    del board
+    return 4242
+
+
+def _kanban_create_definition():
+    import tools.kanban_tools  # noqa: F401 -- ensure tool registration
+    from tools.registry import invalidate_check_fn_cache, registry
+    from toolsets import resolve_toolset
+
+    invalidate_check_fn_cache()
+    definitions = registry.get_definitions(
+        set(resolve_toolset("kanban")),
+        quiet=True,
+    )
+    return next(
+        definition["function"]
+        for definition in definitions
+        if definition["function"]["name"] == "kanban_create"
+    )
+
+
+def test_worker_lane_description_is_normalized():
+    lane = wl.WorkerLane(
+        name="review-lane",
+        spawn_fn=_spawn,
+        description="  read-only architecture and code review  ",
+    )
+
+    assert lane.description == "read-only architecture and code review"
+
+
+def test_kanban_create_advertises_registered_worker_lanes():
+    wl.register_worker_lane(
+        wl.WorkerLane(
+            name="review-lane",
+            spawn_fn=_spawn,
+            description="read-only architecture and code review",
+        )
+    )
+    wl.register_worker_lane(
+        wl.WorkerLane(
+            name="implementation-lane",
+            spawn_fn=_spawn,
+            description="implementation that may modify files",
+        )
+    )
+
+    definition = _kanban_create_definition()
+    description = definition["parameters"]["properties"]["assignee"]["description"]
+
+    assert "Hermes profile or registered external worker lane" in description
+    assert "- review-lane [external worker lane]: read-only architecture and code review" in description
+    assert "- implementation-lane [external worker lane]: implementation that may modify files" in description
+
+
+def test_kanban_create_advertises_profiles_and_lane_precedence(monkeypatch):
+    monkeypatch.setattr(
+        profiles_mod,
+        "list_profiles",
+        lambda: [
+            SimpleNamespace(name="default", description="general-purpose Hermes agent"),
+            SimpleNamespace(name="review-lane", description="shadowed profile"),
+        ],
+    )
+    wl.register_worker_lane(
+        wl.WorkerLane(
+            name="review-lane",
+            spawn_fn=_spawn,
+            description="read-only architecture and code review",
+        )
+    )
+
+    definition = _kanban_create_definition()
+    description = definition["parameters"]["properties"]["assignee"]["description"]
+
+    assert "- default [Hermes profile]: general-purpose Hermes agent" in description
+    assert "- review-lane [external worker lane]: read-only architecture" in description
+    assert "shadowed profile" not in description
+    assert description.count("- review-lane") == 1
+
+
+def test_kanban_create_routes_by_capability_not_current_identity():
+    wl.register_worker_lane(
+        wl.WorkerLane(
+            name="review-lane",
+            spawn_fn=_spawn,
+            description="read-only architecture and code review",
+        )
+    )
+
+    definition = _kanban_create_definition()
+    properties = definition["parameters"]["properties"]
+    assignee_description = properties["assignee"]["description"]
+    parents_description = properties["parents"]["description"]
+
+    assert "matching the task to its described capability" in assignee_description
+    assert "does not by itself select the current/default profile" in assignee_description
+    assert "explicit executor instruction takes precedence" in assignee_description
+    assert "dependency gating and durable lineage" in parents_description
+    assert "completed parents' summary and metadata" in parents_description
+
+
+def test_kanban_guidance_recognizes_profiles_and_external_lanes():
+    from agent.prompt_builder import KANBAN_GUIDANCE
+
+    assert "Choose dispatchable assignees" in KANBAN_GUIDANCE
+    assert "does not select the current/default profile" in KANBAN_GUIDANCE
+    assert "handoffs enter worker context without delay" in KANBAN_GUIDANCE
+    assert "assignee=<right-profile>" not in KANBAN_GUIDANCE
+    assert "Ground every assignee in a real profile" not in KANBAN_GUIDANCE
+
+
+def test_kanban_create_without_registered_lanes_keeps_generic_schema():
+    definition = _kanban_create_definition()
+    description = definition["parameters"]["properties"]["assignee"]["description"]
+
+    assert "Hermes profile or registered external worker lane" in description
+    assert "Dispatchable assignees in this gateway" not in description
