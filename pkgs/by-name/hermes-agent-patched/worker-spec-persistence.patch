+WORKER_SPEC_VALIDATED_EVENT = "worker_spec_validated"
+WORKER_SPEC_EVENT = "worker_spec_resolved"
+
+
+def get_task_worker_specification(
+    conn: sqlite3.Connection, task_id: str, *, run_id: Optional[int] = None
+):
+    """Return the current run specification, or the latest validated template."""
+    if run_id is None:
+        task_row = conn.execute(
+            "SELECT current_run_id FROM tasks WHERE id = ?", (task_id,)
+        ).fetchone()
+        run_id = task_row["current_run_id"] if task_row else None
+    if run_id is not None:
+        row = conn.execute(
+            "SELECT metadata FROM task_runs WHERE id = ? AND task_id = ?",
+            (int(run_id), task_id),
+        ).fetchone()
+        raw = row["metadata"] if row else None
+    else:
+        row = conn.execute(
+            "SELECT payload FROM task_events WHERE task_id = ? "
+            "AND kind IN (?, ?) ORDER BY id DESC LIMIT 1",
+            (task_id, WORKER_SPEC_EVENT, WORKER_SPEC_VALIDATED_EVENT),
+        ).fetchone()
+        raw = row["payload"] if row else None
+    if not raw:
+        return None
+    from hermes_cli.worker_catalogue import WorkerSpecification
+    try:
+        payload = json.loads(raw)
+        value = payload.get("worker_spec") if isinstance(payload, dict) else None
+        return WorkerSpecification.from_json(
+            json.dumps(value, sort_keys=True, separators=(",", ":"))
+        )
+    except Exception:
+        return None
+
+
+def _append_worker_specification(
+    conn: sqlite3.Connection,
+    task_id: str,
+    worker_spec,
+    *,
+    run_id: Optional[int] = None,
+) -> None:
+    _append_event(
+        conn,
+        task_id,
+        WORKER_SPEC_EVENT if run_id is not None else WORKER_SPEC_VALIDATED_EVENT,
+        {
+            "worker_spec": worker_spec.as_dict(),
+            "workspace_generation": worker_spec.workspace_generation,
+        },
+        run_id=run_id,
+    )
+
