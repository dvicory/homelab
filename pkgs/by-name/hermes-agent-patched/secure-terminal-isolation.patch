index 0000000..da70515
--- /dev/null
+++ b/tests/tools/test_secure_terminal_scope.py
@@ -0,0 +1,34 @@
+"""Regression tests for deployment-selectable terminal isolation scope."""
+
+from tools.terminal_tool import _environment_task_id, _resolve_container_task_id
+
+
+def test_upstream_default_remains_shared(monkeypatch):
+    monkeypatch.delenv("TERMINAL_ISOLATION_SCOPE", raising=False)
+
+    assert _environment_task_id("turn-a", "conversation-a") == "turn-a"
+    assert _resolve_container_task_id("turn-a") == "default"
+    assert _resolve_container_task_id("turn-b") == "default"
+
+
+def test_conversation_scope_is_stable_and_separate(monkeypatch):
+    monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+
+    raw_a = _environment_task_id("turn-a", "conversation-a")
+    raw_a_later = _environment_task_id("turn-b", "conversation-a")
+    raw_b = _environment_task_id("turn-c", "conversation-b")
+
+    key_a = _resolve_container_task_id(raw_a)
+    assert _resolve_container_task_id(raw_a_later) == key_a
+    assert _resolve_container_task_id(raw_b) != key_a
+    assert key_a.startswith("conversation-")
+    assert "conversation-a" not in key_a
+
+
+def test_conversation_scope_falls_back_to_task_without_session(monkeypatch):
+    monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+
+    raw = _environment_task_id("task-a", None)
+
+    assert raw == "task-a"
+    assert _resolve_container_task_id(raw).startswith("conversation-")
