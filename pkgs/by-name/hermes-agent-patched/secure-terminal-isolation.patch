diff --git a/tests/tools/test_secure_terminal_identity_integration.py b/tests/tools/test_secure_terminal_identity_integration.py
new file mode 100644
index 0000000000000000000000000000000000000000..326ee1255531a3437fe3ccd77cfde74bbaeebfbc
--- /dev/null
+++ b/tests/tools/test_secure_terminal_identity_integration.py
@@ -0,0 +1,244 @@
+"""Cross-surface integration tests for canonical environment identity.
+
+Two conversations drive terminal, background-process, file, search, patch,
+and execute-code surfaces end to end (with the environment backend faked at
+the BaseEnvironment boundary) and must never observe each other's
+environment, cached file ops, processes, or cleanup — and every surface
+must resolve the *same* key within one conversation.
+
+The real two-session container proof runs against the QA Podman backend at
+deploy time; here we pin the identity contract every surface depends on.
+"""
+
+import json
+import os
+import subprocess
+
+
+import pytest
+
+from tools import code_execution_tool, file_tools, process_registry, terminal_tool
+from tools.terminal_tool import environment_key
+
+
+class FakeEnvironment:
+    """Minimal BaseEnvironment stand-in recording the identity it got."""
+
+    def __init__(self, task_id, **kwargs):
+        self.task_id = task_id
+        self.kwargs = kwargs
+        self.cleaned = False
+        self.cwd = "/workspace"
+        self.env = {}
+        self.commands = []
+
+    def execute(
+        self,
+        command,
+        cwd=None,
+        *,
+        timeout=None,
+        stdin_data=None,
+        rewrite_compound_background=True,
+        bounded_capture=False,
+    ):
+        """Mirror BaseEnvironment.execute for shell-backed file operations."""
+        self.commands.append(command)
+        run_cwd = cwd if cwd and os.path.isdir(cwd) else None
+        completed = subprocess.run(
+            command,
+            shell=True,
+            cwd=run_cwd,
+            env={**os.environ, **self.env},
+            input=stdin_data,
+            text=True,
+            capture_output=True,
+            timeout=timeout,
+        )
+        return {
+            "output": completed.stdout + completed.stderr,
+            "returncode": completed.returncode,
+        }
+
+
+    def cleanup(self, **kwargs):
+        self.cleaned = True
+
+
+@pytest.fixture
+def two_sessions(monkeypatch):
+    """Conversation scope with two sessions and a recording env factory."""
+    monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+
+    created = {}
+
+    def fake_create(task_id, **kwargs):
+        env = FakeEnvironment(task_id, **kwargs)
+        created[task_id] = env
+        return env
+
+    monkeypatch.setattr(terminal_tool, "_create_environment", fake_create)
+    monkeypatch.setattr(terminal_tool, "_start_cleanup_thread", lambda: None)
+    # Guard rails that require approval/config must not interfere.
+    monkeypatch.setattr(terminal_tool, "_check_all_guards", lambda *a, **k: None)
+    monkeypatch.setattr(
+        code_execution_tool,
+        "_load_config",
+        lambda: {"timeout": 5, "max_tool_calls": 3},
+    )
+
+    sessions = {
+        "a": {"task_id": "task-a", "session_id": "session-a"},
+        "b": {"task_id": "task-b", "session_id": "session-b"},
+    }
+    yield created, sessions
+
+    # Do not leak environments/processes into other tests.
+    for key in list(terminal_tool._active_environments.keys()):
+        terminal_tool._active_environments.pop(key, None)
+        terminal_tool._last_activity.pop(key, None)
+    terminal_tool._task_env_overrides.clear()
+    terminal_tool._environment_owners.clear()
+    process_registry.process_registry.kill_all()
+
+
+def _run_terminal(task_id, session_id, command="true"):
+    return json.loads(
+        terminal_tool._handle_terminal(
+            {"command": command}, task_id=task_id, session_id=session_id
+        )
+    )
+
+
+def test_every_surface_resolves_one_key_per_conversation(two_sessions):
+    created, sessions = two_sessions
+    key_a = environment_key(**sessions["a"])
+    key_b = environment_key(**sessions["b"])
+    assert key_a != key_b
+
+    for session in sessions.values():
+        tid = environment_key(**session)
+        # Terminal surface (creates the environment).
+        _run_terminal(**session)
+        # File surfaces reuse the same cached environment/file_ops.
+        file_ops = file_tools._get_file_ops(environment_key(**session))
+        assert file_ops is not None
+        # Execute-code resolves the same environment.
+        env, _ = code_execution_tool._get_or_create_env(**session)
+        assert env is created[tid]
+
+    assert set(created.keys()) == {key_a, key_b}
+
+
+def test_worker_reuses_exact_pre_spawn_environment_key(two_sessions, monkeypatch):
+    """A spawned worker cannot derive a different key from its delegate session."""
+    created, session = two_sessions
+    pre_spawn_key = "authority-pre-spawn-key"
+    monkeypatch.setenv("HERMES_BROKER_ENVIRONMENT_KEY", pre_spawn_key)
+
+    assert environment_key(**session["a"]) == pre_spawn_key
+    _run_terminal(**session["a"])
+    assert created[pre_spawn_key] is terminal_tool.get_active_env("delegate-session")
+
+    file_ops = file_tools._get_file_ops(
+        session["a"]["task_id"], session["a"]["session_id"]
+    )
+    env, _ = code_execution_tool._get_or_create_env(**session["a"])
+    assert file_ops.env is env
+    assert env is created[pre_spawn_key]
+
+
+def test_conversations_cannot_observe_each_other(two_sessions):
+    created, sessions = two_sessions
+    key_a = environment_key(**sessions["a"])
+    key_b = environment_key(**sessions["b"])
+
+    _run_terminal(**sessions["a"])
+    _run_terminal(**sessions["b"])
+
+    # Distinct environment objects with their own command history.
+    assert created[key_a] is not created[key_b]
+
+    # get_active_env (agent-loop path) resolves per conversation.
+    assert terminal_tool.get_active_env(sessions["a"]["session_id"]) is created[key_a]
+    assert terminal_tool.get_active_env(sessions["b"]["session_id"]) is created[key_b]
+
+    # Background processes spawn under the canonical key and list per key.
+    registry = process_registry.process_registry
+    proc_a = registry.spawn_local(
+        command="sleep 0.1", cwd="/tmp", task_id=key_a, session_key="sk-a"
+    )
+    proc_b = registry.spawn_local(
+        command="sleep 0.1", cwd="/tmp", task_id=key_b, session_key="sk-b"
+    )
+    listed_a = {p["session_id"] for p in registry.list_sessions(task_id=key_a)}
+    listed_b = {p["session_id"] for p in registry.list_sessions(task_id=key_b)}
+    assert proc_a.id in listed_a
+    assert proc_b.id not in listed_a
+    assert proc_b.id in listed_b
+    assert proc_a.id not in listed_b
+
+    # Cleanup by raw session id tears down only that conversation's env,
+    # resolving through the canonical key rather than the raw identifier.
+    terminal_tool.cleanup_vm(sessions["a"]["session_id"])
+    assert created[key_a].cleaned
+    assert not created[key_b].cleaned
+    assert terminal_tool.get_active_env(sessions["b"]["session_id"]) is created[key_b]
+
+
+def test_file_first_slow_path_creates_environment_without_error(two_sessions):
+    """A file operation before any terminal call must create the env via
+    the slow path (regression: raw_task_id must remain bound there)."""
+    created, sessions = two_sessions
+    key_a = environment_key(**sessions["a"])
+
+    # No terminal call first: _get_file_ops must build the environment
+    # through the creation branch, including resolve_task_overrides.
+    ops = file_tools._get_file_ops(key_a)
+    assert ops is not None
+    assert key_a in created
+    assert file_tools._get_file_ops(key_a) is ops
+
+
+def test_process_list_handler_uses_canonical_key(two_sessions, monkeypatch):
+    _, sessions = two_sessions
+    key_a = environment_key(**sessions["a"])
+    key_b = environment_key(**sessions["b"])
+
+    registry = process_registry.process_registry
+    proc_a = registry.spawn_local(
+        command="sleep 0.1", cwd="/tmp", task_id=key_a, session_key=""
+    )
+    proc_b = registry.spawn_local(command="sleep 0.1", cwd="/tmp", task_id=key_b, session_key="")
+
+    result = json.loads(
+        process_registry._handle_process(
+            {"action": "list"}, task_id=sessions["a"]["task_id"],
+            session_id=sessions["a"]["session_id"],
+        )
+    )
+    listed = {p["session_id"] for p in result["processes"]}
+    assert proc_a.id in listed
+    assert proc_b.id not in listed
+
+def test_cd_relative_file_write_uses_trusted_gateway_cwd(two_sessions, tmp_path):
+    """A relative file write follows terminal ``cd`` for the same gateway key."""
+    from tools.approval import reset_current_session_key, set_current_session_key
+
+    _, sessions = two_sessions
+    token = set_current_session_key("gateway-session")
+    try:
+        terminal_tool.record_session_cwd("gateway-session", str(tmp_path))
+        result = json.loads(
+            file_tools._handle_write_file(
+                {"path": "nested/result.txt", "content": "trusted cwd\n"},
+                task_id=sessions["a"]["task_id"],
+                session_id=sessions["a"]["session_id"],
+            )
+        )
+        assert not result.get("error"), result
+        assert (tmp_path / "nested" / "result.txt").read_text() == "trusted cwd\n"
+    finally:
+        terminal_tool.clear_session_cwd("gateway-session")
+        reset_current_session_key(token)
+
diff --git a/tests/tools/test_secure_terminal_scope.py b/tests/tools/test_secure_terminal_scope.py
new file mode 100644
index 0000000000000000000000000000000000000000..9cdb4224bd2c3bdc594d64856113ff44f104d72b
--- /dev/null
+++ b/tests/tools/test_secure_terminal_scope.py
@@ -0,0 +1,150 @@
+"""Regression tests for the canonical environment identity (environment_key).
+
+Every environment-backed surface (terminal, process, file, patch, search,
+execute-code, cleanup, worker-lane dispatch) resolves identity through
+``tools.terminal_tool.environment_key`` and only that function. These tests
+pin its scope semantics; the cross-surface integration lives in
+``test_secure_terminal_identity_integration.py``.
+"""
+
+from tools import terminal_tool
+from tools.terminal_tool import environment_key
+
+
+def test_upstream_default_remains_shared(monkeypatch):
+    monkeypatch.delenv("TERMINAL_ISOLATION_SCOPE", raising=False)
+
+    assert environment_key("turn-a", "conversation-a") == "default"
+    assert environment_key("turn-b", "conversation-b") == "default"
+    assert environment_key(None, None) == "default"
+
+
+def test_conversation_scope_is_stable_and_separate(monkeypatch):
+    monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+
+    key_a = environment_key("turn-a", "conversation-a")
+    key_a_later = environment_key("turn-b", "conversation-a")
+    key_b = environment_key("turn-c", "conversation-b")
+
+    assert key_a == key_a_later
+    assert key_b != key_a
+    assert key_a.startswith("conversation-")
+    # The opaque key must not embed the platform conversation identifier.
+    assert "conversation-a" not in key_a
+    assert "conversation-b" not in key_b
+
+
+def test_conversation_scope_falls_back_to_task_without_session(monkeypatch):
+    monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+
+    assert environment_key("task-a", None).startswith("conversation-")
+
+
+def test_missing_identifiers_fall_back_explicitly(monkeypatch):
+    monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+
+    # Only reachable for platform-internal calls with no conversation
+    # context; two *identified* conversations never land here.
+    assert environment_key(None, None) == "default"
+    assert environment_key("", "") == "default"
+
+
+def test_derived_keys_pass_through_unchanged(monkeypatch):
+    monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+
+    key = environment_key("turn-a", "conversation-a")
+
+    # Re-resolving a canonical key (e.g. an internal helper receiving an
+    # already-derived identity) must not derive a fresh key and orphan the
+    # environment.
+    assert environment_key(key) == key
+    assert environment_key(key, None) == key
+    # A raw session id always wins over a carried key: the trusted
+    # conversation identity defines the environment.
+    assert environment_key(key, "conversation-b") == environment_key(None, "conversation-b")
+
+
+def test_isolation_override_wins_in_both_scopes(monkeypatch):
+    terminal_tool.register_task_env_overrides(
+        "tb2-task", {"docker_image": "tb2:image", "cwd": "/app"}
+    )
+    try:
+        monkeypatch.delenv("TERMINAL_ISOLATION_SCOPE", raising=False)
+        assert environment_key("tb2-task") == "tb2-task"
+
+        monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+        assert environment_key("tb2-task", "conversation-a") == "tb2-task"
+    finally:
+        terminal_tool.clear_task_env_overrides("tb2-task")
+
+
+def test_cwd_only_override_does_not_isolate(monkeypatch):
+    terminal_tool.register_task_env_overrides("acp-session", {"cwd": "/work"})
+    try:
+        monkeypatch.delenv("TERMINAL_ISOLATION_SCOPE", raising=False)
+        assert environment_key("acp-session") == "default"
+
+        monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+        assert environment_key("acp-session").startswith("conversation-")
+    finally:
+        terminal_tool.clear_task_env_overrides("acp-session")
+
+
+def test_close_releases_only_raw_owner_and_exact_environment(monkeypatch):
+    """Closing one shared-session agent cannot kill a sibling's state."""
+    import threading
+
+    from run_agent import AIAgent
+    from tools import process_registry
+
+    class FakeEnvironment:
+        def __init__(self):
+            self.cleaned = False
+
+        def cleanup(self):
+            self.cleaned = True
+
+    terminal_tool._active_environments.clear()
+    terminal_tool._last_activity.clear()
+    terminal_tool._environment_owners.clear()
+    env = FakeEnvironment()
+    terminal_tool._active_environments["default"] = env
+    terminal_tool.remember_environment_owner("default", "session-a")
+    terminal_tool.remember_environment_owner("default", "session-b")
+    proc_a = process_registry.process_registry.spawn_local(
+        "sleep 30", cwd="/tmp", task_id="default", session_key="session-a"
+    )
