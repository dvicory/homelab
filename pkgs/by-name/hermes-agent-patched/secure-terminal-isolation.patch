+"""Regression tests for the canonical environment identity (environment_key).
+
+Every environment-backed surface (terminal, process, file, patch, search,
+execute-code, cleanup, worker-lane dispatch) resolves identity through
+``tools.terminal_tool.environment_key`` and only that function. These tests
+pin its scope semantics; the cross-surface integration lives in
+``test_secure_terminal_identity_integration.py``.
+"""
+
+from tools import terminal_tool
+from tools.terminal_tool import environment_key
+
+
+def test_upstream_default_remains_shared(monkeypatch):
+    monkeypatch.delenv("TERMINAL_ISOLATION_SCOPE", raising=False)
+
+    assert environment_key("turn-a", "conversation-a") == "default"
+    assert environment_key("turn-b", "conversation-b") == "default"
+    assert environment_key(None, None) == "default"
+
+
+def test_conversation_scope_is_stable_and_separate(monkeypatch):
+    monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+
+    key_a = environment_key("turn-a", "conversation-a")
+    key_a_later = environment_key("turn-b", "conversation-a")
+    key_b = environment_key("turn-c", "conversation-b")
+
+    assert key_a == key_a_later
+    assert key_b != key_a
+    assert key_a.startswith("conversation-")
+    # The opaque key must not embed the platform conversation identifier.
+    assert "conversation-a" not in key_a
+    assert "conversation-b" not in key_b
+
+
+def test_conversation_scope_falls_back_to_task_without_session(monkeypatch):
+    monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+
+    assert environment_key("task-a", None).startswith("conversation-")
+
+
+def test_missing_identifiers_fall_back_explicitly(monkeypatch):
+    monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+
+    # Only reachable for platform-internal calls with no conversation
+    # context; two *identified* conversations never land here.
+    assert environment_key(None, None) == "default"
+    assert environment_key("", "") == "default"
+
+
+def test_derived_keys_pass_through_unchanged(monkeypatch):
+    monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+
+    key = environment_key("turn-a", "conversation-a")
+
+    # Re-resolving a canonical key (e.g. an internal helper receiving an
+    # already-derived identity) must not derive a fresh key and orphan the
+    # environment.
+    assert environment_key(key) == key
+    assert environment_key(key, None) == key
+    # A raw session id always wins over a carried key: the trusted
+    # conversation identity defines the environment.
+    assert environment_key(key, "conversation-b") == environment_key(None, "conversation-b")
+
+
+def test_isolation_override_wins_in_both_scopes(monkeypatch):
+    terminal_tool.register_task_env_overrides(
+        "tb2-task", {"docker_image": "tb2:image", "cwd": "/app"}
+    )
+    try:
+        monkeypatch.delenv("TERMINAL_ISOLATION_SCOPE", raising=False)
+        assert environment_key("tb2-task") == "tb2-task"
+
+        monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+        assert environment_key("tb2-task", "conversation-a") == "tb2-task"
+    finally:
+        terminal_tool.clear_task_env_overrides("tb2-task")
+
+
+def test_cwd_only_override_does_not_isolate(monkeypatch):
+    terminal_tool.register_task_env_overrides("acp-session", {"cwd": "/work"})
+    try:
+        monkeypatch.delenv("TERMINAL_ISOLATION_SCOPE", raising=False)
+        assert environment_key("acp-session") == "default"
+
+        monkeypatch.setenv("TERMINAL_ISOLATION_SCOPE", "conversation")
+        assert environment_key("acp-session").startswith("conversation-")
+    finally:
+        terminal_tool.clear_task_env_overrides("acp-session")
