+"""Contract tests for the broker workspace lifecycle plugin."""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+
+PLUGIN = Path(__file__).parents[2] / "plugins" / "workspace-service" / "__init__.py"
+
+
+def load_plugin(monkeypatch):
+    monkeypatch.setenv("HERMES_GONDOLIN_SOCKET", "/run/broker.sock")
+    monkeypatch.setenv("GONDOLIN_EFFECT_CONTROL_SOCKET", "/run/control.sock")
+    monkeypatch.setenv("HERMES_SANDBOX_AUTHORITY_BINDING", "qa:gateway:default:v1")
+    sys.modules.pop("workspace_service_test", None)
+    spec = importlib.util.spec_from_file_location("workspace_service_test", PLUGIN)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_plugin_acquires_once_and_injects_only_opaque_workspace_context(monkeypatch):
+    plugin = load_plugin(monkeypatch)
+    registered = []
+    monkeypatch.setattr(
+        plugin.terminal_tool,
+        "register_task_authority_binding",
+        lambda identity, binding: registered.append((identity, binding)),
+    )
+    monkeypatch.setattr(
+        plugin.terminal_tool,
+        "environment_key",
+        lambda task_id, session_id: "authority-" + (task_id or session_id),
+    )
+    calls = []
+
+    def request(route, body):
+        calls.append((route, body))
+        return {
+            "workspace": {"workspaceId": "workspace-opaque", "guestPath": "/workspace"},
+            "lease": {"leaseId": "lease-opaque"},
+        }
+
+    monkeypatch.setattr(plugin, "_request", request)
+    first = plugin._on_pre_llm_call(task_id="task-a", session_id="session-a")
+    second = plugin._on_pre_llm_call(task_id="task-a", session_id="session-a")
+
+    assert first == second
+    assert "workspace-opaque" in first["context"]
+    assert "/workspace" in first["context"]
+    assert "/run/control.sock" not in first["context"]
+    assert calls == [
+        ("/v1/control/workspaces/acquire", {"environmentKey": "authority-task-a"})
+    ]
+    assert registered == [
+        ("task-a", "qa:gateway:default:v1"),
+        ("task-a", "qa:gateway:default:v1"),
+    ]
+
+
+def test_workspace_tools_fail_closed_but_unrelated_tools_do_not_allocate(monkeypatch):
+    plugin = load_plugin(monkeypatch)
+    monkeypatch.setattr(plugin.terminal_tool, "register_task_authority_binding", lambda *_: None)
+    monkeypatch.setattr(plugin.terminal_tool, "environment_key", lambda *_: "authority-task")
+    monkeypatch.setattr(
+        plugin, "_request", lambda *_: (_ for _ in ()).throw(RuntimeError("broker offline"))
+    )
+
+    assert plugin._on_pre_tool_call(tool_name="web_search", task_id="task-a") is None
+    assert {"terminal", "process", "execute_code"}.issubset(plugin._WORKSPACE_TOOLS)
+    for tool_name in plugin._WORKSPACE_TOOLS:
+        blocked = plugin._on_pre_tool_call(tool_name=tool_name, task_id="task-a")
+        assert blocked["action"] == "block"
+        assert "broker offline" in blocked["message"]
+
+
+def test_transport_outage_message_states_shared_gate_and_recovery(monkeypatch):
+    plugin = load_plugin(monkeypatch)
+    monkeypatch.setattr(plugin.terminal_tool, "register_task_authority_binding", lambda *_: None)
+    monkeypatch.setattr(plugin.terminal_tool, "environment_key", lambda *_: "authority-task")
+    monkeypatch.setattr(
+        plugin, "_request", lambda *_: (_ for _ in ()).throw(FileNotFoundError(2, "missing"))
+    )
+
+    blocked = plugin._on_pre_tool_call(tool_name="execute_code", task_id="task-a")
+    context = plugin._on_pre_llm_call(task_id="task-a")
+
+    assert blocked == {"action": "block", "message": plugin._BROKER_UNAVAILABLE_MESSAGE}
+    assert context == {"context": plugin._BROKER_UNAVAILABLE_MESSAGE}
+    assert "broker control plane is unreachable" in plugin._BROKER_UNAVAILABLE_MESSAGE
+    assert "workspace persistence state is unknown" in plugin._BROKER_UNAVAILABLE_MESSAGE
+    assert "Hermes restart is not required" in plugin._BROKER_UNAVAILABLE_MESSAGE
+
+
+def test_register_uses_generic_lifecycle_hooks(monkeypatch):
+    plugin = load_plugin(monkeypatch)
+    hooks = []
+    context = SimpleNamespace(register_hook=lambda name, callback: hooks.append((name, callback)))
+
+    plugin.register(context)
+
+    assert [name for name, _ in hooks] == ["pre_llm_call", "pre_tool_call"]
