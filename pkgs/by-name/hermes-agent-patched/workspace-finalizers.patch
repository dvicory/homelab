+def _workspace_operation_request(request: dict[str, Any]) -> str:
+    return json.dumps(request, sort_keys=True, separators=(",", ":"))
+
+
+def _workspace_operation_id(
+    kind: str, task_id: str, run_id: int, request_json: str
+) -> str:
+    encoded = "\x00".join((kind, task_id, str(run_id), request_json)).encode("utf-8")
+    return f"{kind}-{hashlib.sha256(encoded).hexdigest()[:32]}"
+
+
+def reserve_workspace_operation(
+    conn: sqlite3.Connection,
+    *,
+    kind: str,
+    task_id: str,
+    run_id: int,
+    request: dict[str, Any],
+) -> dict[str, Any]:
+    """Persist an idempotent external operation before invoking its callback."""
+    if kind not in {"publication", "preparation"}:
+        raise ValueError("workspace operation kind is invalid")
+    request_json = _workspace_operation_request(request)
+    operation_id = _workspace_operation_id(kind, task_id, int(run_id), request_json)
+    now = int(time.time())
+    with write_txn(conn):
+        task = conn.execute(
+            "SELECT current_run_id, status FROM tasks WHERE id = ?", (task_id,)
+        ).fetchone()
+        if task is None:
+            raise ValueError(f"unknown task: {task_id}")
+        if task["current_run_id"] != int(run_id) or task["status"] != "running":
+            raise RuntimeError("workspace operation run is stale")
+        conn.execute(
+            """
+            INSERT OR IGNORE INTO task_workspace_operations (
+                operation_id, task_id, run_id, kind, request_json, state,
+                result_json, last_error, created_at, updated_at
+            ) VALUES (?, ?, ?, ?, ?, 'pending', NULL, NULL, ?, ?)
+            """,
+            (operation_id, task_id, int(run_id), kind, request_json, now, now),
+        )
+        row = conn.execute(
+            "SELECT * FROM task_workspace_operations WHERE task_id=? AND run_id=? AND kind=?",
+            (task_id, int(run_id), kind),
+        ).fetchone()
+        if row is None or row["operation_id"] != operation_id or row["request_json"] != request_json:
+            raise RuntimeError("workspace operation conflicts with its persisted request")
+    return {
+        "operation_id": row["operation_id"],
+        "state": row["state"],
+        "request": json.loads(row["request_json"]),
+        "result": json.loads(row["result_json"]) if row["result_json"] else None,
+        "last_error": row["last_error"],
+    }
+
+
+def complete_workspace_operation(
+    conn: sqlite3.Connection,
+    *,
+    operation_id: str,
+    result: dict[str, Any],
+) -> dict[str, Any]:
+    result_json = _workspace_operation_request(result)
+    with write_txn(conn):
+        row = conn.execute(
+            "SELECT state, result_json FROM task_workspace_operations WHERE operation_id=?",
+            (operation_id,),
+        ).fetchone()
+        if row is None:
+            raise RuntimeError("workspace operation does not exist")
+        if row["state"] == "ready":
+            if row["result_json"] != result_json:
+                raise RuntimeError("workspace operation result conflicts with persisted result")
+        else:
+            conn.execute(
+                "UPDATE task_workspace_operations SET state='ready', result_json=?, "
+                "last_error=NULL, updated_at=? WHERE operation_id=? AND state='pending'",
+                (result_json, int(time.time()), operation_id),
+            )
+    return result
+
+
+def record_workspace_operation_error(
+    conn: sqlite3.Connection, *, operation_id: str, error: Exception
+) -> None:
+    with write_txn(conn):
+        conn.execute(
+            "UPDATE task_workspace_operations SET last_error=?, updated_at=? "
+            "WHERE operation_id=? AND state='pending'",
+            (str(error)[:2000], int(time.time()), operation_id),
+        )
+
+
+def _finalize_workspace_outputs(
+    conn: sqlite3.Connection,
+    *,
+    task_id: str,
+    run_id: Optional[int],
+    selected_outputs: Optional[list[str]],
+) -> Optional[dict[str, Any]]:
+    if selected_outputs is None:
+        return None
+    if run_id is None:
+        raise RuntimeError("workspace publication requires an active task run")
+    operation = reserve_workspace_operation(
+        conn,
+        kind="publication",
+        task_id=task_id,
+        run_id=int(run_id),
+        request={"selected_roots": selected_outputs},
+    )
+    if operation["state"] == "ready":
+        return operation["result"]
+    try:
+        from hermes_cli.plugins import invoke_required_hook
+
+        result = invoke_required_hook(
+            "finalize_kanban_task_completion",
+            task_id=task_id,
+            run_id=int(run_id),
+            finalization_id=operation["operation_id"],
+            workspace_outputs=selected_outputs,
+            board=get_current_board(),
+        )
+        if not isinstance(result, dict):
+            raise RuntimeError("workspace completion finalizer returned an invalid result")
+        for field in ("revisionId", "manifestDigest"):
+            if not isinstance(result.get(field), str) or not result[field]:
+                raise RuntimeError(f"workspace completion finalizer omitted {field}")
+        return complete_workspace_operation(
+            conn, operation_id=operation["operation_id"], result=result
+        )
+    except Exception as error:
+        record_workspace_operation_error(
+            conn, operation_id=operation["operation_id"], error=error
+        )
+        raise
+
