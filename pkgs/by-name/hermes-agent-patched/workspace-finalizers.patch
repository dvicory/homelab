+++ b/tests/plugins/test_workspace_finalizers.py
@@ -0,0 +1,176 @@
+"""Required, recoverable Kanban workspace finalization contracts."""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import plugins
+
+
+PLUGIN = Path(__file__).parents[2] / "plugins" / "workspace-service" / "__init__.py"
+
+
+def running_task(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    connection = kb.connect()
+    task_id = kb.create_task(connection, title="producer", assignee="worker")
+    claimed = kb.claim_task(connection, task_id, claimer="worker")
+    assert claimed is not None
+    task = kb.get_task(connection, task_id)
+    assert task is not None and task.current_run_id is not None
+    return connection, task
+
+
+def test_failed_required_finalizer_keeps_task_running_and_replays(monkeypatch, tmp_path):
+    connection, task = running_task(monkeypatch, tmp_path)
+    calls = []
+
+    def finalizer(hook_name, **kwargs):
+        calls.append((hook_name, kwargs))
+        if len(calls) == 1:
+            raise RuntimeError("broker unavailable")
+        return {"revisionId": "revision-opaque", "manifestDigest": "a" * 64}
+
+    monkeypatch.setattr(plugins, "invoke_required_hook", finalizer)
+    try:
+        with pytest.raises(RuntimeError, match="broker unavailable"):
+            kb.complete_task(
+                connection,
+                task.id,
+                expected_run_id=task.current_run_id,
+                workspace_outputs=["output"],
+            )
+        assert kb.get_task(connection, task.id).status == "running"
+        pending = connection.execute(
+            "SELECT * FROM task_workspace_operations WHERE task_id=?", (task.id,)
+        ).fetchone()
+        assert pending["state"] == "pending"
+        assert "broker unavailable" in pending["last_error"]
+
+        assert kb.complete_task(
+            connection,
+            task.id,
+            expected_run_id=task.current_run_id,
+            workspace_outputs=["output"],
+        )
+        assert kb.get_task(connection, task.id).status == "done"
+        ready = connection.execute(
+            "SELECT * FROM task_workspace_operations WHERE task_id=?", (task.id,)
+        ).fetchone()
+        assert ready["state"] == "ready"
+        assert calls[0][1]["finalization_id"] == calls[1][1]["finalization_id"]
+        assert calls[1][1]["run_id"] == task.current_run_id
+    finally:
+        connection.close()
+
+
+def test_ready_finalization_survives_retry_before_board_completion(monkeypatch, tmp_path):
+    connection, task = running_task(monkeypatch, tmp_path)
+    operation = kb.reserve_workspace_operation(
+        connection,
+        kind="publication",
+        task_id=task.id,
+        run_id=task.current_run_id,
+        request={"selected_roots": ["output"]},
+    )
+    kb.complete_workspace_operation(
+        connection,
+        operation_id=operation["operation_id"],
+        result={"revisionId": "revision-opaque", "manifestDigest": "b" * 64},
+    )
+    monkeypatch.setattr(
+        plugins,
+        "invoke_required_hook",
+        lambda *_args, **_kwargs: pytest.fail("ready operation called finalizer again"),
+    )
+    try:
+        assert kb.complete_task(
+            connection,
+            task.id,
+            expected_run_id=task.current_run_id,
+            workspace_outputs=["output"],
+        )
+    finally:
+        connection.close()
+
+
+def test_preparation_request_replays_and_conflicts_fail_closed(monkeypatch, tmp_path):
+    connection, task = running_task(monkeypatch, tmp_path)
+    request = {"source_task_id": "parent", "source_revision_id": "revision"}
+    try:
+        first = kb.reserve_workspace_operation(
+            connection, kind="preparation", task_id=task.id,
+            run_id=task.current_run_id, request=request,
+        )
+        replay = kb.reserve_workspace_operation(
+            connection, kind="preparation", task_id=task.id,
+            run_id=task.current_run_id, request=request,
+        )
+        assert replay["operation_id"] == first["operation_id"]
+        with pytest.raises(RuntimeError, match="conflicts"):
+            kb.reserve_workspace_operation(
+                connection, kind="preparation", task_id=task.id,
+                run_id=task.current_run_id,
+                request={"source_task_id": "another-parent"},
+            )
+    finally:
+        connection.close()
+
+
+def test_ordinary_completion_does_not_require_finalizer(monkeypatch, tmp_path):
+    connection, task = running_task(monkeypatch, tmp_path)
+    monkeypatch.setattr(
+        plugins,
+        "invoke_required_hook",
+        lambda *_args, **_kwargs: pytest.fail("ordinary completion invoked finalizer"),
+    )
+    try:
+        assert kb.complete_task(
+            connection, task.id, expected_run_id=task.current_run_id, result="done"
+        )
+        assert connection.execute(
+            "SELECT count(*) FROM task_workspace_operations"
+        ).fetchone()[0] == 0
+    finally:
+        connection.close()
+
+
+def test_plugin_finalizer_replays_without_reacquiring_closed_environment(monkeypatch):
+    monkeypatch.setenv("HERMES_GONDOLIN_SOCKET", "/run/broker.sock")
+    monkeypatch.setenv("HERMES_SANDBOX_AUTHORITY_BINDING", "qa:gateway:default:v1")
+    sys.modules.pop("workspace_finalizer_test", None)
+    spec = importlib.util.spec_from_file_location("workspace_finalizer_test", PLUGIN)
+    plugin = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(plugin)
+    monkeypatch.setattr(plugin, "_acquire", lambda **_: pytest.fail("finalizer reacquired"))
+    monkeypatch.setattr(plugin.terminal_tool, "register_task_authority_binding", lambda *_: None)
+    monkeypatch.setattr(plugin.terminal_tool, "environment_key", lambda *_: "authority-stable")
+    requests = []
+    monkeypatch.setattr(
+        plugin,
+        "_publish_workspace_revision",
+        lambda **kwargs: requests.append(kwargs)
+        or {"revisionId": "revision", "manifestDigest": "c" * 64},
+    )
+
+    result = plugin._on_finalize_task_completion(
+        task_id="task", run_id=7, finalization_id="finalization",
+        workspace_outputs=["output"],
+    )
+
+    assert result["revisionId"] == "revision"
+    assert requests == [{
+        "finalization_id": "finalization",
+        "environment_key": "authority-stable",
+        "task_id": "task",
+        "run_id": "7",
+        "selected_roots": ["output"],
+    }]
