+    def _json_post(
+        self, route: str, payload: dict, *, timeout: float | None = None
+    ) -> dict:
+        response = self._client.post(
+            route,
+            json=payload,
+            timeout=timeout or self._timeout,
+            headers={
+                "accept": "application/json",
+                "content-type": "application/json",
+            },
+        )
+        self._raise_for_status(response)
+        try:
+            body = response.json()
+        except (ValueError, json.JSONDecodeError) as exc:
+            raise BrokerError(
+                "protocol.invalid_response", "broker returned invalid JSON"
+            ) from exc
+        if not isinstance(body, dict):
+            raise BrokerError(
+                "protocol.invalid_response", "broker response is not an object"
+            )
+        return body
+
