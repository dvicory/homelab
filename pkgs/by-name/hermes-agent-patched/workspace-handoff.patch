+def _was_artifact_delivered(
+    conn: sqlite3.Connection, task_id: str, delivery_id: str
+) -> bool:
+    for event in _internal_events_for(conn, task_id, "workspace_artifact_delivered"):
+        payload = event.payload if isinstance(event.payload, dict) else {}
+        if payload.get("delivery_id") == delivery_id:
+            return True
+    return False
