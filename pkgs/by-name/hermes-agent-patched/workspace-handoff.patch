+def _attachment_for_delivery(
+    conn: sqlite3.Connection, task_id: str, delivery_id: str
+) -> Optional[Attachment]:
+    """Return the durable attachment recorded for one export delivery."""
+    for event in reversed(_internal_events_for(conn, task_id, "workspace_artifact_delivered")):
+        payload = event.payload if isinstance(event.payload, dict) else {}
+        if payload.get("delivery_id") != str(delivery_id):
+            continue
+        attachment_id = payload.get("attachment_id")
+        if attachment_id is None:
+            continue
+        try:
+            attachment = get_attachment(conn, int(attachment_id))
+        except (TypeError, ValueError):
+            attachment = None
+        if attachment is not None and Path(attachment.stored_path).is_file():
+            return attachment
+    return None
+
