+def _internal_events_for(
+    conn: sqlite3.Connection, task_id: str, kind: str
+) -> list[Event]:
+    rows = conn.execute(
+        "SELECT * FROM task_events WHERE task_id = ? AND kind = ? "
+        "ORDER BY created_at ASC, id ASC",
+        (task_id, kind),
+    ).fetchall()
+    out: list[Event] = []
+    for r in rows:
+        try:
+            payload = json.loads(r["payload"]) if r["payload"] else {}
+        except Exception:
+            payload = {}
+        out.append(Event(
+            id=r["id"], task_id=r["task_id"], kind=r["kind"], payload=payload,
+            created_at=r["created_at"],
+            run_id=(int(r["run_id"]) if r["run_id"] is not None else None),
+        ))
+    return out
+
