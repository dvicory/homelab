+def recover_completion_intents(
+    conn: sqlite3.Connection, *, board: Optional[str] = None
+) -> list[str]:
+    """Reconcile hidden broker intents before reclaiming/spawning workers."""
+    board_slug = board or _board_for_connection(conn)
+    rows = conn.execute(
+        "SELECT id, current_run_id FROM tasks WHERE status = 'running' "
+        "AND workspace_kind = 'broker' AND current_run_id IS NOT NULL"
+    ).fetchall()
+    recovered: list[str] = []
+    for row in rows:
+        task_id = str(row["id"])
+        run_id = int(row["current_run_id"])
+        intent = get_completion_intent(conn, task_id, run_id)
+        if not isinstance(intent, dict):
+            continue
+        try:
+            if complete_task(
+                conn, task_id, result=intent.get("result"),
+                summary=intent.get("summary"),
+                metadata=(
+                    dict(intent["metadata"])
+                    if isinstance(intent.get("metadata"), dict)
+                    else intent.get("metadata")
+                ),
+                created_cards=list(intent.get("created_cards", [])),
+                expected_run_id=run_id, artifacts=list(intent.get("artifacts", [])),
+                board=board_slug,
+            ):
+                recovered.append(task_id)
+        except Exception as exc:
+            _log.warning("kanban recovery for %s failed: %s", task_id, exc)
+    return recovered
+
+
