+def _required_identifier(value: Any, field: str) -> str:
+    if not isinstance(value, str) or not value:
+        raise RuntimeError(f"workspace.invalid_response: {field} is missing")
+    return value
+
+
+def _activate_task_run(
+    *,
+    environment_key: str,
+    task_id: str,
+    run_id: str,
+    workspace_id: str,
+    workspace_lease_id: str,
+    policy_digest: str,
+) -> dict[str, Any]:
+    response = _request("/v1/control/task-runs/activate", {
+        "environmentKey": environment_key,
+        "taskId": task_id,
+        "runId": run_id,
+        "workspaceId": workspace_id,
+        "workspaceLeaseId": workspace_lease_id,
+        "policyDigest": policy_digest,
+    })
+    activation = response.get("activation")
+    if not isinstance(activation, dict):
+        raise RuntimeError("workspace.invalid_response: activation is missing")
+    return {
+        "activationId": _required_identifier(activation.get("activationId"), "activationId"),
+        "epoch": activation.get("epoch"),
+    }
+
+
+def _publish_workspace_revision(
+    *,
+    finalization_id: str,
+    environment_key: str,
+    task_id: str,
+    run_id: str,
+    selected_roots: list[str],
+) -> dict[str, Any]:
+    response = _request("/v1/control/workspace-revisions/publish", {
+        "finalizationId": finalization_id,
+        "environmentKey": environment_key,
+        "taskId": task_id,
+        "runId": run_id,
+        "selectedRoots": selected_roots,
+    })
+    return {
+        "revisionId": _required_identifier(response.get("revisionId"), "revisionId"),
+        "manifestDigest": _required_identifier(response.get("manifestDigest"), "manifestDigest"),
+        "entryCount": response.get("entryCount"),
+        "logicalBytes": response.get("logicalBytes"),
+    }
+
+
+def _import_workspace_revision(
+    *,
+    preparation_id: str,
+    source_revision_id: str,
+    source_task_id: str,
+    destination_task_id: str,
+    destination_run_id: str,
+    destination_environment_key: str,
+    relation_digest: str,
+) -> dict[str, Any]:
+    response = _request("/v1/control/workspace-revisions/import", {
+        "preparationId": preparation_id,
+        "sourceRevisionId": source_revision_id,
+        "sourceTaskId": source_task_id,
+        "destinationTaskId": destination_task_id,
+        "destinationRunId": destination_run_id,
+        "destinationEnvironmentKey": destination_environment_key,
+        "relationDigest": relation_digest,
+    })
+    workspace = response.get("workspace")
+    lease = response.get("lease")
+    if not isinstance(workspace, dict) or not isinstance(lease, dict):
+        raise RuntimeError("workspace.invalid_response: imported binding is incomplete")
+    return {
+        "workspaceId": _required_identifier(workspace.get("workspaceId"), "workspaceId"),
+        "workspaceLeaseId": _required_identifier(lease.get("leaseId"), "workspaceLeaseId"),
+        "guestPath": workspace.get("guestPath"),
+    }
+
