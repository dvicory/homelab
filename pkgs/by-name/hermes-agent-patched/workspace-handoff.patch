+def _board_for_connection(conn: sqlite3.Connection) -> str:
+    """Recover the explicit board owning *conn* without consulting UI state."""
+    try:
+        row = conn.execute("PRAGMA database_list").fetchone()
+        path = str(row[2]) if row is not None and len(row) > 2 else ""
+        if path:
+            parent = Path(path).parent
+            if parent.name == "boards" and parent.parent.name == "kanban":
+                return Path(path).stem
+            if parent.parent.name == "boards":
+                return parent.name
+    except Exception:
+        pass
+    return DEFAULT_BOARD
