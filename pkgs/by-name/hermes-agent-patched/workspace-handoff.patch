+def _run_required_workspace_hook(
+    hook_name: str, *, task_id: str, board: str, run_id: int, **fields: Any
+) -> dict[str, Any]:
+    """Run a broker finalization hook and fail closed on missing/failed work."""
+    try:
+        from hermes_cli.plugins import has_hook, invoke_hook
+        if not has_hook(hook_name):
+            raise RuntimeError(f"{hook_name} is not registered")
+        results = invoke_hook(
+            hook_name, task_id=task_id, board=board, run_id=int(run_id), **fields
+        )
+    except Exception as exc:
+        raise RuntimeError(f"workspace finalization unavailable: {exc}") from exc
+    for result in results:
+        if result is True:
+            return {"ready": True}
+        if isinstance(result, dict) and result.get("ready") is True:
+            return dict(result)
+    raise RuntimeError("workspace finalization did not report broker-ready")
+
