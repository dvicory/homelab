+def record_artifact_delivered(
+    conn: sqlite3.Connection, task_id: str, *, delivery_id: str,
+    run_id: Optional[int] = None, board: Optional[str] = None
+) -> None:
+    """Durably acknowledge one notifier delivery without exposing its ID."""
+    with write_txn(conn):
+        _append_event(
+            conn, task_id, "workspace_artifact_delivered",
+            {"delivery_id": str(delivery_id), "kind": "artifact"}, run_id=run_id,
+        )
+
