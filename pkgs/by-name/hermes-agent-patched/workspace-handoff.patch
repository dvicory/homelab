new file mode 100644
--- /dev/null
+++ b/tests/plugins/test_workspace_handoff.py
@@ -0,0 +1,127 @@
+"""Durable Kanban fields and broker client contracts for workspace handoff."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import sqlite3
+import sys
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+
+
+PLUGIN = Path(__file__).parents[2] / "plugins" / "workspace-service" / "__init__.py"
+
+
+def load_plugin(monkeypatch):
+    monkeypatch.setenv("HERMES_GONDOLIN_SOCKET", "/run/broker.sock")
+    monkeypatch.setenv("HERMES_SANDBOX_AUTHORITY_BINDING", "qa:gateway:default:v1")
+    sys.modules.pop("workspace_handoff_test", None)
+    spec = importlib.util.spec_from_file_location("workspace_handoff_test", PLUGIN)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_handoff_intent_and_outputs_round_trip(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    with kb.connect() as connection:
+        task_id = kb.create_task(
+            connection,
+            title="child",
+            inherit_parent_workspace_output=True,
+        )
+        assert kb.complete_task(
+            connection,
+            task_id,
+            workspace_outputs=["output", "reports/final.json", "output"],
+        )
+        task = kb.get_task(connection, task_id)
+        assert task.inherit_parent_workspace_output is True
+        assert task.workspace_outputs == ["output", "reports/final.json"]
+        raw = connection.execute(
+            "SELECT inherit_parent_workspace_output, workspace_outputs FROM tasks WHERE id=?",
+            (task_id,),
+        ).fetchone()
+        assert raw[0] == 1
+        assert json.loads(raw[1]) == ["output", "reports/final.json"]
+
+
+def test_handoff_columns_migrate_with_safe_defaults(tmp_path):
+    database = tmp_path / "legacy.db"
+    with kb.connect(database):
+        pass
+    kb._INITIALIZED_PATHS.discard(str(database.resolve()))
+    connection = sqlite3.connect(database)
+    connection.execute("ALTER TABLE tasks DROP COLUMN inherit_parent_workspace_output")
+    connection.execute("ALTER TABLE tasks DROP COLUMN workspace_outputs")
+    connection.commit()
+    connection.close()
+    kb._INITIALIZED_PATHS.discard(str(database.resolve()))
+    with kb.connect(database) as migrated:
+        columns = {row["name"] for row in migrated.execute("PRAGMA table_info(tasks)")}
+        assert "inherit_parent_workspace_output" in columns
+        assert "workspace_outputs" in columns
+
+
+@pytest.mark.parametrize("outputs", [[], ["/host"], ["../escape"], ["a//b"], [3]])
+def test_completion_rejects_invalid_workspace_outputs(monkeypatch, tmp_path, outputs):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    with kb.connect() as connection:
+        task_id = kb.create_task(connection, title="task")
+        with pytest.raises(ValueError, match="workspace_outputs"):
+            kb.complete_task(connection, task_id, workspace_outputs=outputs)
+        assert kb.get_task(connection, task_id).status == "ready"
+
+
+def test_broker_handoff_client_uses_control_routes_and_opaque_results(monkeypatch):
+    plugin = load_plugin(monkeypatch)
+    calls = []
+
+    def request(route, body):
+        calls.append((route, body))
+        if route.endswith("activate"):
+            return {"activation": {"activationId": "activation-opaque", "epoch": 7}}
+        if route.endswith("publish"):
+            return {
+                "revisionId": "revision-opaque",
+                "manifestDigest": "a" * 64,
+                "entryCount": 2,
+                "logicalBytes": 9,
+            }
+        return {
+            "workspace": {"workspaceId": "workspace-opaque", "guestPath": "/workspace"},
+            "lease": {"leaseId": "lease-opaque"},
+        }
+
+    monkeypatch.setattr(plugin, "_request", request)
+    assert plugin._activate_task_run(
+        environment_key="environment", task_id="task", run_id="run",
+        workspace_id="workspace", workspace_lease_id="lease", policy_digest="a" * 64,
+    )["activationId"] == "activation-opaque"
+    assert plugin._publish_workspace_revision(
+        finalization_id="finalization", environment_key="environment", task_id="task",
+        run_id="run", selected_roots=["output"],
+    )["revisionId"] == "revision-opaque"
+    assert plugin._import_workspace_revision(
+        preparation_id="preparation", source_revision_id="revision", source_task_id="parent",
+        destination_task_id="child", destination_run_id="run", destination_environment_key="child-env",
+        relation_digest="b" * 64,
+    ) == {
+        "workspaceId": "workspace-opaque",
+        "workspaceLeaseId": "lease-opaque",
+        "guestPath": "/workspace",
+    }
+    assert [route for route, _ in calls] == [
+        "/v1/control/task-runs/activate",
+        "/v1/control/workspace-revisions/publish",
+        "/v1/control/workspace-revisions/import",
+    ]
