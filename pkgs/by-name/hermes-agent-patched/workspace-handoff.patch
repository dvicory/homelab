+def get_completion_intent(
+    conn: sqlite3.Connection, task_id: str, run_id: Optional[int] = None
+) -> Optional[dict[str, Any]]:
+    """Return the newest hidden completion intent for an exact run."""
+    events = _internal_events_for(conn, task_id, "completion_intent")
+    for event in reversed(events):
+        payload = event.payload if isinstance(event.payload, dict) else {}
+        if run_id is None or int(payload.get("run_id", -1)) == int(run_id):
+            return dict(payload)
+    return None
+
+
+def get_inheritance_intent(
+    conn: sqlite3.Connection, task_id: str
+) -> Optional[dict[str, Any]]:
+    """Return the newest child workspace inheritance intent."""
+    events = _internal_events_for(conn, task_id, "inheritance_intent")
+    if not events:
+        return None
+    payload = events[-1].payload
+    return dict(payload) if isinstance(payload, dict) else None
+
