+def _normalize_workspace_outputs(
+    workspace_outputs: Optional[Iterable[str]],
+) -> Optional[list[str]]:
+    if workspace_outputs is None:
+        return None
+    cleaned: list[str] = []
+    seen: set[str] = set()
+    for value in workspace_outputs:
+        if not isinstance(value, str):
+            raise ValueError("workspace_outputs entries must be strings")
+        root = value.strip()
+        if not root:
+            raise ValueError("workspace_outputs entries must not be empty")
+        if root.startswith("/") or "\x00" in root:
+            raise ValueError("workspace_outputs entries must be relative paths")
+        segments = root.split("/")
+        if root != "." and any(segment in {"", ".", ".."} for segment in segments):
+            raise ValueError("workspace_outputs entries must be normalized relative paths")
+        if root in seen:
+            continue
+        seen.add(root)
+        cleaned.append(root)
+    if not cleaned:
+        raise ValueError("workspace_outputs must contain at least one path")
+    return cleaned
