+def store_workspace_export_attachment(
+    conn: sqlite3.Connection,
+    task_id: str,
+    *,
+    filename: str,
+    data: bytes,
+    delivery_id: str,
+    run_id: Optional[int] = None,
+    board: Optional[str] = None,
+) -> Attachment:
+    """Atomically persist broker bytes and their hidden delivery marker.
+
+    The blob is fsynced and installed before a single SQLite transaction inserts
+    both the existing attachment row and the internal idempotency marker. A
+    notifier restart therefore reuses the same row instead of copying another
+    file; recipient send retries remain independent of broker token lifetimes.
+    """
+    if len(data) > KANBAN_ATTACHMENT_MAX_BYTES:
+        raise ArtifactPreservationError("export exceeds attachment limit")
+    if not filename or not str(filename).strip():
+        raise ArtifactPreservationError("export filename is required")
+    prior = _attachment_for_delivery(conn, task_id, str(delivery_id))
+    if prior is not None:
+        return prior
+    destination_dir = task_attachments_dir(task_id, board=board)
+    destination_dir.mkdir(parents=True, exist_ok=True)
+    destination = _collision_free_path(
+        destination_dir, _safe_attachment_name(str(filename)), set()
+    )
+    temporary = destination.with_name(
+        f".{destination.name}.{secrets.token_hex(8)}.tmp"
+    )
+    installed = False
+    try:
+        with temporary.open("xb") as output:
+            output.write(data)
+            output.flush()
+            os.fsync(output.fileno())
+        os.replace(temporary, destination)
+        installed = True
+        with write_txn(conn):
+            prior = _attachment_for_delivery(conn, task_id, str(delivery_id))
+            if prior is None:
+                if not conn.execute(
+                    "SELECT 1 FROM tasks WHERE id = ?", (task_id,)
+                ).fetchone():
+                    raise ValueError(f"unknown task {task_id}")
+                now = int(time.time())
+                cur = conn.execute(
+                    "INSERT INTO task_attachments "
+                    "(task_id, filename, stored_path, content_type, size, uploaded_by, created_at) "
+                    "VALUES (?, ?, ?, NULL, ?, 'workspace_export', ?)",
+                    (
+                        task_id, str(filename).strip(), str(destination.resolve()),
+                        len(data), now,
+                    ),
+                )
+                attachment_id = int(cur.lastrowid or 0)
+                _append_event(
+                    conn, task_id, "attached",
+                    {
+                        "filename": str(filename).strip(),
+                        "size": len(data),
+                        "by": "workspace_export",
+                    },
+                )
+                _append_event(
+                    conn, task_id, "workspace_artifact_delivered",
+                    {
+                        "delivery_id": str(delivery_id),
+                        "attachment_id": attachment_id,
+                        "filename": str(filename).strip(),
+                        "kind": "artifact",
+                    },
+                    run_id=run_id,
+                )
+            else:
+                try:
+                    destination.unlink(missing_ok=True)
+                except OSError:
+                    pass
+                installed = False
+        if prior is not None:
+            return prior
+        attachment = get_attachment(conn, attachment_id)
+        if attachment is None:
+            raise ArtifactPreservationError("stored export attachment disappeared")
+        return attachment
+    except Exception:
+        if installed:
+            try:
+                destination.unlink(missing_ok=True)
+            except OSError:
+                pass
+        try:
+            temporary.unlink(missing_ok=True)
+        except OSError:
+            pass
+        raise
+
 
 
