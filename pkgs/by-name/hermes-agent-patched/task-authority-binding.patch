+    if existing and "authority_binding_id" in existing and "authority_binding_id" not in overrides:
+        overrides = {**existing, **overrides}
     _task_env_overrides[task_id] = overrides
 
     # If a live environment already exists for this task, a freshly registered
@@ -1122,10 +1126,29 @@ def clear_task_env_overrides(task_id: str):
     _task_env_overrides.pop(task_id, None)
 
 
+def register_task_authority_binding(task_id: str, authority_binding_id: str) -> None:
+    """Bind a trusted opaque broker authority identity to a task or session.
+
+    This infrastructure-only hook is called by trusted lifecycle/session code
+    before the first environment-backed tool call.  The model cannot invoke
+    it through any tool schema.  The binding is kept in the existing task
+    environment registry so cleanup through clear_task_env_overrides also
+    removes it.  Registering after an environment exists intentionally leaves
+    that environment unchanged; subsequent resolution uses the new key.
+    """
+    if not isinstance(task_id, str) or not task_id.strip():
+        raise ValueError("task_id must be a non-empty string")
+    if not isinstance(authority_binding_id, str) or not authority_binding_id.strip():
+        raise ValueError("authority_binding_id must be a non-empty string")
+    overrides = dict(_task_env_overrides.get(task_id) or {})
+    overrides["authority_binding_id"] = authority_binding_id
+    register_task_env_overrides(task_id, overrides)
+
+
 # Derived environment keys are opaque: they never embed the platform
 # session/conversation identifier, so engine metadata (container names,
 # volume labels, process bookkeeping) cannot leak or be guessed from it.
-_DERIVED_ENV_KEY_RE = re.compile(r"^conversation-[0-9a-f]{24}$")
+_DERIVED_ENV_KEY_RE = re.compile(r"^(?:conversation|authority)-[0-9a-f]{24}$")
 
 # Overrides containing any of these keys request an isolated per-task
 # sandbox (RL / benchmark rollouts); CWD-only overrides are *not*
@@ -1154,10 +1177,13 @@ def environment_key(task_id: Optional[str] = None, session_id: Optional[str] = N
       explicit per-task fallback. The raw identifier is never exposed.
     * ``shared`` (upstream default): everything collapses to ``"default"``
       so subagents share the parent's long-lived environment.
-    * Isolation overrides (``register_task_env_overrides`` with backend
-      image keys or ``env_type``) always win in either scope and keep the
-      raw task id as the key -- that isolation is the point of the
-      override.
+    * A trusted authority_binding_id registered through
+      register_task_authority_binding derives an opaque
+      authority-<sha256> key from the task/session identity and binding.
+      This path takes precedence over ordinary backend overrides.
+    * Isolation overrides (register_task_env_overrides with backend image
+      keys or env_type) always win over conversation collapsing and keep the
+      raw task id as the key -- that isolation is the point of the override.
 
     Fallback: when neither identifier is available the key is the explicit
     constant ``"default"``. This is only reachable for platform-internal
@@ -1170,10 +1196,23 @@ def environment_key(task_id: Optional[str] = None, session_id: Optional[str] = N
     """
     scope = os.getenv("TERMINAL_ISOLATION_SCOPE", "shared").strip().lower()
     identity = (session_id or task_id) if scope == "conversation" else task_id
+    if identity and _DERIVED_ENV_KEY_RE.match(identity):
+        return identity
+    authority_binding_id = None
+    for raw in (task_id, session_id):
+        if not raw or raw not in _task_env_overrides:
+            continue
+        overrides = _task_env_overrides[raw]
+        candidate = overrides.get("authority_binding_id")
+        if isinstance(candidate, str) and candidate.strip():
+            authority_binding_id = candidate
+            break
+    if authority_binding_id is not None:
+        authority_identity = "\x00".join((session_id or task_id or "", authority_binding_id))
+        digest = hashlib.sha256(authority_identity.encode("utf-8")).hexdigest()[:24]
+        return f"authority-{digest}"
     if not identity:
         return "default"
-    if _DERIVED_ENV_KEY_RE.match(identity):
-        return identity
     for raw in (task_id, session_id):
         if raw and raw in _task_env_overrides:
             if set(_task_env_overrides[raw].keys()) & _ISOLATION_OVERRIDE_KEYS:
