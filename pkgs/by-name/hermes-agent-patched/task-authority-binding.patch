+def _worklane_for_run(conn: Any, task_id: str, run_id: int) -> str:
+    specification = kb.get_task_worker_specification(
+        conn, task_id, run_id=int(run_id)
+    )
+    if specification is None:
+        raise RuntimeError("durable worker specification is missing")
+    worklane = specification.policy.get("worklane")
+    if not isinstance(worklane, str) or not worklane:
+        raise RuntimeError("worker specification has no broker worklane")
+    return worklane
+
