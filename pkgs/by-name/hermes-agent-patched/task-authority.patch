+def load_current_worker_specification(
+    *, required: bool = False,
+) -> Optional[WorkerSpecification]:
+    """Load and fence the immutable worker specification for this task-run.
+
+    Spawned workers receive only the pre-existing board/task/run/lease
+    identity. Behavior and authorization data remain in the durable run
+    record and are revalidated against the active task lease on every process
+    lookup.
+    """
+    identity = {
+        "board": os.environ.get("HERMES_KANBAN_BOARD"),
+        "task_id": os.environ.get("HERMES_KANBAN_TASK"),
+        "run_id": os.environ.get("HERMES_KANBAN_RUN_ID"),
+        "lease_id": os.environ.get("HERMES_KANBAN_CLAIM_LOCK"),
+    }
+    present = {name for name, value in identity.items() if value}
+    has_run_identity = bool(identity["run_id"] or identity["lease_id"])
+    if not has_run_identity:
+        if required:
+            raise WorkerResolutionError(
+                "worker_identity_missing", "task-run identity is not configured"
+            )
+        return None
+    if present != set(identity):
+        raise WorkerResolutionError(
+            "worker_identity_incomplete",
+            "board, task, run, and lease identity must be supplied together",
+        )
+    try:
+        run_id = int(identity["run_id"])
+    except (TypeError, ValueError) as exc:
+        raise WorkerResolutionError(
+            "worker_identity_invalid", "task-run id must be a positive integer"
+        ) from exc
+    if run_id < 1:
+        raise WorkerResolutionError(
+            "worker_identity_invalid", "task-run id must be a positive integer"
+        )
+
+    from hermes_cli import kanban_db as kb
+
+    board = kb._normalize_board_slug(identity["board"])
+    if not board:
+        raise WorkerResolutionError(
+            "worker_identity_invalid", "board identity is invalid"
+        )
+    with kb.connect(board=board) as conn:
+        task = kb.get_task(conn, identity["task_id"])
+        worker_spec = kb.get_task_worker_specification(
+            conn, identity["task_id"], run_id=run_id
+        )
+    if task is None or worker_spec is None:
+        raise WorkerResolutionError(
+            "worker_spec_missing", "durable task-run worker specification is missing"
+        )
+    if task.current_run_id != run_id or task.claim_lock != identity["lease_id"]:
+        raise WorkerResolutionError(
+            "worker_identity_stale", "task-run lease is no longer active"
+        )
+    if (
+        worker_spec.board != board
+        or worker_spec.task_id != identity["task_id"]
+        or worker_spec.run_id != run_id
+        or worker_spec.lease_id != identity["lease_id"]
+    ):
+        raise WorkerResolutionError(
+            "worker_spec_identity_mismatch",
+            "durable worker specification does not match the active task-run",
+        )
+    if worker_spec.workspace_generation < 1:
+        raise WorkerResolutionError(
+            "workspace_generation_stale", "worker workspace generation is stale"
+        )
+    return worker_spec
+
 
