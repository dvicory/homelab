+def _authority_for_run(conn: Any, task_id: str, run_id: int) -> dict[str, Any]:
+    specification = kb.get_task_worker_specification(
+        conn, task_id, run_id=int(run_id)
+    )
+    if specification is None:
+        raise RuntimeError("durable worker specification is missing")
+    worklane = specification.policy.get("worklane")
+    if not isinstance(worklane, str) or not worklane:
+        raise RuntimeError("worker specification has no broker worklane")
+    authority = {
+        "catalogueRevision": specification.catalogue_revision,
+        "lane": specification.lane,
+        "laneRevision": specification.lane_revision,
+        "permission": specification.permission,
+        "workspaceProvider": specification.provider,
+        "authorityClass": worklane,
+        "policyRevision": specification.policy_revision,
+    }
+    if specification.project is not None:
+        if (
+            specification.project_revision is None
+            or specification.source_generation is None
+        ):
+            raise RuntimeError("worker specification Project source is incomplete")
+        authority.update(
+            project=specification.project,
+            projectRevision=specification.project_revision,
+            sourceGeneration=specification.source_generation,
+        )
+    return authority
+
