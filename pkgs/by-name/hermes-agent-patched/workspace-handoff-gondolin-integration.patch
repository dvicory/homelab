+def _matching_completed_attachment(kb, conn, task_id: str, filename: str, data: bytes):
+    """Return a broker-produced attachment this upload would duplicate."""
+    task = kb.get_task(conn, task_id)
+    if task is None:
+        return None
+    candidates = [
+        attachment
+        for attachment in kb.list_attachments(conn, task_id)
+        if (attachment.uploaded_by or "") == "workspace_handoff"
+    ]
+    if not candidates:
+        return None
+    leaf = Path(filename).name
+    digest = None
+    for attachment in candidates:
+        if Path(attachment.filename).name == leaf:
+            return attachment
+        if attachment.size != len(data):
+            continue
+        if digest is None:
+            digest = hashlib.sha256(data).digest()
+        try:
+            with Path(attachment.stored_path).open("rb") as stored:
+                stored_digest = hashlib.file_digest(stored, "sha256").digest()
+        except OSError:
+            continue
+        if stored_digest == digest:
+            return attachment
+    return None
+
+
