@@ -1181,6 +1182,49 @@ _TOOL_MEDIA_RE = re.compile(
 )
 
 
+def _resolve_kanban_attachment_delivery(payload: Any) -> List[str]:
+    """Resolve an opaque delivery request inside the trusted gateway process."""
+    if not isinstance(payload, dict) or not payload.get("ok"):
+        return []
+    request = payload.get("attachment_delivery")
+    if not isinstance(request, dict):
+        return []
+    board = request.get("board")
+    task_id = request.get("task_id")
+    filenames = request.get("filenames")
+    if (
+        not isinstance(board, str)
+        or not isinstance(task_id, str)
+        or not isinstance(filenames, list)
+        or not filenames
+        or any(not isinstance(name, str) for name in filenames)
+    ):
+        return []
+    try:
+        from hermes_cli import kanban_db as kb
+
+        with kb.connect(board=board) as conn:
+            task = kb.get_task(conn, task_id)
+            if task is None or task.status != "done":
+                return []
+            by_name = {
+                attachment.filename: attachment
+                for attachment in kb.list_attachments(conn, task_id)
+            }
+            selected = [by_name.get(name) for name in filenames]
+            if any(attachment is None for attachment in selected):
+                return []
+            paths = [str(Path(attachment.stored_path)) for attachment in selected]
+            if not all(Path(path).is_file() for path in paths):
+                return []
+            return paths
+    except Exception:
+        logger.exception(
+            "Failed to resolve Kanban attachment delivery for task %s", task_id
+        )
+        return []
+
+
 def _collect_auto_append_media_tags(
     messages: List[Dict[str, Any]],
     history_offset: int = 0,
@@ -1233,6 +1277,19 @@ def _collect_auto_append_media_tags(
             continue
         content = str(msg.get("content") or "")
         tool_name = tool_name_by_call_id.get(call_id)
+        if tool_name == "kanban_attachments":
+            try:
+                payload = json.loads(content)
+            except Exception:
+                payload = None
+            # An explicit re-delivery request intentionally bypasses history
+            # dedup. The tool result contains only task metadata; host paths are
+            # resolved here and never exposed to the model.
+            media_tags.extend(
+                f"MEDIA:{path}"
+                for path in _resolve_kanban_attachment_delivery(payload)
+            )
+            continue
         # JSON-payload tools (image_generate) return a local-file path in a
