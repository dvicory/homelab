@@ -0,0 +1,314 @@
+"""Gondolin broker terminal backend (V3 secure-terminal).
+
+Talks to the profile's Gondolin broker over its mode-0600 Unix socket
+(``HERMES_GONDOLIN_SOCKET``). The broker owns VMs, policy, lifecycle, and
+resource governance; this backend is a thin, faithful client of the typed
+broker protocol — it never selects images, host paths, QEMU flags, network
+modes, or resource ceilings.
+
+Execution flow mirrors every other Hermes backend: ``_run_bash`` returns a
+ProcessHandle over a broker ``exec.start`` call, so the shared
+``BaseEnvironment.execute()`` (session snapshots, CWD tracking, interrupts,
+timeouts) works unchanged. File tools use the generic ShellFileOperations
+path; process registry spawns via ``env.execute``.
+"""
+
+import base64
+import json
+import logging
+import os
+import socket
+import struct
+import threading
+import uuid
+from typing import Any, Optional
+
+from tools.environments.base import BaseEnvironment, _ThreadedProcessHandle
+
+logger = logging.getLogger(__name__)
+
+_PROTOCOL_VERSION = 1
+_MAX_FRAME_BYTES = 16 * 1024 * 1024
+_DEFAULT_SOCKET = "/run/hermes-sandbox/broker.sock"
+
+
+class BrokerError(Exception):
+    """Broker-side failure with a stable machine-readable reason."""
+
+    def __init__(self, reason: str, message: str):
+        super().__init__(f"{reason}: {message}")
+        self.reason = reason
+
+
+class _BrokerConnection:
+    """One length-prefixed JSON connection to the broker."""
+
+    def __init__(self, socket_path: str, timeout: float = 30.0):
+        self._sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self._sock.settimeout(timeout)
+        self._sock.connect(socket_path)
+        self._buffer = b""
+        self._lock = threading.Lock()
+
+    def close(self) -> None:
+        try:
+            self._sock.close()
+        except OSError:
+            pass
+
+    def _read_frames(self):
+        """Generator of decoded frames until the connection closes."""
+        while True:
+            try:
+                chunk = self._sock.recv(65536)
+            except socket.timeout:
+                continue
+            except OSError:
+                return
+            if not chunk:
+                return
+            self._buffer += chunk
+            while len(self._buffer) >= 4:
+                (length,) = struct.unpack("<I", self._buffer[:4])
+                if length > _MAX_FRAME_BYTES:
+                    raise BrokerError("protocol.frame_too_large", f"broker frame {length} bytes")
+                if len(self._buffer) < 4 + length:
+                    break
+                body = self._buffer[4 : 4 + length]
+                self._buffer = self._buffer[4 + length :]
+                yield json.loads(body.decode("utf-8"))
+
+    def call(self, request_id: int, op: str, payload: dict):
+        """Send one request; yield (kind, frame) where kind is
+        'event' for stream frames and 'response' for the terminal frame."""
+        frame = {"v": _PROTOCOL_VERSION, "id": request_id, "op": op, "payload": payload}
+        body = json.dumps(frame).encode("utf-8")
+        with self._lock:
+            self._sock.sendall(struct.pack("<I", len(body)) + body)
+            for decoded in self._read_frames():
+                if decoded.get("id") != request_id:
+                    continue
+                if "event" in decoded:
+                    yield "event", decoded
+                    continue
+                yield "response", decoded
+                return
+
+
+class BrokerClient:
+    """Minimal typed client: one operation per connection (the broker
+    serves concurrent connections; this keeps the client trivially correct
+    under Hermes' threaded tool dispatch)."""
+
+    def __init__(self, socket_path: str, timeout: float = 30.0):
+        self._socket_path = socket_path
+        self._timeout = timeout
+        self._next_id = 1
+        self._id_lock = threading.Lock()
+
+    def _allocate_id(self) -> int:
+        with self._id_lock:
+            request_id = self._next_id
+            self._next_id += 1
+            return request_id
+
+    def call(self, op: str, payload: dict, timeout: float = None, on_event=None):
+        """Run one operation. Returns (events, result_payload).
+
+        ``on_event`` fires for each stream event as it arrives (needed for
+        exec.state, which carries the cancellable procId mid-run).
+
+        Raises BrokerError on broker denials and OSError on transport
+        failures so callers can distinguish policy answers from downtime.
+        """
+        request_id = self._allocate_id()
+        conn = _BrokerConnection(
+            self._socket_path, timeout=timeout if timeout is not None else self._timeout
+        )
+        events = []
+        try:
+            for kind, frame in conn.call(request_id, op, payload):
+                if kind == "event":
+                    events.append(frame)
+                    if on_event is not None:
+                        on_event(frame)
+                    continue
+                if not frame.get("ok", False):
+                    error = frame.get("error") or {}
+                    raise BrokerError(error.get("reason", "broker.error"), error.get("message", op))
+                return events, frame.get("result") or {}
+        finally:
+            conn.close()
+        raise BrokerError("protocol.bad_state", f"{op}: connection closed without a response")
+
+
+class GondolinEnvironment(BaseEnvironment):
+    """Hermes BaseEnvironment backed by the Gondolin broker.
+
+    ``task_id`` is the canonical environment key (already derived by
+    ``terminal_tool.environment_key``); the broker composes the effective
+    policy for it. Conversation isolation, network policy, and resource
+    limits are all broker-side.
+    """
+
+    # stdin rides the command heredoc (same as Modal/Daytona); the broker
+    # protocol's exec.stdin op exists for a future interactive path.
+    _stdin_mode = "heredoc"
+
+    @staticmethod
+    def _embed_stdin_heredoc(command: str, stdin_data: str) -> str:
+        """Brace-group the command so the heredoc feeds the script's stdin.
+
+        The base implementation appends ``<< DELIM`` to the whole command
+        string, which binds the heredoc to the LAST command of a
+        multi-command script. The atomic write pipeline ends in
+        ``trap - EXIT``, so the heredoc fed ``trap`` while ``cat`` read an
+        empty stdin and every write_file landed as a 0-byte file.
+        Redirecting a brace group instead delivers the data to whichever
+        command inside actually reads stdin.
+        """
+        delimiter = f"HERMES_STDIN_{uuid.uuid4().hex[:12]}"
+        return f"{{\n{command}\n}} << '{delimiter}'\n{stdin_data}\n{delimiter}"
+
+    def __init__(
+        self,
+        cwd: str = "/workspace",
+        timeout: int = 180,
+        env: dict = None,
+        task_id: str = None,
+        socket_path: str = None,
+    ):
+        super().__init__(cwd, timeout, env)
+        # Conversation-scoped and warm-by-design: the VM must survive
+        # between agent turns; terminal_tool's per-turn teardown only
+        # spares backends that report _persistent (same flag Docker sets).
+        # Session close still closes the broker environment (VM stops,
+        # workspace persists warm per broker retention).
+        self._persistent = True
+        self._socket_path = socket_path or os.environ.get(
+            "HERMES_GONDOLIN_SOCKET", _DEFAULT_SOCKET
+        )
+        self._env_key = task_id or "default"
+        self._client = BrokerClient(self._socket_path, timeout=30.0)
+        self.generation: Optional[str] = None
+        self._closed = False
+        self._ensure_environment()
+
+    def _ensure_environment(self) -> None:
+        _, result = self._client.call(
+            "ensure",
+            {
+                "envKey": self._env_key,
+            },
+            timeout=180.0,
+        )
+        self.generation = result.get("generation")
+        outcome = result.get("outcome")
+        reason = result.get("reason")
+        if outcome == "recreated":
+            # Surface retained/lost state in trusted model context (V3 §8.2):
+            # the environment was rebuilt, so in-VM process state and the
+            # disposable root were lost while the workspace persisted.
+            logger.warning(
+                "Gondolin environment %s recreated (reason=%s): prior VM state lost, workspace retained",
+                self._env_key,
+                reason,
+            )
+        else:
+            logger.info(
+                "Gondolin environment %s %s (generation=%s, build=%s)",
+                self._env_key,
+                outcome,
+                (self.generation or "")[:12],
+                (result.get("buildId") or "")[:12],
+            )
+
+    # ------------------------------------------------------------------
+    # BaseEnvironment contract
+    # ------------------------------------------------------------------
+
+    def _run_bash(
+        self,
+        cmd_string: str,
+        *,
+        login: bool = False,
+        timeout: int = 120,
+        stdin_data: Optional[str] = None,
+    ) -> _ThreadedProcessHandle:
+        if self._closed:
+            raise RuntimeError("Gondolin environment is closed")
+
+        proc_state: dict[str, Any] = {"proc_id": None}
+
+        def exec_fn():
+            events, result = self._client.call(
+                "exec.start",
+                {
+                    "envKey": self._env_key,
+                    "shell": cmd_string,
+                    "timeoutMs": int(timeout) * 1000,
+                },
+                timeout=max(float(timeout) + 30.0, 60.0),
+                on_event=lambda event: (
+                    proc_state.__setitem__("proc_id", event.get("procId"))
+                    if event.get("event") == "exec.state"
+                    else None
+                ),
+            )
+
+            ordered = sorted(
+                (e for e in events if e.get("event") == "exec.output"),
+                key=lambda e: e.get("seq", 0),
+            )
+            # Streams are ordered per stream; merge in protocol order for the
+            # combined-output contract (stdout frames first is fine — Hermes
+            # merges stderr into output for remote backends).
+            stdout_parts = []
+            stderr_parts = []
+            for event in ordered:
+                data = base64.b64decode(event.get("data", ""))
+                text = data.decode("utf-8", errors="replace")
+                if event.get("stream") == "stderr":
+                    stderr_parts.append(text)
+                else:
+                    stdout_parts.append(text)
+            output = "".join(stdout_parts) + "".join(stderr_parts)
+            exit_code = result.get("exitCode")
+            if exit_code is None:
+                reason = result.get("reason") or "unknown"
+                if reason == "timeout":
+                    raise TimeoutError(f"command timed out after {timeout}s")
+                exit_code = 1
+            return output, int(exit_code)
+
+        def cancel_fn():
+            proc_id = proc_state.get("proc_id")
+            if proc_id:
+                try:
+                    self._client.call("exec.cancel", {"procId": proc_id}, timeout=10.0)
+                except Exception as exc:  # noqa: BLE001 - best-effort cancel
+                    logger.debug("exec.cancel failed for %s: %s", proc_id, exc)
+
+        return _ThreadedProcessHandle(exec_fn, cancel_fn)
+
+    def cleanup(self):
+        """Close the environment (VM stops; the workspace persists warm)."""
+        if self._closed:
+            return
+        self._closed = True
+        try:
+            self._client.call("close", {"envKey": self._env_key}, timeout=30.0)
+        except Exception as exc:  # noqa: BLE001 - cleanup must not raise
+            logger.debug("Gondolin close for %s failed: %s", self._env_key, exc)
+
+
+def check_gondolin_available(socket_path: str = None) -> bool:
+    """Health check for tool registration: the broker socket answers."""
+    path = socket_path or os.environ.get("HERMES_GONDOLIN_SOCKET", _DEFAULT_SOCKET)
+    try:
+        client = BrokerClient(path, timeout=5.0)
+        client.call("status", {})
+        return True
+    except Exception as exc:  # noqa: BLE001 - a health probe never raises
+        logger.error("Gondolin broker unavailable at %s: %s", path, exc)
+        return False
