@@ -0,0 +1,246 @@
+"""Tests for the Gondolin broker terminal backend.
+
+A fake broker implements the wire protocol (length-prefixed JSON over
+AF_UNIX) so the real GondolinEnvironment + BrokerClient code paths run
+end to end: ensure, exec.start with exec.state/output/exit frames,
+cancel, close, and error mapping.
+"""
+
+import json
+import os
+import socket
+import struct
+import tempfile
+import threading
+
+from tools.environments.gondolin import (
+    BrokerClient,
+    BrokerError,
+    GondolinEnvironment,
+    check_gondolin_available,
+)
+
+
+class FakeBroker:
+    """Scriptable in-process broker for tests."""
+
+    def __init__(self, socket_path):
+        self.socket_path = socket_path
+        self.calls = []
+        self.exec_responders = []
+        self._server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self._server.bind(socket_path)
+        self._server.listen(4)
+        self._thread = threading.Thread(target=self._serve, daemon=True)
+        self._thread.start()
+
+    def _serve(self):
+        while True:
+            try:
+                conn, _ = self._server.accept()
+            except OSError:
+                return
+            threading.Thread(target=self._handle, args=(conn,), daemon=True).start()
+
+    def _read_frame(self, conn):
+        buffer = b""
+        while len(buffer) < 4:
+            chunk = conn.recv(4096)
+            if not chunk:
+                return None
+            buffer += chunk
+        (length,) = struct.unpack("<I", buffer[:4])
+        body = buffer[4:]
+        while len(body) < length:
+            chunk = conn.recv(4096)
+            if not chunk:
+                return None
+            body += chunk
+        return json.loads(body.decode())
+
+    def _send(self, conn, frame):
+        body = json.dumps(frame).encode()
+        conn.sendall(struct.pack("<I", len(body)) + body)
+
+    def _handle(self, conn):
+        try:
+            request = self._read_frame(conn)
+            if request is None:
+                return
+            self.calls.append((request["op"], request["payload"]))
+            op = request["op"]
+            rid = request["id"]
+
+            if op == "ensure":
+                self._send(conn, {
+                    "v": 1, "id": rid, "ok": True,
+                    "result": {
+                        "outcome": self.ensure_outcome,
+                        "generation": "gen-1",
+                        "reason": "new_environment",
+                        "buildId": "build-1",
+                    },
+                })
+            elif op == "exec.start":
+                self._send(conn, {"v": 1, "id": rid, "event": "exec.state", "procId": "p-1"})
+                for stream, text in self.exec_responders:
+                    self._send(conn, {
+                        "v": 1, "id": rid, "event": "exec.output",
+                        "stream": stream, "seq": 1,
+                        "data": __import__("base64").b64encode(text.encode()).decode(),
+                    })
+                self._send(conn, {"v": 1, "id": rid, "event": "exec.exit", "exitCode": self.exec_exit_code})
+                self._send(conn, {
+                    "v": 1, "id": rid, "ok": True,
+                    "result": {"procId": "p-1", "exitCode": self.exec_exit_code, "signal": None,
+                               "reason": None, "truncated": False},
+                })
+            elif op == "exec.cancel":
+                self._send(conn, {"v": 1, "id": rid, "ok": True,
+                                  "result": {"procId": "p-1", "reason": "cancelled"}})
+            elif op == "close":
+                self._send(conn, {"v": 1, "id": rid, "ok": True,
+                                  "result": {"generation": "gen-1", "state": "warm"}})
+            elif op == "status":
+                self._send(conn, {"v": 1, "id": rid, "ok": True, "result": {"environments": []}})
+            else:
+                self._send(conn, {"v": 1, "id": rid, "ok": False,
+                                  "error": {"reason": "protocol.unknown_operation", "message": op}})
+        finally:
+            conn.close()
+
+    ensure_outcome = "created"
+    exec_exit_code = 0
+
+    def close(self):
+        try:
+            self._server.close()
+        finally:
+            try:
+                os.unlink(self.socket_path)
+            except OSError:
+                pass
+
+
+def short_sock():
+    # AF_UNIX path limit (104 on macOS) — keep sockets in a flat /tmp dir.
+    return os.path.join(tempfile.mkdtemp(prefix="gb-"), "b.sock")
+
+
+def make_env(tmp_path, monkeypatch=None):
+    broker = FakeBroker(short_sock())
+    env = GondolinEnvironment(
+        cwd="/workspace", timeout=30, task_id="conversation-test", socket_path=broker.socket_path
+    )
+    return broker, env
+
+
+def test_ensure_on_init_stores_generation(tmp_path):
+    broker, env = make_env(tmp_path)
+    assert env.generation == "gen-1"
+    assert broker.calls[0][0] == "ensure"
+    assert broker.calls[0][1]["envKey"] == "conversation-test"
+
+
+def test_env_is_persistent_across_turns(tmp_path):
+    """terminal_tool's per-turn teardown spares only _persistent backends;
+    without the flag every agent turn closed the broker environment,
+    producing state_warm recreation churn (and a fresh /tmp) per call."""
+    _broker, env = make_env(tmp_path)
+    assert env._persistent is True
+
+
+def test_run_bash_streams_output_and_exit_code(tmp_path):
+    broker, env = make_env(tmp_path)
+    broker.exec_responders = [("stdout", "hello "), ("stdout", "world\n"), ("stderr", "oops\n")]
+    broker.exec_exit_code = 7
+
+    proc = env._run_bash("echo hello", timeout=30)
+    result = env._wait_for_process(proc, timeout=30)
+
+    assert result["returncode"] == 7
+    assert "hello world" in result["output"]
+    assert "oops" in result["output"]
+    op, payload = broker.calls[1]
+    assert op == "exec.start"
+    assert payload["shell"] == "echo hello"
+    assert payload["envKey"] == "conversation-test"
+
+
+def test_execute_end_to_end_with_cwd_markers(tmp_path):
+    broker, env = make_env(tmp_path)
+    broker.exec_responders = [("stdout", "/workspace\nmarker-output\n")]
+    broker.exec_exit_code = 0
+
+    result = env.execute("pwd", cwd="/workspace", timeout=30)
+    assert result["returncode"] == 0
+    assert "marker-output" in result["output"]
+
+
+def test_kill_cancels_via_proc_id(tmp_path):
+    broker, env = make_env(tmp_path)
+    broker.exec_responders = []
+    broker.exec_exit_code = 0
+
+    proc = env._run_bash("sleep 100", timeout=30)
+    # Give exec.state a moment to land, then kill; exec_fn completes with 0.
+    proc.wait(timeout=30)
+    proc.kill()
+    cancel_calls = [c for c in broker.calls if c[0] == "exec.cancel"]
+    assert cancel_calls == [("exec.cancel", {"procId": "p-1"})]
+
+
+def test_cleanup_closes_environment(tmp_path):
+    broker, env = make_env(tmp_path)
+    env.cleanup()
+    assert ("close", {"envKey": "conversation-test"}) in broker.calls
+    assert env._closed
+
+
+def test_broker_denial_raises_broker_error(tmp_path):
+    broker = FakeBroker(short_sock())
+    client = BrokerClient(broker.socket_path, timeout=5.0)
+    try:
+        client.call("policy.set", {})
+    except BrokerError as err:
+        assert err.reason == "protocol.unknown_operation"
+    else:
+        raise AssertionError("expected BrokerError")
+
+
+def test_health_check(tmp_path):
+    broker = FakeBroker(short_sock())
+    assert check_gondolin_available(broker.socket_path)
+    assert not check_gondolin_available(str(tmp_path / "missing.sock"))
+
+
+def test_embed_stdin_heredoc_groups_command():
+    wrapped = GondolinEnvironment._embed_stdin_heredoc("a; b; c", "payload")
+    head, _, tail = wrapped.partition("\n")
+    assert head == "{"
+    delimiter = wrapped.split("'")[1]
+    assert delimiter.startswith("HERMES_STDIN_")
+    assert wrapped.rstrip().endswith(f"payload\n{delimiter}")
+    assert tail.startswith(f"a; b; c\n}} << '{delimiter}'")
+
+
+def test_stdin_heredoc_feeds_multi_command_scripts(tmp_path):
+    """Regression: write_file landed 0-byte files because the appended
+    heredoc bound to the pipeline's trailing ``trap - EXIT`` instead of
+    feeding ``cat``. The grouped form must deliver stdin to the reader."""
+    import subprocess
+
+    target = tmp_path / "out.txt"
+    script = (
+        "set -e; "
+        f"d={tmp_path}; t={target}; "
+        'tmp="$(mktemp -p "$d" .hermes-tmp.XXXXXX)"; '
+        "trap 'rm -f \"$tmp\"' EXIT; "
+        'cat > "$tmp"; '
+        'mv -f "$tmp" "$t"; '
+        "trap - EXIT"
+    )
+    wrapped = GondolinEnvironment._embed_stdin_heredoc(script, "hello Daniel")
+    result = subprocess.run(["/bin/sh", "-c", wrapped], capture_output=True, text=True)
+    assert result.returncode == 0, result.stderr
+    assert target.read_text() == "hello Daniel\n"
