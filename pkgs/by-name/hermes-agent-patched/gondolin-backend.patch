@@ -0,0 +1,545 @@
+"""Gondolin Effect broker terminal backend.
+
+Uses ordinary HTTP/1.1 over the profile's mode-0600 Unix socket. Hermes supplies
+only the canonical environment key and commands; the broker owns VM assets,
+policy, lifecycle, filesystem mediation, and resource ceilings.
+"""
+
+import base64
+import json
+import logging
+import os
+import socket
+import threading
+import uuid
+from typing import Any, Optional
+
+import httpx
+
+from tools.environments.base import BaseEnvironment, _ThreadedProcessHandle
+
+logger = logging.getLogger(__name__)
+
+_DEFAULT_SOCKET = "/run/hermes-sandbox/broker.sock"
+_BASE_URL = "http://localhost"
+
+
+def broker_task_identity(board: str, task_id: str) -> str:
+    """Encode a board/task pair without collisions in the shared broker."""
+    board_text = str(board)
+    task_text = str(task_id)
+    if not board_text or not task_text:
+        raise ValueError("broker board and task id must be non-empty")
+    return f"b{len(board_text)}:{board_text}:t{len(task_text)}:{task_text}"
+
+
+def broker_run_identity(board: str, task_id: str, run_id: int) -> str:
+    """Encode one board-scoped Hermes run for broker-global indexes."""
+    return f"{broker_task_identity(board, task_id)}:r{int(run_id)}"
+
+
+def broker_task_run(board: str, task_id: str, run_id: int) -> dict[str, str]:
+    """Return the broker ``taskRun`` envelope shared by control and exec APIs."""
+    return {
+        "taskId": broker_task_identity(board, task_id),
+        "runId": broker_run_identity(board, task_id, run_id),
+    }
+
+
+class BrokerError(Exception):
+    """Broker-side failure with a stable machine-readable reason."""
+
+    def __init__(self, reason: str, message: str, status: int | None = None):
+        super().__init__(f"{reason}: {message}")
+        self.reason = reason
+        self.status = status
+
+
+class BrokerClient:
+    """Thread-safe HTTPX client for HTTP/1.1 over one Unix socket."""
+
+    def __init__(self, socket_path: str, timeout: float = 30.0):
+        self._socket_path = socket_path
+        self._timeout = timeout
+        self._client = httpx.Client(
+            transport=httpx.HTTPTransport(uds=socket_path),
+            base_url=_BASE_URL,
+            timeout=httpx.Timeout(timeout),
+            headers={"accept": "application/json"},
+        )
+
+    def close(self) -> None:
+        self._client.close()
+
+    @staticmethod
+    def _raise_for_status(response: httpx.Response) -> None:
+        if 200 <= response.status_code < 300:
+            return
+        try:
+            problem = response.json()
+        except (json.JSONDecodeError, UnicodeDecodeError):
+            problem = {}
+        reason = problem.get("reason", "broker.http_error")
+        detail = problem.get("detail", f"broker returned HTTP {response.status_code}")
+        raise BrokerError(str(reason), str(detail), response.status_code)
+    @staticmethod
+    def _trusted_environment_key() -> str:
+        return os.environ.get("HERMES_BROKER_ENVIRONMENT_KEY", "").strip()
+
+    @classmethod
+    def _task_run_payload(cls) -> dict[str, str] | None:
+        """Build the trusted worker task/run envelope, if this is a worker."""
+        if not cls._trusted_environment_key():
+            return None
+        board = os.environ.get("HERMES_KANBAN_BOARD", "")
+        task_id = os.environ.get("HERMES_KANBAN_TASK", "")
+        run_text = os.environ.get("HERMES_KANBAN_RUN_ID", "")
+        if not board or not task_id or not run_text:
+            raise BrokerError(
+                "workspace.identity_missing",
+                "broker worker task/run identity is incomplete",
+            )
+        try:
+            run_id = int(run_text)
+        except (TypeError, ValueError) as exc:
+            raise BrokerError(
+                "workspace.identity_invalid",
+                "broker worker run id is not an integer",
+            ) from exc
+        if run_id < 0:
+            raise BrokerError(
+                "workspace.identity_invalid",
+                "broker worker run id must be non-negative",
+            )
+        return broker_task_run(board, task_id, run_id)
+
+    @classmethod
+    def _execution_payload(cls, environment_key: str, payload: dict) -> dict:
+        """Attach trusted taskRun metadata to every execution-plane request."""
+        trusted_key = cls._trusted_environment_key()
+        if trusted_key and str(environment_key) != trusted_key:
+            raise BrokerError(
+                "workspace.identity_mismatch",
+                "request environment key is not the trusted worker key",
+            )
+        body = dict(payload)
+        task_run = cls._task_run_payload()
+        if task_run is not None:
+            body["taskRun"] = task_run
+        return body
+
+
+    def health(self) -> bool:
+        response = self._client.get("/v1/health", timeout=self._timeout)
+        self._raise_for_status(response)
+        body = response.json()
+        return body.get("status") == "ok"
+
+    def ensure(self, environment_key: str, timeout: float = 180.0) -> dict:
+        body = self._execution_payload(
+            environment_key,
+            {"environmentKey": environment_key},
+        )
+        response = self._client.post(
+            "/v1/environments/ensure",
+            json=body,
+            timeout=timeout,
+        )
+        self._raise_for_status(response)
+        return response.json()
+
+    @staticmethod
+    def _file_result(response: httpx.Response) -> tuple[bytes, int]:
+        body = response.json()
+        data_base64 = body.get("dataBase64")
+        size = body.get("size")
+        if not isinstance(data_base64, str) or not isinstance(size, int) or size < 0:
+            raise BrokerError("protocol.invalid_response", "invalid broker file response")
+        try:
+            data = base64.b64decode(data_base64, validate=True)
+        except (ValueError, TypeError) as exc:
+            raise BrokerError("protocol.invalid_response", "invalid broker file base64") from exc
+        if len(data) != size:
+            raise BrokerError("protocol.invalid_response", "broker file size mismatch")
+        return data, size
+
+    def read_file(
+        self,
+        environment_key: str,
+        generation: int,
+        path: str,
+        max_bytes: int = 64 * 1024 * 1024,
+    ) -> bytes:
+        response = self._client.post(
+            "/v1/files/read",
+            json=self._execution_payload(
+                environment_key,
+                {
+                    "environmentKey": environment_key,
+                    "generation": generation,
+                    "path": path,
+                    "maxBytes": max_bytes,
+                },
+            ),
+            timeout=self._timeout,
+        )
+        self._raise_for_status(response)
+        data, _size = self._file_result(response)
+        return data
+
+    def write_file(self, environment_key: str, generation: int, path: str, data: bytes) -> int:
+        response = self._client.post(
+            "/v1/files/write",
+            json=self._execution_payload(
+                environment_key,
+                {
+                    "environmentKey": environment_key,
+                    "generation": generation,
+                    "path": path,
+                    "dataBase64": base64.b64encode(data).decode("ascii"),
+                    "create": True,
+                    "truncate": True,
+                },
+            ),
+            timeout=self._timeout,
+        )
+
+        self._raise_for_status(response)
+        body = response.json()
+        size = body.get("size")
+        if not isinstance(size, int) or size < 0 or size != len(data):
+            raise BrokerError("protocol.invalid_response", "invalid broker write response")
+        return size
+
+    def close_environment(self, environment_key: str, generation: int) -> dict:
+        response = self._client.post(
+            "/v1/environments/close",
+            json=self._execution_payload(
+                environment_key,
+                {"environmentKey": environment_key, "generation": generation},
+            ),
+            timeout=self._timeout,
+        )
+        self._raise_for_status(response)
+        try:
+            body = response.json()
+        except (ValueError, UnicodeDecodeError) as exc:
+            raise BrokerError("protocol.invalid_response", "invalid broker close response") from exc
+        if not isinstance(body, dict) or body.get("closed") is not True:
+            raise BrokerError("protocol.invalid_response", "broker close was not acknowledged")
+        return body
+
+    def execute(
+        self,
+        payload: dict,
+        *,
+        timeout: float,
+        on_open=None,
+        on_output=None,
+    ) -> tuple[list[dict], dict]:
+        events: list[dict] = []
+        request_timeout = httpx.Timeout(max(timeout, 30.0), read=None)
+        with self._client.stream(
+            "POST",
+            "/v1/exec",
+            json=self._execution_payload(
+                str(payload.get("environmentKey", "")),
+                payload,
+            ),
+            timeout=request_timeout,
+            headers={"accept": "application/x-ndjson"},
+        ) as response:
+            self._raise_for_status(response)
+            if on_open is not None:
+                on_open(response)
+            for line in response.iter_lines():
+                if not line:
+                    continue
+                try:
+                    event = json.loads(line)
+                except json.JSONDecodeError as exc:
+                    raise BrokerError("protocol.invalid_json", "invalid NDJSON event") from exc
+                if event.get("type") == "error":
+                    reason = str(event.get("reason", "broker.stream_error"))
+                    message = str(event.get("message", "execution failed"))
+                    raise BrokerError(reason, message)
+                if event.get("type") == "output":
+                    try:
+                        data = base64.b64decode(event.get("dataBase64", ""))
+                    except (ValueError, TypeError) as exc:
+                        raise BrokerError("protocol.invalid_output", "invalid broker output base64") from exc
+                    if on_output is not None:
+                        on_output(data.decode("utf-8", errors="replace"))
+                events.append(event)
+        exits = [event for event in events if event.get("type") == "exit"]
+        if len(exits) != 1:
+            raise BrokerError("protocol.incomplete_stream", "execution stream has no terminal exit event")
+        return events, exits[0]
+
+
+class GondolinEnvironment(BaseEnvironment):
+    """Hermes environment backed by the Gondolin Effect broker."""
+
+    # The broker's exec stream is unidirectional; it has no process stdin
+    # endpoint. Foreground commands may still use the existing heredoc path,
+    # but the background-process API must not promise interactive writes.
+    supports_process_stdin = False
+    _stdin_mode = "heredoc"
+
+    @staticmethod
+    def _embed_stdin_heredoc(command: str, stdin_data: str) -> str:
+        delimiter = f"HERMES_STDIN_{uuid.uuid4().hex[:12]}"
+        return f"{{\n{command}\n}} << '{delimiter}'\n{stdin_data}\n{delimiter}"
+
+    def __init__(
+        self,
+        cwd: str = "/workspace",
+        timeout: int = 180,
+        env: dict = None,
+        task_id: str = None,
+        socket_path: str = None,
+    ):
+        super().__init__(cwd, timeout, env)
+        self._persistent = True
+        self._socket_path = socket_path or os.environ.get(
+            "HERMES_GONDOLIN_SOCKET", _DEFAULT_SOCKET
+        )
+        self._env_key = (
+            os.environ.get("HERMES_BROKER_ENVIRONMENT_KEY", "").strip()
+            or task_id
+            or "default"
+        )
+        self._client = BrokerClient(self._socket_path, timeout=30.0)
+        self.generation: Optional[int] = None
+        self._closed = False
+        self._state_loss_notice: Optional[str] = None
+        self._ensure_environment()
+
+    def _ensure_environment(self) -> None:
+        previous_generation = self.generation
+        result = self._client.ensure(self._env_key)
+        generation = result.get("generation")
+        if not isinstance(generation, int):
+            raise BrokerError("protocol.invalid_response", "ensure response has no integer generation")
+        self.generation = generation
+        state = result.get("state")
+        if previous_generation is not None and generation != previous_generation:
+            logger.warning(
+                "Gondolin environment %s recreated: generation %s -> %s",
+                self._env_key,
+                previous_generation,
+                generation,
+            )
+            self._state_loss_notice = (
+                "[sandbox notice] The sandbox VM was recreated since the last "
+                "command. Ephemeral state was lost: files outside /workspace "
+                "(e.g. /tmp), running processes, and shell state. /workspace "
+                "contents persist.\n"
+            )
+        else:
+            logger.info(
+                "Gondolin environment %s %s (generation=%s)",
+                self._env_key,
+                state,
+                generation,
+            )
+
+    def read_file_bytes(self, path: str, max_bytes: int = 64 * 1024 * 1024) -> bytes:
+        self._ensure_environment()
+        if self.generation is None:
+            raise BrokerError("protocol.invalid_response", "environment has no generation")
+        return self._client.read_file(self._env_key, self.generation, path, max_bytes)
+
+    def write_file_bytes(self, path: str, data: bytes) -> int:
+        self._ensure_environment()
+        if self.generation is None:
+            raise BrokerError("protocol.invalid_response", "environment has no generation")
+        return self._client.write_file(self._env_key, self.generation, path, data)
+
+    def execute(self, command: str, cwd: str = "", **kwargs) -> dict:
+        result = super().execute(command, cwd, **kwargs)
+        if self._state_loss_notice:
+            notice, self._state_loss_notice = self._state_loss_notice, None
+            result["output"] = notice + result.get("output", "")
+        return result
+
+    def _run_bash(
+        self,
+        cmd_string: str,
+        *,
+        login: bool = False,
+        timeout: int = 120,
+        stdin_data: Optional[str] = None,
+    ) -> _ThreadedProcessHandle:
+        if self._closed:
+            raise RuntimeError("Gondolin environment is closed")
+
+        # Re-ensure before every command. This is cheap for a live generation
+        # and recovers cleanly after broker restart or disconnect cancellation.
+        self._ensure_environment()
+        execution_environment_key = self._env_key
+        execution_generation = self.generation
+        if execution_generation is None:
+            raise BrokerError("protocol.invalid_response", "environment has no generation")
+
+        state: dict[str, Any] = {"response": None}
+        state_lock = threading.Lock()
+        cancel_lock = threading.Lock()
+        cancel_requested = threading.Event()
+        cancel_acknowledged = threading.Event()
+        cancel_error: list[Exception | None] = [None]
+
+        stream_lock = threading.Lock()
+        stream_handle: dict[str, _ThreadedProcessHandle | None] = {"handle": None}
+        cancel_handle: dict[str, _ThreadedProcessHandle | None] = {"handle": None}
+        pending_chunks: list[str] = []
+
+        def on_open(response: httpx.Response) -> None:
+            with state_lock:
+                state["response"] = response
+
+        def on_output(chunk: str) -> None:
+            # The worker can receive the first broker frame before the handle
+            # constructor returns. Buffer only that tiny hand-off window; all
+            # subsequent frames go directly to the process drain pipe.
+            with stream_lock:
+                handle = stream_handle["handle"]
+                if handle is None:
+                    pending_chunks.append(chunk)
+                    return
+            handle.write_output(chunk)
+
+        def exec_fn():
+            if cancel_acknowledged.is_set():
+                return "", 130
+            try:
+                _events, result = self._client.execute(
+                    {
+                        "environmentKey": execution_environment_key,
+                        "generation": execution_generation,
+                        "argv": ["/bin/sh", "-lc" if login else "-c", cmd_string],
+                        "timeoutMs": int(timeout) * 1000,
+                    },
+                    timeout=max(float(timeout) + 30.0, 60.0),
+                    on_open=on_open,
+                    on_output=on_output,
+                )
+            except BrokerError as exc:
+                # Broker stream errors are terminal command results, not
+                # transport failures. Return their formatted diagnostic
+                # through the process handle so an immediate error cannot be
+                # lost before _ThreadedProcessHandle is published.
+                return f"[broker error] {exc}\n", 1
+            except Exception:
+                # Once the broker has acknowledged the exact-generation close,
+                # transport teardown is expected to make the stream fail.
+                if cancel_acknowledged.is_set():
+                    return "", 130
+                raise
+
+            if cancel_acknowledged.is_set():
+                return "", 130
+            exit_code = result.get("exitCode")
+            if exit_code is None:
+                exit_code = 128 if result.get("signal") is not None else 1
+            # Output was delivered frame-by-frame above; returning it again
+            # would duplicate the process log at completion.
+            return "", int(exit_code)
+
+        def close_exec_stream() -> None:
+            with state_lock:
+                response = state.get("response")
+            if response is None:
+                return
+            # Wake the worker only after the broker has acknowledged the VM
+            # close. Socket shutdown is transport cleanup, not cancellation
+            # proof, and is therefore best-effort cleanup after the ack.
+            try:
+                network_stream = response.extensions.get("network_stream")
+                sock = getattr(network_stream, "_sock", None)
+                if sock is not None:
+                    sock.shutdown(socket.SHUT_RDWR)
+                    sock.close()
+            except (AttributeError, OSError):
+                pass
+            try:
+                response.close()
+            except Exception:  # noqa: BLE001 - transport cleanup is best-effort
+                logger.debug("Gondolin exec stream close failed", exc_info=True)
+
+        def cancel_fn():
+            # Serialize repeated/concurrent kills. A failed close is retained
+            # and re-raised so callers cannot mistake it for a successful
+            # cancellation.
+            with cancel_lock:
+                if cancel_acknowledged.is_set():
+                    return
+                if cancel_error[0] is not None:
+                    raise cancel_error[0]
+                cancel_requested.set()
+                cancel_client = None
+                try:
+                    # The exec stream is only a subscription. The broker's
+                    # acknowledged environment close is the VM/process
+                    # hard-cancel boundary; there is no per-exec cancel route.
+                    cancel_client = BrokerClient(self._socket_path, timeout=30.0)
+                    cancel_client.close_environment(
+                        execution_environment_key,
+                        execution_generation,
+                    )
+                except Exception as exc:  # noqa: BLE001 - surface to caller
+                    cancel_error[0] = exc
+                    raise
+                finally:
+                    if cancel_client is not None:
+                        try:
+                            cancel_client.close()
+                        except Exception:  # noqa: BLE001 - local cleanup only
+                            logger.debug("Gondolin cancel client close failed", exc_info=True)
+
+                # Publish local cancellation only after close_environment
+                # returned a successful status and {"closed": true} ack.
+                cancel_acknowledged.set()
+                close_exec_stream()
+                handle = cancel_handle["handle"]
+                if handle is not None:
+                    mark_cancelled = getattr(handle, "mark_cancelled", None)
+                    if mark_cancelled is not None:
+                        mark_cancelled()
+
+        handle = _ThreadedProcessHandle(exec_fn, cancel_fn)
+        cancel_handle["handle"] = handle
+        with stream_lock:
+            stream_handle["handle"] = handle
+            pending = pending_chunks[:]
+            pending_chunks.clear()
+        for chunk in pending:
+            handle.write_output(chunk)
+        return handle
+
+    def cleanup(self):
+        if self._closed:
+            return
+        self._closed = True
+        try:
+            if self.generation is not None:
+                self._client.close_environment(self._env_key, self.generation)
+        except Exception as exc:  # noqa: BLE001 - cleanup must not raise
+            logger.debug("Gondolin close for %s failed: %s", self._env_key, exc)
+        finally:
+            self._client.close()
+
+
+def check_gondolin_available(socket_path: str = None) -> bool:
+    """Health check for tool registration: the broker answers HTTP over UDS."""
+    path = socket_path or os.environ.get("HERMES_GONDOLIN_SOCKET", _DEFAULT_SOCKET)
+    client = None
+    try:
+        client = BrokerClient(path, timeout=5.0)
+        return client.health()
+    except Exception as exc:  # noqa: BLE001 - a health probe never raises
+        logger.error("Gondolin broker unavailable at %s: %s", path, exc)
+        return False
+    finally:
+        if client is not None:
+            client.close()
