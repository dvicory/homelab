+++ b/tests/tools/test_gondolin_backend.py
@@ -0,0 +1,267 @@
+"""Contract tests for Hermes HTTP/1.1 over Unix-socket Gondolin client."""
+
+import base64
+import json
+import os
+import socketserver
+import subprocess
+import tempfile
+import threading
+import time
+from http.server import BaseHTTPRequestHandler
+
+from tools.environments.gondolin import (
+    BrokerError,
+    GondolinEnvironment,
+    check_gondolin_available,
+)
+
+
+class _UnixHttpServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
+    daemon_threads = True
+
+
+class _Handler(BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+
+    def log_message(self, _format, *args):
+        return
+
+    @property
+    def broker(self):
+        return self.server.broker
+
+    def _request_json(self):
+        size = int(self.headers.get("content-length", "0"))
+        return json.loads(self.rfile.read(size))
+
+    def _json(self, status, body, content_type="application/json"):
+        payload = json.dumps(body).encode()
+        self.send_response(status)
+        self.send_header("content-type", content_type)
+        self.send_header("content-length", str(len(payload)))
+        self.end_headers()
+        self.wfile.write(payload)
+
+    def do_GET(self):
+        self.broker.calls.append((self.path, None))
+        if self.path == "/v1/health":
+            self._json(200, {"status": "ok"})
+        else:
+            self._json(404, {"reason": "request.invalid", "detail": "not found"}, "application/problem+json")
+
+    def do_POST(self):
+        request = self._request_json()
+        self.broker.calls.append((self.path, request))
+        if self.path == "/v1/environments/ensure":
+            if self.broker.ensure_denied:
+                self._json(
+                    403,
+                    {
+                        "type": "urn:agent-x:gondolin-broker:error:policy.denied",
+                        "title": "policy.denied",
+                        "status": 403,
+                        "detail": "policy denied ensure",
+                        "reason": "policy.denied",
+                    },
+                    "application/problem+json",
+                )
+                return
+            state = self.broker.ensure_state
+            self.broker.ensure_state = "reused"
+            self._json(200, {
+                "environmentKey": request["environmentKey"],
+                "generation": self.broker.generation,
+                "state": state,
+                "worklane": "default",
+                "policyGeneration": 1,
+                "decisionDigest": "digest",
+            })
+        elif self.path == "/v1/environments/close":
+            self._json(200, {"closed": True})
+        elif self.path == "/v1/exec":
+            self.send_response(200)
+            self.send_header("content-type", "application/x-ndjson")
+            self.send_header("connection", "close")
+            self.end_headers()
+            self.close_connection = True
+            self._event({
+                "type": "start",
+                "environmentKey": request["environmentKey"],
+                "generation": request["generation"],
+                "decisionDigest": "digest",
+                "timeoutMs": request["timeoutMs"],
+                "outputLimitBytes": 4096,
+            })
+            self.broker.exec_started.set()
+            if self.broker.hang_exec:
+                while True:
+                    try:
+                        self.wfile.write(b"\n")
+                        self.wfile.flush()
+                    except (BrokenPipeError, ConnectionResetError):
+                        self.broker.disconnected.set()
+                        return
+                    time.sleep(0.01)
+            for stream, text in self.broker.exec_responders:
+                self._event({
+                    "type": "output",
+                    "sequence": self.broker.sequence,
+                    "stream": stream,
+                    "dataBase64": base64.b64encode(text.encode()).decode(),
+                })
+                self.broker.sequence += 1
+            self._event({"type": "exit", "exitCode": self.broker.exec_exit_code, "signal": None})
+        else:
+            self._json(404, {"reason": "request.invalid", "detail": "not found"}, "application/problem+json")
+
+    def _event(self, event):
+        self.wfile.write(json.dumps(event).encode() + b"\n")
+        self.wfile.flush()
+
+
+class FakeBroker:
+    def __init__(self, socket_path):
+        self.socket_path = socket_path
+        self.calls = []
+        self.exec_responders = []
+        self.exec_exit_code = 0
+        self.ensure_state = "created"
+        self.ensure_denied = False
+        self.generation = 1
+        self.sequence = 0
+        self.hang_exec = False
+        self.exec_started = threading.Event()
+        self.disconnected = threading.Event()
+        self._server = _UnixHttpServer(socket_path, _Handler)
+        self._server.broker = self
+        self._thread = threading.Thread(target=self._server.serve_forever, daemon=True)
+        self._thread.start()
+
+    def close(self):
+        self._server.shutdown()
+        self._server.server_close()
+        try:
+            os.unlink(self.socket_path)
+        except OSError:
+            pass
+
+
+def short_sock():
+    return os.path.join(tempfile.mkdtemp(prefix="gb-"), "b.sock")
+
+
+def make_env():
+    broker = FakeBroker(short_sock())
+    env = GondolinEnvironment(
+        cwd="/workspace", timeout=30, task_id="conversation-test", socket_path=broker.socket_path
+    )
+    return broker, env
+
+
+def test_ensure_on_init_stores_numeric_generation():
+    broker, env = make_env()
+    assert env.generation == 1
+    assert broker.calls[0] == (
+        "/v1/environments/ensure",
+        {"environmentKey": "conversation-test"},
+    )
+
+
+def test_env_is_persistent_across_turns():
+    _broker, env = make_env()
+    assert env._persistent is True
+
+
+def test_recreation_notice_injected_once():
+    broker, env = make_env()
+    broker.generation = 2
+    broker.ensure_state = "created"
+    broker.exec_responders = [("stdout", "ok\n")]
+    first = env.execute("true")
+    assert first["output"].startswith("[sandbox notice]")
+    assert "ephemeral" in first["output"].lower()
+    broker.exec_responders = [("stdout", "ok\n")]
+    second = env.execute("true")
+    assert "[sandbox notice]" not in second["output"]
+
+
+def test_run_bash_streams_ndjson_and_exit_code():
+    broker, env = make_env()
+    broker.exec_responders = [("stdout", "hello "), ("stdout", "world\n"), ("stderr", "oops\n")]
+    broker.exec_exit_code = 7
+    proc = env._run_bash("echo hello", timeout=30)
+    result = env._wait_for_process(proc, timeout=30)
+    assert result["returncode"] == 7
+    assert "hello world" in result["output"]
+    assert "oops" in result["output"]
+    path, payload = next(call for call in broker.calls if call[0] == "/v1/exec")
+    assert path == "/v1/exec"
+    assert payload["argv"] == ["/bin/sh", "-lc", "echo hello"]
+    assert payload["generation"] == 1
+
+
+def test_kill_closes_http_stream_for_broker_hard_cancel():
+    broker, env = make_env()
+    broker.hang_exec = True
+    proc = env._run_bash("sleep 100", timeout=30)
+    assert broker.exec_started.wait(timeout=5)
+    proc.kill()
+    assert proc.wait(timeout=5) == 130
+    assert broker.disconnected.wait(timeout=5)
+
+
+def test_cleanup_closes_generation():
+    broker, env = make_env()
+    env.cleanup()
+    assert (
+        "/v1/environments/close",
+        {"environmentKey": "conversation-test", "generation": 1},
+    ) in broker.calls
+    assert env._closed
+
+
+def test_problem_details_maps_to_broker_error():
+    broker = FakeBroker(short_sock())
+    broker.ensure_denied = True
+    try:
+        GondolinEnvironment(task_id="denied", socket_path=broker.socket_path)
+    except BrokerError as err:
+        assert err.reason == "policy.denied"
+        assert err.status == 403
+    else:
+        raise AssertionError("expected BrokerError")
+
+
+def test_health_check_uses_http_over_uds(tmp_path):
+    broker = FakeBroker(short_sock())
+    assert check_gondolin_available(broker.socket_path)
+    assert broker.calls[-1] == ("/v1/health", None)
+    assert not check_gondolin_available(str(tmp_path / "missing.sock"))
+
+
+def test_embed_stdin_heredoc_groups_command():
+    wrapped = GondolinEnvironment._embed_stdin_heredoc("a; b; c", "payload")
+    head, _, tail = wrapped.partition("\n")
+    assert head == "{"
+    delimiter = wrapped.split("'")[1]
+    assert delimiter.startswith("HERMES_STDIN_")
+    assert wrapped.rstrip().endswith(f"payload\n{delimiter}")
+    assert tail.startswith(f"a; b; c\n}} << '{delimiter}'")
+
+
+def test_stdin_heredoc_feeds_multi_command_scripts(tmp_path):
+    target = tmp_path / "out.txt"
+    script = (
+        "set -e; "
+        f"d={tmp_path}; t={target}; "
+        'tmp="$(mktemp -p "$d" .hermes-tmp.XXXXXX)"; '
+        "trap 'rm -f \"$tmp\"' EXIT; "
+        'cat > "$tmp"; '
+        'mv -f "$tmp" "$t"; '
+        "trap - EXIT"
+    )
+    wrapped = GondolinEnvironment._embed_stdin_heredoc(script, "hello Daniel")
+    result = subprocess.run(["/bin/sh", "-c", wrapped], capture_output=True, text=True)
+    assert result.returncode == 0, result.stderr
+    assert target.read_text() == "hello Daniel\n"
