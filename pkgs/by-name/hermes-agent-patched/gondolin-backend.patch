@@ -0,0 +1,511 @@
+"""Contract tests for Hermes HTTP/1.1 over Unix-socket Gondolin client."""
+
+import base64
+import json
+import os
+import socketserver
+import subprocess
+import tempfile
+import threading
+import time
+from http.server import BaseHTTPRequestHandler
+
+import pytest
+from tools.environments.gondolin import (
+    BrokerError,
+    GondolinEnvironment,
+    check_gondolin_available,
+)
+from tools.file_operations import ShellFileOperations
+
+
+class _UnixHttpServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
+    daemon_threads = True
+
+
+class _Handler(BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+
+    def log_message(self, _format, *args):
+        return
+
+    @property
+    def broker(self):
+        return self.server.broker
+
+    def _request_json(self):
+        size = int(self.headers.get("content-length", "0"))
+        return json.loads(self.rfile.read(size))
+
+    def _json(self, status, body, content_type="application/json"):
+        payload = json.dumps(body).encode()
+        self.send_response(status)
+        self.send_header("content-type", content_type)
+        self.send_header("content-length", str(len(payload)))
+        self.end_headers()
+        self.wfile.write(payload)
+
+    def do_GET(self):
+        self.broker.calls.append((self.path, None))
+        if self.path == "/v1/health":
+            self._json(200, {"status": "ok"})
+        else:
+            self._json(404, {"reason": "request.invalid", "detail": "not found"}, "application/problem+json")
+
+    def do_POST(self):
+        request = self._request_json()
+        self.broker.calls.append((self.path, request))
+        if self.path == "/v1/environments/ensure":
+            if self.broker.ensure_denied:
+                self._json(
+                    403,
+                    {
+                        "type": "urn:agent-x:gondolin-broker:error:policy.denied",
+                        "title": "policy.denied",
+                        "status": 403,
+                        "detail": "policy denied ensure",
+                        "reason": "policy.denied",
+                    },
+                    "application/problem+json",
+                )
+                return
+            state = self.broker.ensure_state
+            self.broker.ensure_state = "reused"
+            self._json(200, {
+                "environmentKey": request["environmentKey"],
+                "generation": self.broker.generation,
+                "state": state,
+                "profile": "test",
+                "executor": "hermes-gateway",
+                "authorityClass": "default",
+                "policyGeneration": 1,
+                "decisionDigest": "digest",
+            })
+        elif self.path == "/v1/files/read":
+            self._json(200, {
+                "dataBase64": base64.b64encode(self.broker.file_data).decode(),
+                "size": len(self.broker.file_data),
+            })
+        elif self.path == "/v1/files/write":
+            self.broker.file_data = base64.b64decode(request["dataBase64"], validate=True)
+            self._json(200, {"size": len(self.broker.file_data)})
+        elif self.path == "/v1/environments/close":
+            self.broker.closed_generations.append(
+                (request["environmentKey"], request["generation"])
+            )
+            self.broker.close_acknowledged.set()
+            self._json(self.broker.close_status, self.broker.close_body)
+        elif self.path == "/v1/exec":
+            self.send_response(200)
+            self.send_header("content-type", "application/x-ndjson")
+            self.send_header("connection", "close")
+            self.end_headers()
+            self.close_connection = True
+            self._event({
+                "type": "start",
+                "environmentKey": request["environmentKey"],
+                "generation": request["generation"],
+                "decisionDigest": "digest",
+                "timeoutMs": request["timeoutMs"],
+                "outputLimitBytes": 4096,
+            })
+            self.broker.exec_started.set()
+            if self.broker.exec_error:
+                self._event({
+                    "type": "error",
+                    "reason": self.broker.exec_error[0],
+                    "message": self.broker.exec_error[1],
+                })
+                return
+            if self.broker.hang_exec:
+                while True:
+                    try:
+                        self.wfile.write(b"\n")
+                        self.wfile.flush()
+                    except (BrokenPipeError, ConnectionResetError):
+                        self.broker.disconnected.set()
+                        return
+                    time.sleep(0.01)
+            for stream, text in self.broker.exec_responders:
+                self._event({
+                    "type": "output",
+                    "sequence": self.broker.sequence,
+                    "stream": stream,
+                    "dataBase64": base64.b64encode(text.encode()).decode(),
+                })
+                self.broker.sequence += 1
+                if self.broker.exec_pause:
+                    time.sleep(self.broker.exec_pause)
+            self._event({"type": "exit", "exitCode": self.broker.exec_exit_code, "signal": None})
+        else:
+            self._json(404, {"reason": "request.invalid", "detail": "not found"}, "application/problem+json")
+
+    def _event(self, event):
+        self.wfile.write(json.dumps(event).encode() + b"\n")
+        self.wfile.flush()
+
+
+class FakeBroker:
+    def __init__(self, socket_path):
+        self.socket_path = socket_path
+        self.calls = []
+        self.exec_responders = []
+        self.exec_exit_code = 0
+        self.ensure_state = "created"
+        self.ensure_denied = False
+        self.generation = 1
+        self.sequence = 0
+        self.hang_exec = False
+        self.exec_error = None
+        self.exec_pause = 0.0
+        self.close_status = 200
+        self.close_body = {"closed": True}
+        self.closed_generations = []
+        self.close_acknowledged = threading.Event()
+        self.file_data = b""
+        self.exec_started = threading.Event()
+        self.disconnected = threading.Event()
+        self._server = _UnixHttpServer(socket_path, _Handler)
+        self._server.broker = self
+        self._thread = threading.Thread(target=self._server.serve_forever, daemon=True)
+        self._thread.start()
+
+    def close(self):
+        self._server.shutdown()
+        self._server.server_close()
+        try:
+            os.unlink(self.socket_path)
+        except OSError:
+            pass
+
+
+def short_sock():
+    return os.path.join(tempfile.mkdtemp(prefix="gb-"), "b.sock")
+
+
+def make_env():
+    broker = FakeBroker(short_sock())
+    env = GondolinEnvironment(
+        cwd="/workspace", timeout=30, task_id="conversation-test", socket_path=broker.socket_path
+    )
+    return broker, env
+
+
+def test_ensure_on_init_stores_numeric_generation():
+    broker, env = make_env()
+    assert env.generation == 1
+    assert broker.calls[0] == (
+        "/v1/environments/ensure",
+        {"environmentKey": "conversation-test"},
+    )
+
+
+def test_env_is_persistent_across_turns():
+    _broker, env = make_env()
+    assert env._persistent is True
+
+
+def test_recreation_notice_injected_once():
+    broker, env = make_env()
+    broker.generation = 2
+    broker.ensure_state = "created"
+    broker.exec_responders = [("stdout", "ok\n")]
+    first = env.execute("true")
+    assert first["output"].startswith("[sandbox notice]")
+    assert "ephemeral" in first["output"].lower()
+    broker.exec_responders = [("stdout", "ok\n")]
+    second = env.execute("true")
+    assert "[sandbox notice]" not in second["output"]
+
+
+def test_run_bash_streams_ndjson_and_exit_code():
+    broker, env = make_env()
+    broker.exec_responders = [("stdout", "hello "), ("stdout", "world\n"), ("stderr", "oops\n")]
+    broker.exec_exit_code = 7
+    proc = env._run_bash("echo hello", timeout=30)
+    result = env._wait_for_process(proc, timeout=30)
+    assert result["returncode"] == 7
+    assert result["output"] == "hello world\noops\n"
+    path, payload = next(call for call in broker.calls if call[0] == "/v1/exec")
+    assert path == "/v1/exec"
+    assert payload["argv"] == ["/bin/sh", "-c", "echo hello"]
+    assert payload["generation"] == 1
+
+
+def test_run_bash_exposes_output_before_broker_exit():
+    broker, env = make_env()
+    broker.exec_responders = [("stdout", "ready\n"), ("stdout", "done\n")]
+    broker.exec_pause = 0.5
+    proc = env._run_bash("long-running", timeout=30)
+
+    assert proc.stdout.readline() == "ready\n"
+    assert proc.poll() is None
+    assert proc.wait(timeout=5) == 0
+
+
+def test_run_bash_surfaces_broker_error_frame():
+    broker, env = make_env()
+    broker.exec_error = ("policy.denied", "command blocked")
+    proc = env._run_bash("blocked", timeout=30)
+    result = env._wait_for_process(proc, timeout=5)
+
+    assert result["returncode"] == 1
+    assert "policy.denied" in result["output"]
+    assert "command blocked" in result["output"]
+
+
+
+def test_immediate_broker_error_is_retained_before_handle_publication(monkeypatch):
+    """A broker error returned before handle publication remains observable."""
+    from tools.environments import gondolin
+
+    broker, env = make_env()
+    broker.exec_error = ("policy.denied", "command blocked")
+
+    class ImmediateHandle:
+        def __init__(self, exec_fn, cancel_fn):
+            self.output, self.returncode = exec_fn()
+            self.cancel_fn = cancel_fn
+
+        def write_output(self, chunk):
+            self.output += chunk
+
+    monkeypatch.setattr(gondolin, "_ThreadedProcessHandle", ImmediateHandle)
+    handle = env._run_bash("blocked", timeout=30)
+
+    assert handle.returncode == 1
+    assert "[broker error] policy.denied: command blocked" in handle.output
+
+def test_gondolin_process_schema_hides_stdin_actions(monkeypatch):
+    from types import SimpleNamespace
+    from tools import process_registry
+
+    monkeypatch.setattr(
+        "tools.terminal_tool._get_env_config",
+        lambda: {"env_type": "gondolin"},
+    )
+    override = process_registry._process_schema_overrides()
+    assert override["parameters"]["properties"]["action"]["enum"] == [
+        "list", "poll", "log", "wait", "kill"
+    ]
+    assert "data" not in override["parameters"]["properties"]
+    assert "stdin" in override["description"]
+
+    registry = process_registry.ProcessRegistry()
+    session = process_registry.ProcessSession(
+        id="proc_gondolin",
+        command="cat",
+        env_ref=SimpleNamespace(supports_process_stdin=False),
+    )
+    with registry._lock:
+        registry._running[session.id] = session
+    for result in (
+        registry.write_stdin(session.id, "x"),
+        registry.submit_stdin(session.id, "x"),
+        registry.close_stdin(session.id),
+    ):
+        assert result["status"] == "unsupported_capability"
+        assert result["capability"] == "process_stdin"
+
+
+def test_tool_schema_cache_separates_runtime_backend(monkeypatch):
+    import model_tools
+
+    backend = {"name": "local"}
+    computed_for = []
+
+    def fake_config():
+        return {"env_type": backend["name"]}
+
+    def fake_compute(
+        enabled_toolsets=None,
+        disabled_toolsets=None,
+        quiet_mode=False,
+        *,
+        skip_tool_search_assembly=False,
+    ):
+        computed_for.append(backend["name"])
+        return [{"function": {"name": backend["name"]}}]
+
+    monkeypatch.setattr("tools.terminal_tool._get_env_config", fake_config)
+    monkeypatch.setattr(model_tools, "_compute_tool_definitions", fake_compute)
+    model_tools._clear_tool_defs_cache()
+    try:
+        first = model_tools.get_tool_definitions(
+            quiet_mode=True,
+            skip_tool_search_assembly=True,
+        )
+        backend["name"] = "gondolin"
+        second = model_tools.get_tool_definitions(
+            quiet_mode=True,
+            skip_tool_search_assembly=True,
+        )
+    finally:
+        model_tools._clear_tool_defs_cache()
+
+    assert first[0]["function"]["name"] == "local"
+    assert second[0]["function"]["name"] == "gondolin"
+    assert computed_for == ["local", "gondolin"]
+
+
+def test_cancel_before_exec_request_returns_exit_130(monkeypatch):
+    from tools.environments import gondolin
+
+    broker, env = make_env()
+
+    class CapturedHandle:
+        def __init__(self, exec_fn, cancel_fn):
+            self.exec_fn = exec_fn
+            self.cancel_fn = cancel_fn
+
+    monkeypatch.setattr(gondolin, "_ThreadedProcessHandle", CapturedHandle)
+    handle = env._run_bash("true")
+    handle.cancel_fn()
+
+    assert handle.exec_fn() == ("", 130)
+    assert broker.closed_generations == [("conversation-test", 1)]
+    assert not [call for call in broker.calls if call[0] == "/v1/exec"]
+
+def test_kill_closes_http_stream_for_broker_hard_cancel():
+    broker, env = make_env()
+    broker.hang_exec = True
+    proc = env._run_bash("sleep 100", timeout=30)
+    assert broker.exec_started.wait(timeout=5)
+    # The live environment may move on before cancellation; the execution
+    # must still close the generation captured when this handle was created.
+    broker.generation = 99
+    proc.kill()
+    assert broker.close_acknowledged.is_set()
+    assert broker.closed_generations == [("conversation-test", 1)]
+    assert proc.wait(timeout=5) == 130
+    assert broker.disconnected.wait(timeout=5)
+
+def test_next_command_reensures_new_generation_after_cancel():
+    broker, env = make_env()
+    broker.hang_exec = True
+    proc = env._run_bash("sleep 100", timeout=30)
+    assert broker.exec_started.wait(timeout=5)
+    proc.kill()
+    assert proc.wait(timeout=5) == 130
+
+    broker.generation = 2
+    broker.ensure_state = "created"
+    broker.hang_exec = False
+    broker.exec_responders = [("stdout", "next\n")]
+    result = env.execute("echo next")
+
+    assert result["returncode"] == 0
+    assert result["output"].startswith("[sandbox notice]")
+    exec_payloads = [payload for path, payload in broker.calls if path == "/v1/exec"]
+    assert exec_payloads[-1]["generation"] == 2
+
+
+def test_cancel_failure_is_surfaced_without_local_success():
+    broker, env = make_env()
+    broker.hang_exec = True
+    broker.close_status = 503
+    broker.close_body = {"reason": "broker.unavailable", "detail": "close failed"}
+    proc = env._run_bash("sleep 100", timeout=30)
+    assert broker.exec_started.wait(timeout=5)
+
+    with pytest.raises(BrokerError, match="broker.unavailable"):
+        proc.kill()
+    assert proc.poll() is None
+    assert proc.returncode is None
+
+
+def test_cleanup_closes_generation():
+    broker, env = make_env()
+    env.cleanup()
+    assert (
+        "/v1/environments/close",
+        {"environmentKey": "conversation-test", "generation": 1},
+    ) in broker.calls
+    assert env._closed
+
+
+def test_problem_details_maps_to_broker_error():
+    broker = FakeBroker(short_sock())
+    broker.ensure_denied = True
+    try:
+        GondolinEnvironment(task_id="denied", socket_path=broker.socket_path)
+    except BrokerError as err:
+        assert err.reason == "policy.denied"
+        assert err.status == 403
+    else:
+        raise AssertionError("expected BrokerError")
+
+
+def test_health_check_uses_http_over_uds(tmp_path):
+    broker = FakeBroker(short_sock())
+    assert check_gondolin_available(broker.socket_path)
+    assert broker.calls[-1] == ("/v1/health", None)
+    assert not check_gondolin_available(str(tmp_path / "missing.sock"))
+
+
+def test_terminal_registration_does_not_depend_on_broker_liveness(monkeypatch, tmp_path):
+    missing_socket = str(tmp_path / "missing.sock")
+    monkeypatch.setenv("TERMINAL_ENV", "gondolin")
+    monkeypatch.setenv("HERMES_GONDOLIN_SOCKET", missing_socket)
+
+    from tools.terminal_tool import check_terminal_requirements
+
+    assert not check_gondolin_available(missing_socket)
+    assert check_terminal_requirements()
+
+
+def test_typed_file_round_trip_preserves_control_bytes():
+    broker, env = make_env()
+    payload = "héllo\x1b]8;;https://example.test\x07link\x1b]8;;\x07\n".encode()
+    broker.file_data = payload
+    assert env.read_file_bytes("/workspace/example.txt") == payload
+    assert env.write_file_bytes("/workspace/example.txt", payload + b"\x00") == len(payload) + 1
+    assert broker.file_data == payload + b"\x00"
+    paths = [path for path, _request in broker.calls]
+    assert "/v1/files/read" in paths
+    assert "/v1/files/write" in paths
+
+
+def test_patch_uses_typed_files_without_terminal_output_corruption():
+    broker, env = make_env()
+    original = "pré\x1b]8;;https://example.test\x07link\x1b]8;;\x07 post\n".encode()
+    expected = "pré\x1b]8;;https://example.test\x07changed\x1b]8;;\x07 post\n".encode()
+    broker.file_data = original
+
+    result = ShellFileOperations(env).patch_replace(
+        "/workspace/example.txt",
+        "link",
+        "changed",
+    )
+
+    assert result.success, result.error
+    assert broker.file_data == expected
+    file_calls = [path for path, _request in broker.calls if path.startswith("/v1/files/")]
+    assert file_calls == ["/v1/files/read", "/v1/files/write", "/v1/files/read"]
+
+
+def test_embed_stdin_heredoc_groups_command():
+    wrapped = GondolinEnvironment._embed_stdin_heredoc("a; b; c", "payload")
+    head, _, tail = wrapped.partition("\n")
+    assert head == "{"
+    delimiter = wrapped.split("'")[1]
+    assert delimiter.startswith("HERMES_STDIN_")
+    assert wrapped.rstrip().endswith(f"payload\n{delimiter}")
+    assert tail.startswith(f"a; b; c\n}} << '{delimiter}'")
+
+
+def test_stdin_heredoc_feeds_multi_command_scripts(tmp_path):
+    target = tmp_path / "out.txt"
+    script = (
+        "set -e; "
+        f"d={tmp_path}; t={target}; "
+        'tmp="$(mktemp -p "$d" .hermes-tmp.XXXXXX)"; '
+        "trap 'rm -f \"$tmp\"' EXIT; "
+        'cat > "$tmp"; '
+        'mv -f "$tmp" "$t"; '
+        "trap - EXIT"
+    )
+    wrapped = GondolinEnvironment._embed_stdin_heredoc(script, "hello Daniel")
+    result = subprocess.run(["/bin/sh", "-c", wrapped], capture_output=True, text=True)
+    assert result.returncode == 0, result.stderr
+    assert target.read_text() == "hello Daniel\n"
