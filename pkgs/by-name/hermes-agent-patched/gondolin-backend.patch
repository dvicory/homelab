@@ -0,0 +1,277 @@
+"""Gondolin Effect broker terminal backend.
+
+Uses ordinary HTTP/1.1 over the profile's mode-0600 Unix socket. Hermes supplies
+only the canonical environment key and commands; the broker owns VM assets,
+policy, lifecycle, filesystem mediation, and resource ceilings.
+"""
+
+import base64
+import json
+import logging
+import os
+import threading
+import uuid
+from typing import Any, Optional
+
+import httpx
+
+from tools.environments.base import BaseEnvironment, _ThreadedProcessHandle
+
+logger = logging.getLogger(__name__)
+
+_DEFAULT_SOCKET = "/run/hermes-sandbox/broker.sock"
+_BASE_URL = "http://localhost"
+
+
+class BrokerError(Exception):
+    """Broker-side failure with a stable machine-readable reason."""
+
+    def __init__(self, reason: str, message: str, status: int | None = None):
+        super().__init__(f"{reason}: {message}")
+        self.reason = reason
+        self.status = status
+
+
+class BrokerClient:
+    """Thread-safe HTTPX client for HTTP/1.1 over one Unix socket."""
+
+    def __init__(self, socket_path: str, timeout: float = 30.0):
+        self._socket_path = socket_path
+        self._timeout = timeout
+        self._client = httpx.Client(
+            transport=httpx.HTTPTransport(uds=socket_path),
+            base_url=_BASE_URL,
+            timeout=httpx.Timeout(timeout),
+            headers={"accept": "application/json"},
+        )
+
+    def close(self) -> None:
+        self._client.close()
+
+    @staticmethod
+    def _raise_for_status(response: httpx.Response) -> None:
+        if response.status_code < 400:
+            return
+        try:
+            problem = response.json()
+        except (json.JSONDecodeError, UnicodeDecodeError):
+            problem = {}
+        reason = problem.get("reason", "broker.http_error")
+        detail = problem.get("detail", f"broker returned HTTP {response.status_code}")
+        raise BrokerError(str(reason), str(detail), response.status_code)
+
+    def health(self) -> bool:
+        response = self._client.get("/v1/health", timeout=self._timeout)
+        self._raise_for_status(response)
+        body = response.json()
+        return body.get("status") == "ok"
+
+    def ensure(self, environment_key: str, timeout: float = 180.0) -> dict:
+        response = self._client.post(
+            "/v1/environments/ensure",
+            json={"environmentKey": environment_key},
+            timeout=timeout,
+        )
+        self._raise_for_status(response)
+        return response.json()
+
+    def close_environment(self, environment_key: str, generation: int) -> None:
+        response = self._client.post(
+            "/v1/environments/close",
+            json={"environmentKey": environment_key, "generation": generation},
+            timeout=self._timeout,
+        )
+        self._raise_for_status(response)
+
+    def execute(
+        self,
+        payload: dict,
+        *,
+        timeout: float,
+        on_open=None,
+    ) -> tuple[list[dict], dict]:
+        events: list[dict] = []
+        request_timeout = httpx.Timeout(max(timeout, 30.0), read=None)
+        with self._client.stream(
+            "POST",
+            "/v1/exec",
+            json=payload,
+            timeout=request_timeout,
+            headers={"accept": "application/x-ndjson"},
+        ) as response:
+            self._raise_for_status(response)
+            if on_open is not None:
+                on_open(response)
+            for line in response.iter_lines():
+                if not line:
+                    continue
+                try:
+                    event = json.loads(line)
+                except json.JSONDecodeError as exc:
+                    raise BrokerError("protocol.invalid_json", "invalid NDJSON event") from exc
+                if event.get("type") == "error":
+                    raise BrokerError(
+                        str(event.get("reason", "broker.stream_error")),
+                        str(event.get("message", "execution failed")),
+                    )
+                events.append(event)
+        exits = [event for event in events if event.get("type") == "exit"]
+        if len(exits) != 1:
+            raise BrokerError("protocol.incomplete_stream", "execution stream has no terminal exit event")
+        return events, exits[0]
+
+
+class GondolinEnvironment(BaseEnvironment):
+    """Hermes environment backed by the Gondolin Effect broker."""
+
+    _stdin_mode = "heredoc"
+
+    @staticmethod
+    def _embed_stdin_heredoc(command: str, stdin_data: str) -> str:
+        delimiter = f"HERMES_STDIN_{uuid.uuid4().hex[:12]}"
+        return f"{{\n{command}\n}} << '{delimiter}'\n{stdin_data}\n{delimiter}"
+
+    def __init__(
+        self,
+        cwd: str = "/workspace",
+        timeout: int = 180,
+        env: dict = None,
+        task_id: str = None,
+        socket_path: str = None,
+    ):
+        super().__init__(cwd, timeout, env)
+        self._persistent = True
+        self._socket_path = socket_path or os.environ.get(
+            "HERMES_GONDOLIN_SOCKET", _DEFAULT_SOCKET
+        )
+        self._env_key = task_id or "default"
+        self._client = BrokerClient(self._socket_path, timeout=30.0)
+        self.generation: Optional[int] = None
+        self._closed = False
+        self._state_loss_notice: Optional[str] = None
+        self._ensure_environment()
+
+    def _ensure_environment(self) -> None:
+        previous_generation = self.generation
+        result = self._client.ensure(self._env_key)
+        generation = result.get("generation")
+        if not isinstance(generation, int):
+            raise BrokerError("protocol.invalid_response", "ensure response has no integer generation")
+        self.generation = generation
+        state = result.get("state")
+        if previous_generation is not None and generation != previous_generation:
+            logger.warning(
+                "Gondolin environment %s recreated: generation %s -> %s",
+                self._env_key,
+                previous_generation,
+                generation,
+            )
+            self._state_loss_notice = (
+                "[sandbox notice] The sandbox VM was recreated since the last "
+                "command. Ephemeral state was lost: files outside /workspace "
+                "(e.g. /tmp), running processes, and shell state. /workspace "
+                "contents persist.\n"
+            )
+        else:
+            logger.info(
+                "Gondolin environment %s %s (generation=%s)",
+                self._env_key,
+                state,
+                generation,
+            )
+
+    def execute(self, command: str, cwd: str = "", **kwargs) -> dict:
+        result = super().execute(command, cwd, **kwargs)
+        if self._state_loss_notice:
+            notice, self._state_loss_notice = self._state_loss_notice, None
+            result["output"] = notice + result.get("output", "")
+        return result
+
+    def _run_bash(
+        self,
+        cmd_string: str,
+        *,
+        login: bool = False,
+        timeout: int = 120,
+        stdin_data: Optional[str] = None,
+    ) -> _ThreadedProcessHandle:
+        if self._closed:
+            raise RuntimeError("Gondolin environment is closed")
+
+        # Re-ensure before every command. This is cheap for a live generation
+        # and recovers cleanly after broker restart or disconnect cancellation.
+        self._ensure_environment()
+        if self.generation is None:
+            raise BrokerError("protocol.invalid_response", "environment has no generation")
+
+        state: dict[str, Any] = {"response": None}
+        state_lock = threading.Lock()
+        cancelled = threading.Event()
+
+        def on_open(response: httpx.Response) -> None:
+            with state_lock:
+                state["response"] = response
+
+        def exec_fn():
+            try:
+                events, result = self._client.execute(
+                    {
+                        "environmentKey": self._env_key,
+                        "generation": self.generation,
+                        "argv": ["/bin/sh", "-lc", cmd_string],
+                        "timeoutMs": int(timeout) * 1000,
+                    },
+                    timeout=max(float(timeout) + 30.0, 60.0),
+                    on_open=on_open,
+                )
+            except httpx.HTTPError:
+                if cancelled.is_set():
+                    return "", 130
+                raise
+
+            output_parts = []
+            for event in events:
+                if event.get("type") != "output":
+                    continue
+                data = base64.b64decode(event.get("dataBase64", ""))
+                output_parts.append(data.decode("utf-8", errors="replace"))
+            exit_code = result.get("exitCode")
+            if exit_code is None:
+                exit_code = 128 if result.get("signal") is not None else 1
+            return "".join(output_parts), int(exit_code)
+
+        def cancel_fn():
+            cancelled.set()
+            with state_lock:
+                response = state.get("response")
+            if response is not None:
+                response.close()
+
+        return _ThreadedProcessHandle(exec_fn, cancel_fn)
+
+    def cleanup(self):
+        if self._closed:
+            return
+        self._closed = True
+        try:
+            if self.generation is not None:
+                self._client.close_environment(self._env_key, self.generation)
+        except Exception as exc:  # noqa: BLE001 - cleanup must not raise
+            logger.debug("Gondolin close for %s failed: %s", self._env_key, exc)
+        finally:
+            self._client.close()
+
+
+def check_gondolin_available(socket_path: str = None) -> bool:
+    """Health check for tool registration: the broker answers HTTP over UDS."""
+    path = socket_path or os.environ.get("HERMES_GONDOLIN_SOCKET", _DEFAULT_SOCKET)
+    client = None
+    try:
+        client = BrokerClient(path, timeout=5.0)
+        return client.health()
+    except Exception as exc:  # noqa: BLE001 - a health probe never raises
+        logger.error("Gondolin broker unavailable at %s: %s", path, exc)
+        return False
+    finally:
+        if client is not None:
+            client.close()
