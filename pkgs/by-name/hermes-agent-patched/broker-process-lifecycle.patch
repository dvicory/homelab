+    def spawn_background(self, command: str, cwd: str = "") -> str:
+        self._ensure_environment()
+        if self.generation is None:
+            raise BrokerError("protocol.invalid_response", "environment has no generation")
+        result = self._client.spawn_process(
+            {
+                "environmentKey": self._env_key,
+                "generation": self.generation,
+                "argv": ["/bin/sh", "-c", command],
+                "cwd": cwd or self.cwd,
+            }
+        )
+        if result["state"] != "running":
+            raise BrokerError(
+                "protocol.invalid_response",
+                "broker process did not enter running state",
+            )
+        return result["processId"]
+
+    @staticmethod
+    def _decode_process_result(result: dict) -> dict:
+        state = BrokerClient._required_text(result, "state")
+        if state not in {"running", "exited", "cancelled", "lost"}:
+            raise BrokerError(
+                "protocol.invalid_response",
+                "broker process response has an invalid state",
+            )
+        events = result.get("output")
+        if not isinstance(events, list) or not all(
+            isinstance(event, dict) for event in events
+        ):
+            raise BrokerError(
+                "protocol.invalid_response",
+                "broker process response has invalid output",
+            )
+        output = []
+        for event in events:
+            try:
+                data = base64.b64decode(event.get("dataBase64", ""), validate=True)
+            except (ValueError, TypeError) as exc:
+                raise BrokerError(
+                    "protocol.invalid_output",
+                    "invalid broker process output base64",
+                ) from exc
+            output.append(data.decode("utf-8", errors="replace"))
+        for field in ("nextCursor", "truncatedBytes"):
+            value = result.get(field)
+            if not isinstance(value, int) or isinstance(value, bool) or value < 0:
+                raise BrokerError(
+                    "protocol.invalid_response",
+                    f"broker process response has invalid {field}",
+                )
+        return {
+            "state": state,
+            "reason": result.get("reason"),
+            "exitCode": result.get("exitCode"),
+            "signal": result.get("signal"),
+            "output": output,
+            "nextCursor": result["nextCursor"],
+            "truncatedBytes": result["truncatedBytes"],
+        }
+
+    def poll_background(self, process_id: str, cursor: int) -> dict:
+        if self.generation is None:
+            raise BrokerError("protocol.invalid_response", "environment has no generation")
+        result = self._client.poll_process(
+            {
+                "environmentKey": self._env_key,
+                "generation": self.generation,
+                "processId": process_id,
+                "cursor": cursor,
+            }
+        )
+        return self._decode_process_result(result)
+
+    def cancel_background(self, process_id: str) -> dict:
+        if self.generation is None:
+            raise BrokerError("protocol.invalid_response", "environment has no generation")
+        result = self._client.cancel_process(
+            {
+                "environmentKey": self._env_key,
+                "generation": self.generation,
+                "processId": process_id,
+            }
+        )
+        return self._decode_process_result(result)
