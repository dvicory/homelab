+def test_background_process_uses_broker_lifecycle_and_exact_exit():
+    broker, env = make_env()
+    process_id = env.spawn_background("exit 7", "/workspace/work")
+    assert process_id == "process-test"
+    spawn_call = next(call for call in broker.calls if call[0] == "/v1/processes/spawn")
+    assert spawn_call[1]["argv"] == ["/bin/sh", "-c", "exit 7"]
+    assert spawn_call[1]["cwd"] == "/workspace/work"
+
+    broker.process_state = "exited"
+    broker.process_exit_code = 7
+    broker.process_output = [{
+        "cursor": 1,
+        "sequence": 0,
+        "stream": "stdout",
+        "dataBase64": base64.b64encode(b"done\n").decode(),
+    }]
+    broker.process_next_cursor = 1
+    result = env.poll_background(process_id, 0)
+    assert result["state"] == "exited"
+    assert result["exitCode"] == 7
+    assert result["output"] == ["done\n"]
+
+
+def test_background_cancel_uses_process_route_not_environment_close():
+    broker, env = make_env()
+    process_id = env.spawn_background("sleep 30", "/workspace/work")
+    result = env.cancel_background(process_id)
+    assert result["state"] == "cancelled"
+    assert any(path == "/v1/processes/cancel" for path, _request in broker.calls)
+    assert broker.closed_generations == []
+
