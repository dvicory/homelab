+    def _managed_env_poller_loop(self, session: ProcessSession, env: Any):
+        """Drain output and terminal state from a backend-owned process."""
+        while not session.exited:
+            try:
+                result = env.poll_background(
+                    session.backend_process_id,
+                    session.backend_cursor,
+                )
+                next_cursor = result.get("nextCursor")
+                if (
+                    not isinstance(next_cursor, int)
+                    or isinstance(next_cursor, bool)
+                    or next_cursor < session.backend_cursor
+                ):
+                    raise ValueError("backend process returned an invalid output cursor")
+
+                chunks = result.get("output", [])
+                if not isinstance(chunks, list) or not all(
+                    isinstance(chunk, str) for chunk in chunks
+                ):
+                    raise ValueError("backend process returned invalid output")
+                delta = "".join(chunks)
+                truncated = result.get("truncatedBytes", 0)
+                if (
+                    not isinstance(truncated, int)
+                    or isinstance(truncated, bool)
+                    or truncated < session.backend_truncated_bytes
+                ):
+                    raise ValueError("backend process returned invalid truncation metadata")
+                if truncated > session.backend_truncated_bytes:
+                    delta = (
+                        f"\n[broker truncated {truncated - session.backend_truncated_bytes} "
+                        "bytes of older process output]\n"
+                        + delta
+                    )
+
+                with session._lock:
+                    session.backend_cursor = next_cursor
+                    session.backend_truncated_bytes = truncated
+                    if delta:
+                        session.output_buffer += delta
+                        if len(session.output_buffer) > session.max_output_chars:
+                            session.output_buffer = session.output_buffer[
+                                -session.max_output_chars:
+                            ]
+                if delta:
+                    self._check_watch_patterns(session, delta)
+                    self._emit_output(session, delta)
+
+                state = result.get("state")
+                if state == "running":
+                    time.sleep(1)
+                    continue
+                if state not in {"exited", "cancelled", "lost"}:
+                    raise ValueError("backend process returned an invalid state")
+
+                with session._lock:
+                    session.exited = True
+                    session.signal = result.get("signal")
+                    exit_code = result.get("exitCode")
+                    if state == "exited":
+                        session.exit_code = exit_code if isinstance(exit_code, int) else None
+                        session.completion_reason = "exited"
+                    elif state == "cancelled":
+                        session.exit_code = -15
+                        session.completion_reason = "killed"
+                    else:
+                        session.exit_code = None
+                        session.completion_reason = "lost"
+                    session.termination_source = str(result.get("reason") or "")
+                self._move_to_finished(session)
+                return
+            except Exception:
+                with session._lock:
+                    if session.exited:
+                        return
+                    session.exited = True
+                    session.exit_code = None
+                    session.completion_reason = "lost"
+                    session.termination_source = "backend_lost"
