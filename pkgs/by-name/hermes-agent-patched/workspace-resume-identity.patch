new file mode 100644
index 0000000000000000000000000000000000000000..19736a2d83f50ab20127f3fb7d751578cbfbf4d0
--- /dev/null
+++ b/gateway/workspace_branch.py
@@ -0,0 +1,37 @@
+"""Trusted lifecycle bridge for private broker-backed conversation branches."""
+
+from __future__ import annotations
+
+import os
+from typing import Any
+
+
+def prepare_workspace_branch(
+    session_db: Any,
+    source_session_id: str,
+    destination_session_id: str,
+) -> None:
+    """Prepare durable branch state before a caller activates the child.
+
+    Native environments have no registered preparer and need no extra work.
+    A configured broker control socket makes preparation mandatory: missing,
+    failed, or malformed plugin results block the branch instead of silently
+    selecting an empty workspace.
+    """
+    from gateway.session_context import resolve_workspace_session_id
+    from hermes_cli.plugins import invoke_required_hook
+
+    source_owner = resolve_workspace_session_id(session_db, source_session_id)
+    results = invoke_required_hook(
+        "on_session_branch",
+        source_session_id=source_session_id,
+        source_workspace_session_id=source_owner,
+        destination_session_id=destination_session_id,
+    )
+    required = bool(os.environ.get("GONDOLIN_EFFECT_CONTROL_SOCKET", "").strip())
+    if required and not results:
+        raise RuntimeError("broker-backed branch preparation is unavailable")
+    for result in results:
+        if not isinstance(result, dict) or result.get("ok") is not True:
+            detail = result.get("detail") if isinstance(result, dict) else None
+            raise RuntimeError(str(detail or "branch workspace preparation failed"))
