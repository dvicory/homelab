diff --git a/tests/gateway/test_approval_permanent_choices.py b/tests/gateway/test_approval_permanent_choices.py
new file mode 100644
--- /dev/null
+++ b/tests/gateway/test_approval_permanent_choices.py
@@ -0,0 +1,26 @@
+"""Gateway approval prompts expose only choices accepted by the approval gate."""
+
+from gateway.run import _gateway_approval_message
+
+
+def test_non_permanent_gateway_prompt_omits_always_choice():
+    prompt = _gateway_approval_message(
+        "<sandbox_request_access>",
+        "canonical capability request",
+        "/",
+        False,
+    )
+
+    assert "`/approve`" in prompt
+    assert "`/approve session`" in prompt
+    assert "`/deny`" in prompt
+    assert "approve always" not in prompt
+    assert "permanent" not in prompt
+
+
+def test_ordinary_gateway_prompt_retains_always_choice():
+    prompt = _gateway_approval_message(
+        "rm -rf /tmp/build", "dangerous command", "!", True
+    )
+
+    assert "`!approve always`" in prompt
