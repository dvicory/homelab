+    choices = (
+        f"Reply `{command_prefix}approve` to execute, "
+        f"`{command_prefix}approve session` to approve this pattern for the session"
+    )
+    if allow_permanent:
+        choices += f", `{command_prefix}approve always` to approve permanently"
+    choices += f", or `{command_prefix}deny` to cancel."
