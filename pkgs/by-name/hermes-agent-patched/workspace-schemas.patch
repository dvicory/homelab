diff --git a/tests/plugins/test_workspace_handoff.py b/tests/plugins/test_workspace_handoff.py
--- a/tests/plugins/test_workspace_handoff.py
+++ b/tests/plugins/test_workspace_handoff.py
@@ -11,5 +11,6 @@ import pytest
 
 from hermes_cli import kanban_db as kb
 from hermes_cli import plugins
+from tools import kanban_tools
 
 
@@ -137,3 +138,102 @@ def test_broker_handoff_client_uses_control_routes_and_opaque_results(monkeypatch):
         "/v1/control/workspace-revisions/publish",
         "/v1/control/workspace-revisions/import",
     ]
+
+
+def test_handoff_tool_schemas_expose_only_trusted_selectors():
+    create = kanban_tools.KANBAN_CREATE_SCHEMA["parameters"]["properties"]
+    complete = kanban_tools.KANBAN_COMPLETE_SCHEMA["parameters"]["properties"]
+    assert create["inherit_parent_workspace_output"]["type"] == "boolean"
+    assert complete["workspace_outputs"] == {
+        "type": "array",
+        "items": {"type": "string"},
+        "minItems": 1,
+        "maxItems": 128,
+        "description": complete["workspace_outputs"]["description"],
+    }
+    forbidden = {
+        "source_task_id",
+        "source_revision_id",
+        "revision_id",
+        "workspace_id",
+        "workspace_lease_id",
+        "workspace_inputs",
+        "workspace_remap",
+        "destination_path",
+    }
+    assert forbidden.isdisjoint(create)
+    assert forbidden.isdisjoint(complete)
+
+
+def test_create_binds_inherited_input_to_trusted_direct_parent(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_PROFILE", "orchestrator")
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    with kb.connect() as connection:
+        parent_id = kb.create_task(
+            connection,
+            title="parent",
+            assignee="orchestrator",
+            workspace_kind="dir",
+            workspace_path="/host/private",
+        )
+    monkeypatch.setenv("HERMES_KANBAN_TASK", parent_id)
+    response = json.loads(kanban_tools._handle_create({
+        "title": "child",
+        "assignee": "worker",
+        "parents": [parent_id],
+        "inherit_parent_workspace_output": True,
+    }))
+    assert response["ok"] is True
+    with kb.connect() as connection:
+        child = kb.get_task(connection, response["task_id"])
+        assert child.inherit_parent_workspace_output is True
+        assert child.workspace_kind == "scratch"
+        assert child.workspace_path is None
+        assert kb.parent_ids(connection, child.id) == [parent_id]
+
+
+@pytest.mark.parametrize(
+    "override",
+    [
+        {"parents": []},
+        {"parents": ["parent", "other"]},
+        {"workspace_path": "/host/selected"},
+        {"project": "caller-selected"},
+        {"source_revision_id": "revision-selected"},
+        {"workspace_inputs": ["one", "two"]},
+    ],
+)
+def test_create_rejects_untrusted_inherited_input_selection(
+    monkeypatch, tmp_path, override
+):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "parent")
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    args = {
+        "title": "child",
+        "assignee": "worker",
+        "parents": ["parent"],
+        "inherit_parent_workspace_output": True,
+        **override,
+    }
+    response = json.loads(kanban_tools._handle_create(args))
+    assert "error" in response
+    with kb.connect() as connection:
+        assert connection.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == 0
+
+
+def test_create_requires_non_model_current_task_identity(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    response = json.loads(kanban_tools._handle_create({
+        "title": "child",
+        "assignee": "worker",
+        "parents": ["model-selected"],
+        "inherit_parent_workspace_output": True,
+    }))
+    assert "trusted current task identity" in response["error"]
