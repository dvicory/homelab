diff --git a/tests/plugins/test_workspace_kanban.py b/tests/plugins/test_workspace_kanban.py
new file mode 100644
--- /dev/null
+++ b/tests/plugins/test_workspace_kanban.py
@@ -0,0 +1,114 @@
+"""Kanban-to-broker workspace handoff contracts."""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import plugins
+from hermes_cli import worker_lanes
+
+
+PLUGIN = Path(__file__).parents[2] / "plugins" / "workspace-service" / "__init__.py"
+
+
+def load_plugin(monkeypatch):
+    monkeypatch.setenv("HERMES_GONDOLIN_SOCKET", "/run/broker.sock")
+    monkeypatch.setenv("HERMES_SANDBOX_AUTHORITY_BINDING", "qa:gateway:default:v1")
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    sys.modules.pop("workspace_kanban_test", None)
+    spec = importlib.util.spec_from_file_location("workspace_kanban_test", PLUGIN)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_prepare_worker_environment_returns_only_opaque_broker_binding(monkeypatch):
+    plugin = load_plugin(monkeypatch)
+    monkeypatch.setattr(plugin, "_acquire", lambda **_: {
+        "workspaceId": "workspace-opaque",
+        "workspaceLeaseId": "lease-opaque",
+        "guestPath": "/workspace",
+    })
+
+    result = plugin._on_prepare_worker_environment(task_id="task-a")
+
+    assert result == {
+        "workspaceMode": "broker",
+        "environment": {
+            "HERMES_WORKSPACE_ID": "workspace-opaque",
+            "HERMES_WORKSPACE_LEASE_ID": "lease-opaque",
+            "HERMES_WORKSPACE_GUEST_PATH": "/workspace",
+        },
+    }
+    assert all("/home/" not in value for value in result["environment"].values())
+
+
+def test_shared_worker_contract_removes_host_workspace_for_broker_mode(
+    monkeypatch, tmp_path
+):
+    workspace = tmp_path / "host-workspace"
+    workspace.mkdir()
+    task = SimpleNamespace(
+        id="task-a",
+        assignee="worker",
+        current_run_id=4,
+        claim_lock="claim",
+        tenant=None,
+    )
+    monkeypatch.setattr(kb, "kanban_home", lambda: tmp_path)
+    monkeypatch.setattr(kb, "kanban_db_path", lambda board=None: tmp_path / "kanban.db")
+    monkeypatch.setattr(kb, "workspaces_root", lambda board=None: tmp_path / "workspaces")
+    monkeypatch.setattr(kb, "get_current_board", lambda: "homelab")
+    monkeypatch.setattr(
+        plugins,
+        "invoke_hook",
+        lambda *args, **kwargs: [{
+            "workspaceMode": "broker",
+            "environment": {
+                "HERMES_WORKSPACE_ID": "workspace-opaque",
+                "HERMES_WORKSPACE_LEASE_ID": "lease-opaque",
+                "HERMES_WORKSPACE_GUEST_PATH": "/workspace",
+            },
+        }],
+    )
+
+    env = worker_lanes.kanban_worker_env(task, str(workspace), base={})
+
+    assert env["HERMES_KANBAN_TASK"] == "task-a"
+    assert env["HERMES_WORKSPACE_ID"] == "workspace-opaque"
+    assert env["HERMES_WORKSPACE_GUEST_PATH"] == "/workspace"
+    assert "HERMES_KANBAN_WORKSPACE" not in env
+    assert "TERMINAL_CWD" not in env
+
+
+def test_worker_preflight_reuses_dispatcher_workspace(monkeypatch):
+    plugin = load_plugin(monkeypatch)
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "task-a")
+    monkeypatch.setenv("HERMES_WORKSPACE_ID", "workspace-opaque")
+    monkeypatch.setenv("HERMES_WORKSPACE_LEASE_ID", "lease-opaque")
+    registered = []
+    monkeypatch.setattr(
+        plugin.terminal_tool,
+        "register_task_authority_binding",
+        lambda identity, binding: registered.append((identity, binding)),
+    )
+    monkeypatch.setattr(plugin.terminal_tool, "environment_key", lambda *_: "authority-stable")
+    requests = []
+    monkeypatch.setattr(plugin, "_request", lambda route, body: requests.append((route, body)) or {
+        "workspace": {"workspaceId": "workspace-opaque", "guestPath": "/workspace"},
+        "lease": {"leaseId": "lease-opaque"},
+    })
+
+    binding = plugin._acquire(task_id="worker-turn", session_id="worker-session")
+
+    assert binding["workspaceId"] == "workspace-opaque"
+    assert requests[0][1] == {
+        "environmentKey": "authority-stable",
+        "workspaceId": "workspace-opaque",
+    }
+    assert {item[0] for item in registered} == {"task-a", "worker-turn", "worker-session"}
