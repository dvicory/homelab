From 8e2af55f4e7d1f52e2731ce0f0c4f44eac4c8517 Mon Sep 17 00:00:00 2001
From: Daniel Vicory <dvicory@gmail.com>
Date: Tue, 21 Jul 2026 22:30:00 -0700
Subject: [PATCH] feat(approvals): let tool callers disable permanent choices

Capability brokers may support durable rules without exposing them through
every approval surface. Let trusted tool integrations hide the permanent
choice and ignore an old permanent approval cache when they do so.
---
diff --git a/tools/approval.py b/tools/approval.py
index 4591f64..f08623d 100644
--- a/tools/approval.py
+++ b/tools/approval.py
@@ -2016,0 +2017 @@ def _run_approval_gate(
+    allow_permanent: bool = True,
@@ -2069,0 +2071,2 @@ def _run_approval_gate(
+    if cached_scope == "always" and not allow_permanent:
+        cached_scope = None
@@ -2139 +2142 @@ def _run_approval_gate(
-                "allow_permanent": True,
+                "allow_permanent": allow_permanent,
@@ -2153,0 +2157,2 @@ def _run_approval_gate(
+            if choice == "always" and not allow_permanent:
+                choice = "session"
@@ -2206 +2211,4 @@ def _run_approval_gate(
-                                       approval_callback=approval_callback)
+                                       approval_callback=approval_callback,
+                                       allow_permanent=allow_permanent)
+    if choice == "always" and not allow_permanent:
+        choice = "session"
@@ -2319,0 +2328 @@ def request_tool_approval(
+    allow_permanent: bool = True,
@@ -2381,0 +2391 @@ def request_tool_approval(
+        allow_permanent=allow_permanent,
diff --git a/tests/tools/test_approval_choice_result.py b/tests/tools/test_approval_choice_result.py
index 249664c..ad72f47 100644
--- a/tests/tools/test_approval_choice_result.py
+++ b/tests/tools/test_approval_choice_result.py
@@ -49,0 +50,33 @@ def test_cached_session_and_permanent_approvals_report_scope(monkeypatch):
+
+
+def test_tool_approval_can_disable_permanent_choice(monkeypatch):
+    prompt = {}
+
+    def choose_always(*args, **kwargs):
+        prompt.update(kwargs)
+        return "always"
+
+    monkeypatch.setattr(approval, "prompt_dangerous_approval", choose_always)
+    result = approval.request_tool_approval(
+        "sandbox_request_access",
+        "canonical capability request",
+        rule_key="non-permanent-rule",
+        allow_permanent=False,
+    )
+
+    assert prompt["allow_permanent"] is False
+    assert result["approved"] is True
+    assert result["choice"] == "session"
+    assert approval.approved_scope("scope-test", "plugin_rule:non-permanent-rule") == "session"
+
+    approval.clear_session("scope-test")
+    approval.approve_permanent("plugin_rule:non-permanent-rule")
+    prompt.clear()
+    result = approval.request_tool_approval(
+        "sandbox_request_access",
+        "canonical capability request",
+        rule_key="non-permanent-rule",
+        allow_permanent=False,
+    )
+    assert prompt["allow_permanent"] is False
+    assert result["choice"] == "session"
--
2.50.1
