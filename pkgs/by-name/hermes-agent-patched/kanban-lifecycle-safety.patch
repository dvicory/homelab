@@ -1232,15 +1232,13 @@ def init_agent(
     elif not agent.quiet_mode:
         print("🛠️  No tools loaded (all tools filtered out or unavailable)")
 
-    # Kanban worker/orchestrator lifecycle guidance is session-static:
-    # the dispatcher decides at spawn time whether this process is a kanban
-    # worker (kanban_show tool is present iff HERMES_KANBAN_TASK is set).
-    # Resolving the ~835-token block once here avoids re-running the
-    # membership test + reference on every system-prompt rebuild
-    # (init + each context compression).
-    from agent.prompt_builder import KANBAN_GUIDANCE
-    agent._kanban_worker_guidance = (
-        KANBAN_GUIDANCE if "kanban_show" in agent.valid_tool_names else ""
+    # Kanban role guidance is session-static. The dispatcher provides the
+    # trusted task identity for workers; kanban_list is orchestrator-only.
+    # Resolve the contract once here so prompt rebuilds remain byte-stable.
+    from agent.prompt_builder import select_kanban_guidance
+    agent._kanban_worker_guidance = select_kanban_guidance(
+        task_id=os.environ.get("HERMES_KANBAN_TASK"),
+        tool_names=agent.valid_tool_names,
     )
 
     # Check tool requirements
