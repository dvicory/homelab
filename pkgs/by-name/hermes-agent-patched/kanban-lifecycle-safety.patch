@@ -299,6 +302,41 @@ KANBAN_GUIDANCE = (
     "cross-agent handoffs that outlive one API loop."
 )
 
+
+KANBAN_ORCHESTRATOR_GUIDANCE = (
+    "# Kanban orchestration protocol\n"
+    "You route durable work on the shared Kanban board; you are not a "
+    "dispatcher-assigned task worker.\n"
+    "1. Use the `kanban_*` tools to create, inspect, link, comment on, and "
+    "observe tasks. Do not execute a task body yourself or substitute "
+    "`delegate_task` for board work the user requested.\n"
+    "2. Create each intended task once. A `ready` or `running` task is queued "
+    "or executing, not evidence that the dispatcher is unavailable or the "
+    "worker is stalled. Short tasks need not emit heartbeats. Do not create a "
+    "replacement merely because status or heartbeat is unchanged within the "
+    "claim lease. Judge progress from authoritative task events, not a terminal "
+    "process view.\n"
+    "3. Worker lifecycle belongs to the assigned worker. Do not complete, "
+    "block, or heartbeat on its behalf. Unblock only when the task contract "
+    "or a human authorizes a retry and the recorded blocker is resolved.\n"
+    "4. Report outcomes from authoritative task state. Claim success only when "
+    "the required tasks are `done`; report a blocker instead of working around "
+    "it in the live session.\n"
+    "5. Use `kanban_comment` for relevant routing context. Never put secrets, "
+    "tokens, or raw PII in board data; task history is durable.\n"
+)
+
+
+def select_kanban_guidance(
+    *, task_id: str | None, tool_names: set[str]
+) -> str:
+    """Select the session-static Kanban contract from trusted role signals."""
+    if task_id:
+        return KANBAN_GUIDANCE
+    if "kanban_list" in tool_names:
+        return KANBAN_ORCHESTRATOR_GUIDANCE
+    return ""
+
 TOOL_USE_ENFORCEMENT_GUIDANCE = (
     "# Tool-use enforcement\n"
     "You MUST use your tools to take action — do not describe what you would do "
