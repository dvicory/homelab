+"""Regression tests for worker versus live-orchestrator Kanban authority."""
+
+
+def test_kanban_guidance_in_orchestrator_prompt(monkeypatch, tmp_path):
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    (home / "config.yaml").write_text("toolsets:\n  - kanban\n")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    from pathlib import Path
+
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+
+    from model_tools import _clear_tool_defs_cache
+    from tools.registry import invalidate_check_fn_cache
+
+    invalidate_check_fn_cache()
+    _clear_tool_defs_cache()
+
+    from run_agent import AIAgent
+
+    agent = AIAgent(
+        api_key="test",
+        base_url="https://openrouter.ai/api/v1",
+        model="deepseek-v4-flash",
+        quiet_mode=True,
+        skip_context_files=True,
+        skip_memory=True,
+    )
+    prompt = agent._build_system_prompt()
+    assert "Kanban orchestration protocol" in prompt
+    assert "Kanban task execution protocol" not in prompt
+    assert "Do not execute a task body yourself" in prompt
+    assert "# Tool-use enforcement" not in prompt
+    assert "Keep working until the task is actually complete" not in prompt
+
+
+def test_kanban_guidance_selection_separates_worker_and_orchestrator():
+    from agent.prompt_builder import (
+        KANBAN_GUIDANCE,
+        KANBAN_ORCHESTRATOR_GUIDANCE,
+        select_kanban_guidance,
+    )
+
+    assert select_kanban_guidance(
+        task_id="t_worker", tool_names={"kanban_show", "kanban_list"}
+    ) == KANBAN_GUIDANCE
+    assert select_kanban_guidance(
+        task_id=None, tool_names={"kanban_show", "kanban_list"}
+    ) == KANBAN_ORCHESTRATOR_GUIDANCE
+    assert select_kanban_guidance(
+        task_id=None, tool_names={"kanban_show"}
+    ) == ""
+
+
+def test_kanban_orchestrator_guidance_forbids_worker_substitution():
+    from agent.prompt_builder import KANBAN_ORCHESTRATOR_GUIDANCE
+
+    assert "Do not execute a task body yourself" in KANBAN_ORCHESTRATOR_GUIDANCE
+    assert "substitute `delegate_task`" in KANBAN_ORCHESTRATOR_GUIDANCE
+    assert "A `ready` task is queued work" in KANBAN_ORCHESTRATOR_GUIDANCE
+    assert "Worker lifecycle belongs to the assigned worker" in (
+        KANBAN_ORCHESTRATOR_GUIDANCE
+    )
+    assert "Claim success only when" in KANBAN_ORCHESTRATOR_GUIDANCE
+
+
+def test_kanban_worker_lifecycle_gate_excludes_orchestrator(monkeypatch):
+    from tools import kanban_tools as kanban
+
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    monkeypatch.setattr(kanban, "_profile_has_kanban_toolset", lambda: True)
+    assert kanban._check_kanban_mode()
+    assert kanban._check_kanban_orchestrator_mode()
+    assert not kanban._check_kanban_worker_mode()
+
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "t_worker")
+    assert kanban._check_kanban_worker_mode()
+    assert not kanban._check_kanban_orchestrator_mode()
