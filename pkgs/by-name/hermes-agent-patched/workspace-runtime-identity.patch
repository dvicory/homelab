+def test_required_workspace_hook_propagates_callback_failure(monkeypatch):
+    from hermes_cli import plugins
+
+    monkeypatch.setattr(plugins, "has_hook", lambda name: True)
+
+    def fail_required_hook(name, **kwargs):
+        raise RuntimeError("handoff.conflict: selected output is absent")
+
+    monkeypatch.setattr(plugins, "invoke_required_hook", fail_required_hook)
+
+    with pytest.raises(
+        RuntimeError,
+        match="workspace finalization unavailable: handoff.conflict",
+    ):
+        kb._run_required_workspace_hook(
+            "kanban_workspace_completion_intent",
+            task_id="t_required",
+            board="default",
+            run_id=7,
+        )
--- a/tests/gateway/test_kanban_notifier.py
+++ b/tests/gateway/test_kanban_notifier.py
@@ -86,8 +86,40 @@
     assert len(adapter.sent) == 1
     assert "Kanban" in adapter.sent[0]["text"]
