+def get_workspace_session_id(default: str = "") -> str:
+    """Return the trusted workspace owner bound to this task context."""
+    value = _WORKSPACE_SESSION_ID.get()
+    return default if value is _UNSET else value
+
+
+def resolve_workspace_session_id(session_db, session_id: str) -> str:
+    """Return the stable compression root used for workspace ownership.
+
+    Branches, delegates, and ordinary sessions resolve to themselves because
+    SessionDB.get_compression_lineage follows compression edges only. Failure
+    falls back to the current durable segment, preserving isolation at the cost
+    of continuity rather than aliasing two conversations.
+    """
+    if not isinstance(session_id, str) or not session_id:
+        return ""
+    database = getattr(session_db, "_db", session_db)
+    lineage_for = getattr(database, "get_compression_lineage", None)
+    if not callable(lineage_for):
+        return session_id
+    try:
+        lineage = lineage_for(session_id)
+    except Exception:
+        return session_id
+    if (
+        isinstance(lineage, list)
+        and lineage
+        and isinstance(lineage[0], str)
+        and lineage[0]
+    ):
+        return lineage[0]
+    return session_id
+
+
