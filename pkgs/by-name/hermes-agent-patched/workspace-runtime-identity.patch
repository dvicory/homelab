+def test_kanban_worker_env_pins_broker_environment_key(
+    kanban_home, monkeypatch,
+):
+    import types
+
+    monkeypatch.setenv("HERMES_SANDBOX_AUTHORITY_BINDING", "binding-test")
+    task = types.SimpleNamespace(
+        id="t_broker",
+        current_run_id=9,
+        claim_lock="host:1:broker",
+        tenant=None,
+        workspace_kind="broker",
+    )
+
+    env = wl.kanban_worker_env(task, "/workspace", base={})
+
+    assert env["HERMES_WORKSPACE_MODE"] == "broker"
+    assert env["HERMES_BROKER_WORKSPACE"] == "/workspace"
+    assert env["HERMES_BROKER_ENVIRONMENT_KEY"].startswith("authority-")
+
+
