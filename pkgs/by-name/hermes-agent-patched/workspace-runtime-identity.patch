+def test_notifier_reports_block_loop_triage(tmp_path, monkeypatch):
+    db_path = tmp_path / "triage-notify.db"
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(db_path))
+    kb.init_db()
+
+    conn = kb.connect()
+    try:
+        tid = kb.create_task(conn, title="triage loop", assignee="worker")
+        kb.add_notify_sub(conn, task_id=tid, platform="telegram", chat_id="chat-1")
+        kb._append_event(
+            conn,
+            tid,
+            kind="block_loop_detected",
+            payload={
+                "reason": "workspace capture failed",
+                "kind": "transient",
+                "recurrences": 2,
+                "limit": 2,
+            },
+        )
+    finally:
+        conn.close()
 
+    adapter = RecordingAdapter()
+    runner = _make_runner(adapter)
+    asyncio.run(_run_one_notifier_tick(monkeypatch, runner))
 
+    assert len(adapter.sent) == 1
+    assert "moved to triage after 2 repeated blocks" in adapter.sent[0]["text"]
+    assert "workspace capture failed" in adapter.sent[0]["text"]
+
+
 def test_kanban_notifier_claim_prevents_second_watcher_send(tmp_path, monkeypatch):
     db_path = tmp_path / "single-owner.db"
     monkeypatch.setenv("HERMES_KANBAN_DB", str(db_path))
