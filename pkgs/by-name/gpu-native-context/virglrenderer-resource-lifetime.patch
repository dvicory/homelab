@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: MIT
+ * CPU heap ownership only. Link the ACTUAL renderer/common/object code.
+ * The GEM handle is synthetic; /dev/null is real but is not a DRM device.
+ * Only PRIME export failure is injected. The real destructor/free and its
+ * real (ENOTTY) GEM_CLOSE ioctl run unchanged. LeakSanitizer is the leak oracle.
+ */
+#include <stdio.h>
+
+#include "virglrenderer.h"
+#include "i915_object.h"
+#include "i915_resource.h"
+
+#define REQUIRE(c) do { if (!(c)) { \
+   fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #c); abort(); \
+} } while (0)
+
+
+int __wrap_drmPrimeHandleToFD(int fd, uint32_t handle, uint32_t flags, int *out_fd);
+
+int
+__wrap_drmPrimeHandleToFD(int fd, uint32_t handle, uint32_t flags, int *out_fd)
+{
+   REQUIRE(fcntl(fd, F_GETFD) >= 0);
+   (void)handle;
+   (void)flags;
+   (void)out_fd;
+   errno = EMFILE;
+   return -1;
+}
+
+/* Leave all object pointers in a returned frame before LSan's exit scan. */
+static __attribute__((noinline)) int
+run_case(const char *mode)
+{
+   const bool bad_size = !strcmp(mode, "size");
+   const bool export_failure = !strcmp(mode, "export");
+   struct drm_context dctx = {0};
+   int fd = open("/dev/null", O_RDWR | O_CLOEXEC);
+   REQUIRE(fd >= 0);
+   REQUIRE(drm_context_init(&dctx, fd, NULL, 0));
+   dctx.free_object = i915_renderer_free_object;
+
+   struct i915_object *obj = i915_object_create(1001, 4096);
+   REQUIRE(obj);
+   drm_context_object_set_blob_id(&dctx, &obj->base, 7);
+   REQUIRE(drm_context_res_id_unused(&dctx, 77));
+
+   struct virgl_context_blob blob = {0};
+   int ret = i915_renderer_get_blob(&dctx.base, 77, 7,
+                                    bad_size ? 8192 : 4096,
+                                    export_failure ? VIRGL_RENDERER_BLOB_FLAG_USE_SHAREABLE : 0,
+                                    &blob);
+   int expected = bad_size ? -EINVAL : export_failure ? -EMFILE : 0;
+   int failed = ret != expected;
+   if (failed)
+      fprintf(stderr, "%s: get_blob returned %d, expected %d\n", mode, ret, expected);
+
+   if (bad_size || export_failure) {
+      /* Either retained pending ownership or complete retirement is valid. */
+      REQUIRE(drm_context_res_id_unused(&dctx, 77));
+   } else {
+      struct drm_object *owned = drm_context_get_object_from_res_id(&dctx, 77);
+      REQUIRE(owned == &obj->base);
+   }
+
+   /* Do NOT free obj here: lost pending ownership must remain a real leak. */
+   drm_context_deinit(&dctx);
+   REQUIRE(fcntl(fd, F_GETFD) == -1 && errno == EBADF);
+   return failed;
+}
+
+int
+main(int argc, char **argv)
+{
+   if (argc != 2 || (strcmp(argv[1], "size") && strcmp(argv[1], "export") &&
+                     strcmp(argv[1], "success"))) {
+      fprintf(stderr, "usage: %s size|export|success\n", argv[0]);
+      return 2;
+   }
+   return run_case(argv[1]);
+}
