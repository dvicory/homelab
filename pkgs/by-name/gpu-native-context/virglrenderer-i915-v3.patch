+/* SPDX-License-Identifier: MIT
+ * CPU-only production dispatch/state checks. Pipes simulate the ioctl boundary;
+ * they are NOT sync-files and this test makes no physical GPU completion claim.
+ */
+#include <poll.h>
+#include <stdio.h>
+#include <stdatomic.h>
+
+#include "virglrenderer.h"
+#include "virgl_fence.h"
+#include "i915_object.h"
+#include "i915_renderer.h"
+
+#define CHECK(c) do { if (!(c)) { \
+   fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #c); abort(); \
+} } while (0)
+
+static int kernel_error, destroy_error, output_read = -1;
+static bool omit_output, fail_calloc;
+static int fail_dup_after = -1;
+static unsigned exec_calls, destroy_calls;
+static uint64_t expected_context;
+static uint32_t expected_relocs;
+static atomic_uint retired;
+static uint64_t retired_ids[256];
+static mtx_t retire_mutex;
+static cnd_t retire_cond;
+static bool pause_next_poll, poll_paused, release_poll;
+
+void *__real_calloc(size_t count, size_t size);
+int __real_os_dupfd_cloexec(int fd);
+int __real_poll(struct pollfd *fds, nfds_t count, int timeout);
+
+void *__wrap_calloc(size_t count, size_t size);
+int __wrap_os_dupfd_cloexec(int fd);
+int __wrap_poll(struct pollfd *fds, nfds_t count, int timeout);
+int __wrap_drmIoctl(int fd, unsigned long cmd, void *arg);
+
+int __wrap_poll(struct pollfd *fds, nfds_t count, int timeout)
+{
+   if (timeout == -1) {
+      mtx_lock(&retire_mutex);
+      if (pause_next_poll) {
+         pause_next_poll = false;
+         poll_paused = true;
+         cnd_signal(&retire_cond);
+         while (!release_poll)
+            CHECK(cnd_wait(&retire_cond, &retire_mutex) == thrd_success);
+      }
+      mtx_unlock(&retire_mutex);
+   }
+   return __real_poll(fds, count, timeout);
+}
+
+void *__wrap_calloc(size_t count, size_t size)
+{
+   if (fail_calloc) {
+      fail_calloc = false;
+      errno = ENOMEM;
+      return NULL;
+   }
+   return __real_calloc(count, size);
+}
+
+int __wrap_os_dupfd_cloexec(int fd)
+{
+   if (fail_dup_after == 0) {
+      fail_dup_after = -1;
+      errno = EMFILE;
+      return -1;
+   }
+   if (fail_dup_after > 0)
+      fail_dup_after--;
+   return __real_os_dupfd_cloexec(fd);
+}
+
+int __wrap_drmIoctl(int fd, unsigned long cmd, void *arg)
+{
+   (void)fd;
+   if (cmd == DRM_IOCTL_I915_GEM_EXECBUFFER2_WR) {
+      struct drm_i915_gem_execbuffer2 *exec = arg;
+      struct drm_i915_gem_exec_object2 *obj = (void *)(uintptr_t)exec->buffers_ptr;
+      exec_calls++;
+      CHECK(exec->rsvd1 == expected_context);
+      CHECK(exec->buffer_count == 1 && obj->handle == 1001);
+      CHECK(obj->relocation_count == expected_relocs);
+      CHECK(exec->flags & I915_EXEC_FENCE_OUT);
+      CHECK(!(exec->flags & (I915_EXEC_USE_EXTENSIONS | I915_EXEC_FENCE_ARRAY)));
+      if (expected_relocs) {
+         struct drm_i915_gem_relocation_entry *reloc = (void *)(uintptr_t)obj->relocs_ptr;
+         CHECK(reloc == (void *)(obj + 1));
+         CHECK(reloc->target_handle == 0);
+      } else {
+         CHECK(obj->relocs_ptr == 0);
+      }
+      if (kernel_error) {
+         errno = kernel_error;
+         return -1;
+      }
+      if (!omit_output) {
+         int out = dup(output_read);
+         CHECK(out >= 0);
+         exec->rsvd2 = (exec->rsvd2 & UINT32_MAX) | ((uint64_t)(uint32_t)out << 32);
+      }
+      return 0;
+   }
+   if (cmd == DRM_IOCTL_I915_GEM_CONTEXT_DESTROY) {
+      destroy_calls++;
+      if (destroy_error) {
+         errno = destroy_error;
+         return -1;
+      }
+      return 0;
+   }
+   CHECK(cmd == DRM_IOCTL_GEM_CLOSE);
+   return 0;
+}
+
+static void retire(struct virgl_context *vctx, uint32_t ring, uint64_t id)
+{
+   (void)vctx;
+   CHECK(ring < 65);
+   mtx_lock(&retire_mutex);
+   unsigned n = atomic_load(&retired);
+   CHECK(n < ARRAY_SIZE(retired_ids));
+   retired_ids[n] = id;
+   atomic_store(&retired, n + 1);
+   cnd_signal(&retire_cond);
+   mtx_unlock(&retire_mutex);
+}
+
+static void wait_retired(unsigned count)
+{
+   struct timespec deadline;
+   timespec_get(&deadline, TIME_UTC);
+   deadline.tv_sec += 5;
+   mtx_lock(&retire_mutex);
+   while (atomic_load(&retired) < count)
+      CHECK(cnd_timedwait(&retire_cond, &retire_mutex, &deadline) == thrd_success);
+   mtx_unlock(&retire_mutex);
+}
+
+static struct i915_context *make_context(void)
+{
+   struct virgl_context *vctx = i915_renderer_create(-1, 0, NULL);
+   CHECK(vctx);
+   vctx->in_fence_fd = -1;
+   vctx->fence_retire = retire;
+   struct i915_context *ictx = to_i915_context(to_drm_context(vctx));
+   struct virgl_context_blob blob;
+   CHECK(drm_context_get_shmem_blob(&ictx->base, "i915-v3-test", sizeof(struct i915_shmem),
+                                   4096, VIRGL_RENDERER_BLOB_FLAG_USE_MAPPABLE, &blob) == 0);
+   close(blob.u.fd);
+   struct i915_object *obj = i915_object_create(1001, 4096);
+   CHECK(obj);
+   drm_context_object_set_res_id(&ictx->base, &obj->base, 77);
+   return ictx;
+}
+
+struct packet {
+   uint64_t words[(sizeof(struct i915_ccmd_gem_execbuffer2_v3_req) +
+                   sizeof(struct drm_i915_gem_exec_object2) +
+                   sizeof(struct drm_i915_gem_relocation_entry)) / 8];
+};
+
+static struct i915_ccmd_gem_execbuffer2_v3_req *packet(struct packet *p, uint32_t ring,
+                                                     uint64_t ctx, uint64_t flags)
+{
+   memset(p, 0, sizeof(*p));
+   struct i915_ccmd_gem_execbuffer2_v3_req *req = (void *)p;
+   req->hdr = I915_CCMD(GEM_EXECBUFFER2_V3,
+                        sizeof(*req) + sizeof(struct drm_i915_gem_exec_object2));
+   req->context_id = ctx;
+   req->ring_idx = ring;
+   req->flags = flags;
+   req->buffer_count = 1;
+   struct drm_i915_gem_exec_object2 *obj = (void *)req->payload;
+   obj->handle = 77;
+   /* Guest pointers must be replaced even when there are no relocations. */
+   obj->relocs_ptr = UINT64_MAX;
+   return req;
+}
+
+static int send_packet(struct i915_context *ictx, void *packet)
+{
+   struct vdrm_ccmd_req *hdr = packet;
+   struct i915_ccmd_gem_execbuffer2_rsp *rsp = (void *)ictx->base.rsp_mem;
+   rsp->hdr.len = sizeof(*rsp);
+   rsp->ret = -999;
+   hdr->seqno = ictx->base.shmem->seqno + 1;
+   CHECK(ictx->base.base.submit_cmd(&ictx->base.base, packet, hdr->len) == 0);
+   CHECK(ictx->base.shmem->seqno == hdr->seqno);
+   CHECK(rsp->hdr.len == sizeof(*rsp));
+   return rsp->ret;
+}
+
+static int destroy_context(struct i915_context *ictx, uint32_t ctx)
+{
+   uint64_t storage[(sizeof(struct i915_ccmd_ioctl_simple_req) +
+                     sizeof(struct drm_i915_gem_context_destroy)) / 8] = {0};
+   struct i915_ccmd_ioctl_simple_req *req = (void *)storage;
+   req->hdr = I915_CCMD(IOCTL_SIMPLE, sizeof(storage));
+   req->hdr.seqno = ictx->base.shmem->seqno + 1;
+   req->cmd = DRM_IOCTL_I915_GEM_CONTEXT_DESTROY;
+   ((struct drm_i915_gem_context_destroy *)(void *)req->payload)->ctx_id = ctx;
+   struct i915_ccmd_ioctl_simple_rsp *rsp = (void *)ictx->base.rsp_mem;
+   rsp->hdr.len = sizeof(*rsp);
+   CHECK(ictx->base.base.submit_cmd(&ictx->base.base, req, sizeof(storage)) == 0);
+   CHECK(ictx->base.shmem->seqno == req->hdr.seqno);
+   return rsp->ret;
+}
+
+static void check_rejections(void)
+{
+   struct i915_context *ictx = make_context();
+   struct packet p;
+   struct i915_ccmd_gem_execbuffer2_v3_req *req = packet(&p, 1, 9, I915_EXEC_BSD);
+   unsigned calls = exec_calls;
+   req->pad = 1;
+   CHECK(send_packet(ictx, req) == EINVAL);
+   CHECK(!ictx->rings[1].context_id && exec_calls == calls);
+   unsigned before = atomic_load(&retired);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 2, 1) < 0);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 0, 1) < 0);
+   CHECK(atomic_load(&retired) == before);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 1) == 0);
+   CHECK(atomic_load(&retired) == before + 1);
+   CHECK(!ictx->rings[1].context_id && ictx->rings[1].physical_fd == -1);
+
+   uint64_t bad_ctx[] = {0, 64, UINT64_C(0x100000001)};
+   for (unsigned i = 0; i < ARRAY_SIZE(bad_ctx); i++) {
+      req = packet(&p, 1, bad_ctx[i], I915_EXEC_BSD);
+      CHECK(send_packet(ictx, req) == EINVAL);
+      CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 2 + i) == 0);
+   }
+   uint64_t bad_flags[] = {5, I915_EXEC_RENDER | I915_EXEC_BSD_RING1,
+                          I915_EXEC_BSD | I915_EXEC_BSD_MASK,
+                          I915_EXEC_BSD | I915_EXEC_FENCE_IN,
+                          I915_EXEC_BSD | I915_EXEC_USE_EXTENSIONS};
+   for (unsigned i = 0; i < ARRAY_SIZE(bad_flags); i++) {
+      req = packet(&p, 1, 9, bad_flags[i]);
+      CHECK(send_packet(ictx, req) == EINVAL);
+      CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 10 + i) == 0);
+   }
+   req = packet(&p, 1, 9, I915_EXEC_BSD);
+   req->relocs_count = 1;
+   req->hdr.len = sizeof(p);
+   struct drm_i915_gem_exec_object2 *obj = (void *)req->payload;
+   obj->relocation_count = 1;
+   CHECK(send_packet(ictx, req) == EINVAL); /* Non-LUT relocation. */
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 20) == 0);
+   obj->relocation_count = 0;
+   req->flags |= I915_EXEC_HANDLE_LUT;
+   CHECK(send_packet(ictx, req) == EINVAL); /* Unclaimed trailing relocation. */
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 21) == 0);
+   CHECK(exec_calls == calls);
+   ictx->base.base.destroy(&ictx->base.base);
+
+   /* A second packet/trailer must never execute the otherwise-valid first. */
+   ictx = make_context();
+   uint64_t stream[2 * sizeof(struct packet) / 8] = {0};
+   req = packet((void *)stream, 1, 9, I915_EXEC_BSD);
+   struct vdrm_ccmd_req *tail = (void *)((char *)stream + req->hdr.len);
+   *tail = (struct vdrm_ccmd_req) { .cmd = I915_CCMD_GETPARAM, .len = sizeof(*tail) };
+   CHECK(ictx->base.base.submit_cmd(&ictx->base.base, stream,
+                                   req->hdr.len + sizeof(*tail)) < 0);
+   CHECK(exec_calls == calls);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 22) < 0);
+   ictx->base.base.destroy(&ictx->base.base);
+}
+
+static void check_physical_ownership(void)
+{
+   struct i915_context *ictx = make_context();
+   struct packet p;
+   int pipefd[2];
+   CHECK(pipe(pipefd) == 0);
+   output_read = pipefd[0];
+   expected_context = 9;
+   struct i915_ccmd_gem_execbuffer2_v3_req *req =
+      packet(&p, 1, 9, I915_EXEC_BSD | I915_EXEC_BSD_RING2 | I915_EXEC_HANDLE_LUT);
+   req->hdr.len = sizeof(p);
+   req->relocs_count = 1;
+   struct drm_i915_gem_exec_object2 *obj = (void *)req->payload;
+   obj->relocation_count = 1;
+   struct drm_i915_gem_relocation_entry *reloc = (void *)(obj + 1);
+   reloc->offset = 8;
+   reloc->read_domains = I915_GEM_DOMAIN_RENDER;
+   expected_relocs = 1;
+   CHECK(send_packet(ictx, req) == 0);
+   CHECK(ictx->rings[1].context_id == 9);
+   int physical = ictx->rings[1].physical_fd;
+   CHECK(physical >= 0 && ictx->pending_fence == I915_FENCE_PHYSICAL);
+   unsigned calls = exec_calls, before = atomic_load(&retired);
+   CHECK(ictx->base.base.submit_cmd(&ictx->base.base, req, req->hdr.len) == -EBUSY);
+   CHECK(exec_calls == calls && ictx->rings[1].physical_fd == physical);
+   CHECK(destroy_context(ictx, 9) == EBUSY);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 2, 30) < 0);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 0, 30) < 0);
+
+   /* Fail staging dup, FIFO dup, registry dup, then FIFO allocation. */
+   for (int i = 0; i < 3; i++) {
+      fail_dup_after = i;
+      CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 30) < 0);
+      CHECK(fcntl(physical, F_GETFD) >= 0);
+      CHECK(ictx->rings[1].physical_fd == physical);
+      CHECK(ictx->pending_fence == I915_FENCE_PHYSICAL);
+      CHECK(atomic_load(&retired) == before);
+   }
+   fail_calloc = true;
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 30) < 0);
+   CHECK(ictx->pending_fence == I915_FENCE_PHYSICAL);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 30) == 0);
+   CHECK(ictx->rings[1].physical_fd == physical);
+   struct packet duplicate;
+   CHECK(send_packet(ictx, packet(&duplicate, 2, 9,
+                                  I915_EXEC_BSD | I915_EXEC_BSD_RING2)) == EBUSY);
+   CHECK(!ictx->rings[2].context_id && exec_calls == calls);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 2, 29) == 0);
+   CHECK(atomic_load(&retired) == before + 1);
+   before++;
+
+   /* Rejected B must be behind the real pending A, never immediate retirement. */
+   kernel_error = EIO;
+   CHECK(send_packet(ictx, req) == EIO);
+   CHECK(((struct i915_shmem *)ictx->base.shmem)->banned_ctx_mask & (1ULL << 9));
+   CHECK(ictx->rings[1].physical_fd == physical);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 31) == 0);
+   CHECK(atomic_load(&retired) == before);
+   CHECK(destroy_context(ictx, 9) == EBUSY);
+   CHECK(ictx->rings[1].physical_fd == physical);
+   CHECK(write(pipefd[1], "x", 1) == 1);
+   wait_retired(before + 2);
+   CHECK(retired_ids[before] == 30 && retired_ids[before + 1] == 31);
+   /* Synchronize with callback removal (which follows callback invocation). */
+   mtx_lock(&ictx->timelines[1]->fence_mutex);
+   mtx_unlock(&ictx->timelines[1]->fence_mutex);
+   destroy_error = EIO;
+   CHECK(destroy_context(ictx, 9) == EIO);
+   CHECK(ictx->rings[1].physical_fd == physical);
+   CHECK(((struct i915_shmem *)ictx->base.shmem)->banned_ctx_mask & (1ULL << 9));
+   destroy_error = 0;
+   CHECK(destroy_context(ictx, 9) == 0);
+   CHECK(!ictx->rings[1].context_id && ictx->rings[1].physical_fd == -1);
+   CHECK(!(((struct i915_shmem *)ictx->base.shmem)->banned_ctx_mask & (1ULL << 9)));
+   CHECK(fcntl(physical, F_GETFD) == -1 && errno == EBADF);
+   kernel_error = 0;
+   req = packet(&p, 1, 10, I915_EXEC_RENDER);
+   expected_context = 10;
+   expected_relocs = 0;
+   CHECK(send_packet(ictx, req) == 0);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 32) == 0);
+   wait_retired(before + 3);
+   ictx->base.base.destroy(&ictx->base.base);
+   close(pipefd[0]);
+   close(pipefd[1]);
+}
+
+static void check_slots_and_uncertainty(void)
+{
+   struct i915_context *ictx = make_context();
+   struct packet p;
+   int pipefd[2];
+   CHECK(pipe(pipefd) == 0);
+   CHECK(write(pipefd[1], "x", 1) == 1);
+   output_read = pipefd[0];
+   unsigned before = atomic_load(&retired);
+   for (uint32_t i = 1; i < I915_V3_RING_COUNT; i++) {
+      expected_context = i;
+      struct i915_ccmd_gem_execbuffer2_v3_req *req = packet(&p, i, i, I915_EXEC_RENDER);
+      CHECK(send_packet(ictx, req) == 0);
+      CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, i, 40 + i) == 0);
+   }
+   wait_retired(before + 63);
+   unsigned calls = exec_calls;
+   struct i915_ccmd_gem_execbuffer2_v3_req *req = packet(&p, 1, 9, I915_EXEC_BSD);
+   CHECK(send_packet(ictx, req) == EBUSY); /* No occupied slot can be stolen. */
+   CHECK(ictx->rings[1].context_id == 1 && exec_calls == calls);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 104) == 0);
+   wait_retired(before + 64);
+   req = packet(&p, 2, 1, I915_EXEC_RENDER);
+   CHECK(send_packet(ictx, req) == EBUSY); /* Tuple already owned by slot 1. */
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 2, 105) == 0);
+   wait_retired(before + 65);
+   req = packet(&p, 64, 9, I915_EXEC_BSD);
+   CHECK(send_packet(ictx, req) == EINVAL);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 106) < 0);
+   CHECK(exec_calls == calls);
+   ictx->base.base.destroy(&ictx->base.base);
+   close(pipefd[0]);
+   close(pipefd[1]);
+
+   ictx = make_context();
+   req = packet(&p, 1, 9, I915_EXEC_BSD);
+   expected_context = 9;
+   omit_output = true;
+   CHECK(send_packet(ictx, req) == EIO);
+   CHECK(ictx->rings[1].context_id == 9 && ictx->rings[1].uncertain);
+   CHECK(ictx->pending_fence == I915_FENCE_PHYSICAL);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 107) < 0);
+   CHECK(destroy_context(ictx, 9) == EBUSY);
+   ictx->base.base.destroy(&ictx->base.base);
+   omit_output = false;
+}
+
+static void check_legacy_and_mode_isolation(void)
+{
+   struct i915_context *legacy = make_context();
+   struct i915_context *modern = make_context();
+   struct packet p, old;
+   int pipefd[2];
+   CHECK(pipe(pipefd) == 0);
+   CHECK(write(pipefd[1], "x", 1) == 1);
+   output_read = pipefd[0];
+   unsigned before = atomic_load(&retired);
+   for (unsigned version = 1; version <= 2; version++) {
+      memset(&old, 0, sizeof(old));
+      struct i915_ccmd_gem_execbuffer2_req *req = (void *)&old;
+      req->hdr = I915_CCMD(GEM_EXECBUFFER2, sizeof(*req) +
+                           sizeof(struct drm_i915_gem_exec_object2));
+      if (version == 2)
+         req->hdr.cmd = I915_CCMD_GEM_EXECBUFFER2_V2;
+      req->context_id = 2;
+      req->flags = I915_EXEC_RENDER;
+      req->buffer_count = 1;
+      ((struct drm_i915_gem_exec_object2 *)(void *)req->payload)->handle = 77;
+      expected_context = 2;
+      CHECK(send_packet(legacy, req) == 0);
+      uint32_t ring = version == 1 ? 2 : 10;
+      CHECK(legacy->base.base.submit_fence(&legacy->base.base, 0, ring, 110 + version) == 0);
+   }
+   wait_retired(before + 2);
+   struct i915_ccmd_gem_execbuffer2_v3_req *req =
+      packet(&p, 1, 9, I915_EXEC_BSD);
+   expected_context = 9;
+   CHECK(send_packet(modern, req) == 0); /* Different DRM descriptions coexist. */
+   CHECK(modern->base.base.submit_fence(&modern->base.base, 0, 1, 113) == 0);
+   wait_retired(before + 3);
+   unsigned calls = exec_calls;
+   CHECK(send_packet(legacy, req) == EINVAL);
+   CHECK(legacy->base.base.submit_fence(&legacy->base.base, 0, 1, 114) < 0);
+   CHECK(modern->base.base.submit_cmd(&modern->base.base, &old,
+                                     ((struct vdrm_ccmd_req *)(void *)&old)->len) < 0);
+   CHECK(exec_calls == calls);
+   legacy->base.base.destroy(&legacy->base.base);
+   modern->base.base.destroy(&modern->base.base);
+   close(pipefd[0]);
+   close(pipefd[1]);
+}
+
+static void check_completed_fence_pending_callback(void)
+{
+   struct i915_context *ictx = make_context();
+   struct packet p;
+   int pipefd[2];
+   CHECK(pipe(pipefd) == 0);
+   output_read = pipefd[0];
+   expected_context = 9;
+   CHECK(send_packet(ictx, packet(&p, 1, 9, I915_EXEC_BSD)) == 0);
+   int physical = ictx->rings[1].physical_fd;
+   unsigned before = atomic_load(&retired);
+   unsigned destroys = destroy_calls;
+
+   mtx_lock(&retire_mutex);
+   pause_next_poll = true;
+   poll_paused = false;
+   release_poll = false;
+   mtx_unlock(&retire_mutex);
+   CHECK(ictx->base.base.submit_fence(&ictx->base.base, 0, 1, 120) == 0);
+   struct timespec deadline;
+   timespec_get(&deadline, TIME_UTC);
+   deadline.tv_sec += 5;
+   mtx_lock(&retire_mutex);
+   while (!poll_paused)
+      CHECK(cnd_timedwait(&retire_cond, &retire_mutex, &deadline) == thrd_success);
+   mtx_unlock(&retire_mutex);
+
+   /* The actual worker is outside fence_mutex, immediately before blocking poll.
+    * Make the real pipe readable without allowing its FIFO callback to run.
+    */
+   CHECK(write(pipefd[1], "x", 1) == 1);
+   CHECK(destroy_context(ictx, 9) == EAGAIN);
+   CHECK(destroy_calls == destroys && atomic_load(&retired) == before);
+   CHECK(ictx->rings[1].context_id == 9 && ictx->rings[1].physical_fd == physical);
+   CHECK(fcntl(physical, F_GETFD) >= 0);
+
+   mtx_lock(&retire_mutex);
+   release_poll = true;
+   cnd_broadcast(&retire_cond);
+   mtx_unlock(&retire_mutex);
+   wait_retired(before + 1);
+   mtx_lock(&ictx->timelines[1]->fence_mutex);
+   mtx_unlock(&ictx->timelines[1]->fence_mutex);
+   CHECK(destroy_context(ictx, 9) == 0);
+   CHECK(destroy_calls == destroys + 1);
+   CHECK(!ictx->rings[1].context_id && ictx->rings[1].physical_fd == -1);
+   ictx->base.base.destroy(&ictx->base.base);
+   close(pipefd[0]);
+   close(pipefd[1]);
+}
+
+int main(void)
+{
+   CHECK(mtx_init(&retire_mutex, mtx_plain) == thrd_success);
+   CHECK(cnd_init(&retire_cond) == thrd_success);
+   CHECK(virgl_fence_table_init() == 0);
+   check_rejections();
+   check_physical_ownership();
+   check_slots_and_uncertainty();
+   check_legacy_and_mode_isolation();
+   check_completed_fence_pending_callback();
+   virgl_fence_table_cleanup();
+   cnd_destroy(&retire_cond);
+   mtx_destroy(&retire_mutex);
+   puts("i915 V3 production packet/response/ownership checks passed (CPU only)");
+   return 0;
+}
