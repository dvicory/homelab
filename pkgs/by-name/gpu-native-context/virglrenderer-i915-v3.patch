+/* Validate the entire stream before dispatch can reach an execution ioctl. */
+static int
+i915_renderer_submit_cmd(struct virgl_context *vctx, const void *buffer, size_t size)
+{
+   struct i915_context *ictx = to_i915_context(to_drm_context(vctx));
+   const uint8_t *next = buffer;
+   size_t remaining = size;
+
+   if (size > UINT32_MAX)
+      goto malformed;
+
+   while (remaining >= sizeof(struct vdrm_ccmd_req)) {
+      struct vdrm_ccmd_req hdr;
+      memcpy(&hdr, next, sizeof(hdr));
+      if (hdr.len < sizeof(hdr) || hdr.len > remaining ||
+          (hdr.len & 3) || (hdr.rsp_off & 3))
+         goto malformed;
+      if (hdr.cmd == I915_CCMD_GEM_EXECBUFFER2_V3 &&
+          (remaining != size || hdr.len != size ||
+           size < sizeof(struct i915_ccmd_gem_execbuffer2_v3_req)))
+         goto malformed;
+      if ((hdr.cmd == I915_CCMD_GEM_EXECBUFFER2 ||
+           hdr.cmd == I915_CCMD_GEM_EXECBUFFER2_V2 ||
+           hdr.cmd == I915_CCMD_GEM_EXECBUFFER2_V3) &&
+          (ictx->pending_fence != I915_FENCE_NONE || ictx->association_failed))
+         return -EBUSY;
+      next += hdr.len;
+      remaining -= hdr.len;
+   }
+   if (remaining)
+      goto malformed;
+
+   int ret = ictx->submit_cmd(vctx, buffer, size);
+   if (ret)
+      ictx->association_failed = true;
+   return ret;
+
+malformed:
+   ictx->association_failed = true;
+   return -EINVAL;
+}
+
+int
+i915_context_check_destroy(struct i915_context *ictx, uint32_t context_id)
+{
+   if (ictx->exec_mode != I915_EXEC_MODE_V3)
+      return 0;
+   if (ictx->pending_fence != I915_FENCE_NONE || ictx->association_failed)
+      return EBUSY;
+   bool callbacks_pending = false;
+
+   for (unsigned i = 1; i < ARRAY_SIZE(ictx->rings); i++) {
+      struct i915_ring_binding *ring = &ictx->rings[i];
+      if (ring->context_id != context_id)
+         continue;
+      if (ring->uncertain || ring->physical_fd < 0)
+         return EBUSY;
+      struct pollfd pfd = { .fd = ring->physical_fd, .events = POLLIN };
+      if (poll(&pfd, 1, 0) != 1 || pfd.revents != POLLIN)
+         return EBUSY;
+
+      /* An old callback must not retire a newer binding's transport fence. */
+      struct drm_timeline *timeline = ictx->timelines[i];
+      mtx_lock(&timeline->fence_mutex);
+      bool empty = list_is_empty(&timeline->pending_fences);
+      mtx_unlock(&timeline->fence_mutex);
+      callbacks_pending |= !empty;
+   }
+   /* Physical work is complete; upstream drmIoctl retries this bookkeeping race. */
+   return callbacks_pending ? EAGAIN : 0;
+}
