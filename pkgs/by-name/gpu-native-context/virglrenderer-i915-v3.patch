+{
+   if (ictx->exec_mode != I915_EXEC_MODE_V3)
+      return;
+   for (unsigned i = 1; i < ARRAY_SIZE(ictx->rings); i++) {
+      struct i915_ring_binding *ring = &ictx->rings[i];
+      if (ring->context_id != context_id)
+         continue;
+      if (ring->physical_fd >= 0)
+         close(ring->physical_fd);
+      *ring = (struct i915_ring_binding) { .physical_fd = -1 };
+      drm_timeline_set_last_fence_fd(ictx->timelines[i], -1);
+   }
