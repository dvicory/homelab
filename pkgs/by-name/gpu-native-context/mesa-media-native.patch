+static int
+i915_virtio_media_reserve_ring(struct intel_virtio_device *dev,
+                             const struct drm_i915_gem_execbuffer2 *exec,
+                             unsigned *ring_idx)
+{
+   uint32_t selector = exec->flags & (I915_EXEC_RING_MASK | I915_EXEC_BSD_MASK);
+   unsigned engine = selector & I915_EXEC_RING_MASK;
+   unsigned bsd = selector & I915_EXEC_BSD_MASK;
+   if (!exec->rsvd1 || exec->rsvd1 > I915_V3_MAX_CONTEXT_ID ||
+       engine > I915_EXEC_VEBOX ||
+       (bsd && engine != I915_EXEC_BSD) || bsd == I915_EXEC_BSD_MASK)
+      return EINVAL;
+
+   unsigned free_ring = 0;
+   for (unsigned i = 1; i < ARRAY_SIZE(dev->media_exec_slots); i++) {
+      if (dev->media_exec_slots[i].context_id == exec->rsvd1 &&
+          dev->media_exec_slots[i].selector == selector) {
+         *ring_idx = i;
+         return 0;
+      }
+      if (!dev->media_exec_slots[i].context_id && !free_ring)
+         free_ring = i;
+   }
+   if (!free_ring)
+      return ENOSPC;
+
+   dev->media_exec_slots[free_ring].context_id = exec->rsvd1;
+   dev->media_exec_slots[free_ring].selector = selector;
+   *ring_idx = free_ring;
+   return 0;
+}
 
