+static int
+i915_virtio_gem_context_destroy(struct intel_virtio_device *dev,
+                               unsigned cmd,
+                               struct drm_i915_gem_context_destroy *destroy)
+{
+   /* media_lock serializes these slots with the private V3 submit path.
+    * Unlike vdrm's void wait_fence hook, retirement must check wait errors.
+    * Keep even successfully waited fds until the real destroy succeeds.
+    */
+   for (unsigned i = 1; i < ARRAY_SIZE(dev->media_exec_slots); i++) {
+      if (dev->media_exec_slots[i].context_id == destroy->ctx_id &&
+          dev->media_exec_slots[i].last_fence_fd >= 0 &&
+          sync_wait(dev->media_exec_slots[i].last_fence_fd, -1))
+         return errno;
+   }
+
+   int ret = i915_virtio_simple_ioctl(dev, cmd, destroy);
+   if (ret)
+      return ret;
+
+   for (unsigned i = 1; i < ARRAY_SIZE(dev->media_exec_slots); i++) {
+      if (dev->media_exec_slots[i].context_id != destroy->ctx_id)
+         continue;
+      if (dev->media_exec_slots[i].last_fence_fd >= 0)
+         close(dev->media_exec_slots[i].last_fence_fd);
+      dev->media_exec_slots[i].last_fence_fd = -1;
+      dev->media_exec_slots[i].context_id = 0;
+      dev->media_exec_slots[i].selector = 0;
+   }
    return 0;
 }
 
