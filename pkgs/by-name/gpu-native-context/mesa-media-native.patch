+/* SPDX-License-Identifier: MIT */
+#include "intel_virtio_priv.h"
+#include "intel/dev/intel_device_info.h"
+#include "drm-uapi/virtgpu_drm.h"
+#include <pthread.h>
+
+/* ponytail: serialize media requests; use per-device locks if contention matters. */
+static pthread_mutex_t media_lock = PTHREAD_MUTEX_INITIALIZER;
+extern int intel_virtio_ioctl(int fd, unsigned long cmd, void *req);
+#define PUBLIC __attribute__((visibility("default")))
+PUBLIC int mos_i915_virtio_probe(int fd, uint32_t *pci_id);
+PUBLIC int mos_i915_virtio_acquire(int fd, bool *has_set_pat);
+PUBLIC void mos_i915_virtio_release(int fd);
+PUBLIC int mos_i915_virtio_ioctl(int fd, unsigned long cmd, void *arg);
+PUBLIC void *mos_i915_virtio_map(int fd, uint32_t handle, size_t size);
+
+/* Discovery owns no transport or fd: VA may open temporary displays before
+ * creating a buffer manager. GEM namespaces live in Mesa's existing fd cache.
+ */
+static int
+media_get_caps(int fd, struct virgl_renderer_capset_drm *caps)
+{
+   drmVersionPtr version = drmGetVersion(fd);
+   if (!version)
+      return -1;
+   bool virtio = !strcmp(version->name, "virtio_gpu");
+   drmFreeVersion(version);
+   if (!virtio)
+      return 0;
+   memset(caps, 0, sizeof(*caps));
+   struct drm_virtgpu_get_caps args = {
+      .cap_set_id = VIRTGPU_DRM_CAPSET_DRM,
+      .cap_set_ver = 0,
+      .addr = (uintptr_t)caps,
+      .size = sizeof(*caps),
+   };
+   if (ioctl(fd, DRM_IOCTL_VIRTGPU_GET_CAPS, &args))
+      return -1;
+   if (caps->context_type != VIRTGPU_DRM_CONTEXT_I915 ||
+       (caps->wire_format_version != 2 && caps->wire_format_version != 3) ||
+       !caps->u.intel.pci_device_id) {
+      errno = EOPNOTSUPP;
+      return -1;
+   }
+   return 1;
+}
+
+PUBLIC int
+mos_i915_virtio_probe(int fd, uint32_t *pci_id)
+{
+   struct virgl_renderer_capset_drm caps;
+   if (media_get_caps(fd, &caps) != 1)
+      return 0;
+   if (pci_id)
+      *pci_id = caps.u.intel.pci_device_id;
+   return 1;
+}
+
+PUBLIC int
+mos_i915_virtio_acquire(int fd, bool *has_set_pat)
+{
+   struct virgl_renderer_capset_drm caps;
+   int ret = media_get_caps(fd, &caps);
+   if (ret != 1)
+      return ret;
+   pthread_mutex_lock(&media_lock);
+   if (fd_to_intel_virtio_device(fd)) {
+      intel_virtio_ref_fd(fd);
+   } else {
+      ret = intel_virtio_init_fd(fd);
+      if (ret != 1) {
+         errno = ret < 0 ? -ret : ENODEV;
+         ret = -1;
+         goto out;
+      }
+   }
+   struct intel_virtio_device *dev = fd_to_intel_virtio_device(fd);
+   struct intel_device_info info;
+   if (!dev || dev->vpipe || !intel_get_device_info_from_fd(dev->fd, &info, 0, 0)) {
+      intel_virtio_unref_fd(fd);
+      errno = ENODEV;
+      ret = -1;
+      goto out;
+   }
+   *has_set_pat = info.has_set_pat_uapi;
+   fprintf(stderr, "iHD native i915 context=%u wire=%u PCI=%04x revision=%u set_pat=%d\n",
+           caps.context_type, caps.wire_format_version, caps.u.intel.pci_device_id,
+           caps.u.intel.pci_revision_id, info.has_set_pat_uapi);
+out:
+   pthread_mutex_unlock(&media_lock);
+   return ret;
+}
+
+PUBLIC void
+mos_i915_virtio_release(int fd)
+{
+   pthread_mutex_lock(&media_lock);
+   intel_virtio_unref_fd(fd);
+   pthread_mutex_unlock(&media_lock);
+}
+
+static int
+media_create_ext_validate(const struct drm_i915_gem_create_ext *create)
+{
+   const struct i915_user_extension *ext = (void *)(uintptr_t)create->extensions;
+   unsigned count = 0;
+   while (ext) {
+      if (++count > 16)
+         return E2BIG;
+      if (ext->name == I915_GEM_CREATE_EXT_SET_PAT) {
+         const struct drm_i915_gem_create_ext_set_pat *pat = (const void *)ext;
+         /* The pinned renderer maps only PAT 0 (WB) and 1 (WC) faithfully. */
+         if (pat->pat_index > 1) {
+            fprintf(stderr, "iHD native unsupported mapping PAT=%u\n", pat->pat_index);
+            return EOPNOTSUPP;
+         }
+      }
+      ext = (void *)(uintptr_t)ext->next_extension;
+   }
+   return 0;
+}
+
+PUBLIC int
+mos_i915_virtio_ioctl(int fd, unsigned long cmd, void *arg)
+{
+   int ret;
+   pthread_mutex_lock(&media_lock);
+   struct intel_virtio_device *dev = fd_to_intel_virtio_device(fd);
+   if (!dev) {
+      drmVersionPtr version = drmGetVersion(fd);
+      bool native = version && (!strcmp(version->name, "i915") ||
+                                !strcmp(version->name, "xe"));
+      drmFreeVersion(version);
+      if (native)
+         ret = ioctl(fd, cmd, arg);
+      else {
+         errno = EXDEV;
+         ret = -1;
+      }
+      goto out;
+   }
+   if (cmd == DRM_IOCTL_I915_GEM_CREATE_EXT) {
+      errno = media_create_ext_validate(arg);
+      if (errno) {
+         ret = -1;
+         goto out;
+      }
+   }
+   /* FIXED preserves the allocation's WB/WC type. The pinned renderer's
+    * setter instead chooses WC; the actual BO map still validates the handle.
+    */
+   if (cmd == DRM_IOCTL_I915_GEM_MMAP_OFFSET &&
+       ((const struct drm_i915_gem_mmap_offset *)arg)->flags == I915_MMAP_OFFSET_FIXED) {
+      ret = 0;
+      goto out;
+   }
+   if (dev->vdrm->caps.wire_format_version == 3 &&
+       (cmd == DRM_IOCTL_I915_GEM_EXECBUFFER2 ||
+        cmd == DRM_IOCTL_I915_GEM_EXECBUFFER2_WR)) {
+      int saved_errno = errno;
+      int error = i915_virtio_gem_execbuffer2(dev, arg, true);
+      ret = error ? -1 : 0;
+      errno = error ? error : saved_errno;
+   } else {
+      ret = intel_virtio_ioctl(dev->fd, cmd, arg);
+   }
+   if (ret) {
+      int error = errno;
+      fprintf(stderr, "iHD native ioctl=0x%lx nr=0x%lx errno=%d\n", cmd,
+              (unsigned long)_IOC_NR(cmd), error);
+      if (cmd == DRM_IOCTL_I915_GEM_CONTEXT_GETPARAM ||
+          cmd == DRM_IOCTL_I915_GEM_CONTEXT_SETPARAM) {
+         const struct drm_i915_gem_context_param *param = arg;
+         fprintf(stderr, "iHD native context id=%u param=0x%llx size=%u value=0x%llx\n",
+                 param->ctx_id, (unsigned long long)param->param, param->size,
+                 (unsigned long long)param->value);
+      }
+      if (cmd == DRM_IOCTL_I915_GEM_EXECBUFFER2 ||
+          cmd == DRM_IOCTL_I915_GEM_EXECBUFFER2_WR) {
+         const struct drm_i915_gem_execbuffer2 *exec = arg;
+         fprintf(stderr, "iHD native exec flags=0x%llx context=%llu rsvd2=0x%llx\n",
+                 (unsigned long long)exec->flags, (unsigned long long)exec->rsvd1,
+                 (unsigned long long)exec->rsvd2);
+      }
+      errno = error;
+   }
+out:
+   pthread_mutex_unlock(&media_lock);
+   return ret;
+}
+
+PUBLIC void *
+mos_i915_virtio_map(int fd, uint32_t handle, size_t size)
+{
+   void *ptr;
+   pthread_mutex_lock(&media_lock);
+   struct intel_virtio_device *dev = fd_to_intel_virtio_device(fd);
+   if (!dev || !size) {
+      errno = EINVAL;
+      ptr = MAP_FAILED;
+   } else {
+      ptr = intel_virtio_bo_mmap(dev->fd, handle, size, NULL);
+   }
+   pthread_mutex_unlock(&media_lock);
+   return ptr;
+}
