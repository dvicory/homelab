+++ b/media_driver/linux/ult/media_native_error_check.cpp
@@ -0,0 +1,180 @@
+/* SPDX-License-Identifier: MIT
+ * CPU-only negative-path check. Compile the exact selected MOS implementation;
+ * Boundary aliases inject errors, never successful GPU work or completion.
+ */
+#include <cstdio>
+#include <cstdlib>
+#define drmIoctl media_check_ioctl
+#include MOS_NATIVE_SOURCE
+#undef drmIoctl
+
+#define CHECK(expr) do { if (!(expr)) { \
+    std::fprintf(stderr, "negative check failed: %s at %d\n", #expr, __LINE__); \
+    std::abort(); \
+} } while (0)
+
+static struct mos_bufmgr_gem *active_manager;
+static int injected_error = EIO;
+static unsigned creates, creates_ext, waits, domains;
+
+
+
+extern "C" int media_check_ioctl(int fd, unsigned long command, void *arg)
+{
+    CHECK(fd == -1);
+    switch (command) {
+    case DRM_IOCTL_I915_GEM_CREATE: ++creates; break;
+    case DRM_IOCTL_I915_GEM_CREATE_EXT:
+        ++creates_ext;
+        if (!active_manager->native_has_pat) {
+            const auto *create = static_cast<const drm_i915_gem_create_ext *>(arg);
+            auto *ext = reinterpret_cast<const i915_user_extension *>(create->extensions);
+            while (ext) {
+                if (ext->name == I915_GEM_CREATE_EXT_SET_PAT) {
+                    errno = ENODEV; // The actual DG2 kernel rejects this extension.
+                    return -1;
+                }
+                ext = reinterpret_cast<const i915_user_extension *>(ext->next_extension);
+            }
+        }
+        break;
+    case DRM_IOCTL_I915_GEM_WAIT: ++waits; break;
+    case DRM_IOCTL_I915_GEM_SET_DOMAIN: ++domains; break;
+    case DRM_IOCTL_I915_GEM_MADVISE:
+        if (active_manager->native)
+            return 0; // Mesa leaves the caller's retained field untouched.
+        break;
+    default: CHECK(false);
+    }
+    errno = injected_error;
+    return -1;
+}
+
+static void reset_calls()
+{
+    creates = creates_ext = waits = domains = 0;
+}
+
+static void check_pat(struct mos_bufmgr_gem &manager)
+{
+    mos_drm_bo_alloc request;
+    request.size = 4096;
+    request.ext.pat_index = 2;
+    for (bool local : { false, true }) {
+        manager.has_lmem = local;
+        request.ext.mem_type = local ? MOS_MEMPOOL_VIDEOMEMORY : 0;
+        reset_calls();
+        CHECK(mos_gem_bo_alloc_internal(&manager.bufmgr, &request) == nullptr);
+        CHECK(errno == EOPNOTSUPP && request.ext.pat_index == 2);
+        CHECK(creates == 0 && creates_ext == 0);
+    }
+    manager.has_lmem = false;
+    request.ext.mem_type = 0;
+
+    // A physical-driver failure may disable its static PAT support heuristic.
+    manager.native = false;
+    request.ext.pat_index = 0;
+    reset_calls();
+    CHECK(mos_gem_bo_alloc_internal(&manager.bufmgr, &request) == nullptr);
+    CHECK(creates_ext == 1 && creates == 1);
+
+    // Native explicit PAT must still be tried and its failure never retried
+    // without PAT, including after the physical-driver heuristic changed.
+    manager.native = true;
+    for (unsigned pat : { 0u, 1u }) {
+        request.ext.pat_index = pat;
+        reset_calls();
+        CHECK(mos_gem_bo_alloc_internal(&manager.bufmgr, &request) == nullptr);
+        CHECK(errno == injected_error && request.ext.pat_index == pat);
+        CHECK(creates_ext == 1 && creates == 0);
+    }
+    // DG2 still uses region extensions, but never its unsupported PAT UAPI.
+    manager.native_has_pat = false;
+    for (bool local : { false, true }) {
+        manager.has_lmem = local;
+        request.ext.mem_type = local ? MOS_MEMPOOL_VIDEOMEMORY : 0;
+        request.ext.pat_index = 0;
+        reset_calls();
+        CHECK(mos_gem_bo_alloc_internal(&manager.bufmgr, &request) == nullptr);
+        CHECK(errno == injected_error);
+        CHECK(creates_ext == unsigned(local) && creates == unsigned(!local));
+    }
+    manager.has_lmem = false;
+    manager.native_has_pat = true;
+}
+
+static void check_mapping(struct mos_bufmgr_gem &manager)
+{
+    unsigned char storage[4096] = {};
+    mos_bo_gem object = {};
+    object.bo.bufmgr = &manager.bufmgr;
+    object.bo.size = sizeof(storage);
+    object.gem_handle = 1;
+    object.mem_virtual = storage;
+    object.mem_wc_virtual = storage;
+    object.gtt_virtual = storage;
+    object.cpu_cacheable = true;
+    manager.has_ext_mmap = true;
+    manager.has_wait_timeout = true;
+    auto cached_map = +[](mos_linux_bo *bo) { return mos_gem_bo_map(bo, 1); };
+    int (*maps[])(mos_linux_bo *) = { cached_map, mos_gem_bo_map_wc, mos_gem_bo_map_gtt };
+    for (int error : { EIO, EACCES, EINTR }) {
+        injected_error = error;
+        for (bool wait_path : { false, true }) {
+            manager.has_lmem = wait_path;
+            manager.has_mmap_offset = wait_path;
+            for (auto map : maps) {
+                reset_calls();
+                object.bo.virt = storage; // stale public pointer must not survive
+                CHECK(map(&object.bo) == -error);
+                CHECK(object.bo.virt == nullptr);
+                CHECK(!object.mapped_cpu_write && object.map_count == 0);
+                CHECK(waits == unsigned(wait_path));
+                CHECK(domains == unsigned(!wait_path));
+                CHECK(pthread_mutex_trylock(&manager.lock) == 0);
+                pthread_mutex_unlock(&manager.lock);
+            }
+        }
+    }
+    // The LLC unsynchronized API must still publish its cached map without
+    // issuing a wait/domain ioctl. This is CPU storage, not simulated GPU work.
+    manager.has_llc = true;
+    reset_calls();
+    CHECK(mos_gem_bo_map_unsynchronized(&object.bo) == 0);
+    CHECK(object.bo.virt == storage && waits == 0 && domains == 0);
+    CHECK(pthread_mutex_trylock(&manager.lock) == 0);
+    pthread_mutex_unlock(&manager.lock);
+}
+
+static void check_advice(struct mos_bufmgr_gem &manager)
+{
+    struct mos_bo_gem object = {};
+    object.gem_handle = 1;
+    object.reusable = true;
+    manager.native = true;
+    const int states[] = { I915_MADV_DONTNEED, I915_MADV_WILLNEED };
+    for (int state : states)
+        CHECK(mos_gem_bo_madvise_internal(&manager, &object, state) == 1);
+    object.reusable = false;
+    CHECK(mos_gem_bo_madvise_internal(&manager, &object, I915_MADV_WILLNEED) == 0);
+    object.reusable = true;
+    manager.native = false;
+    injected_error = EIO;
+    CHECK(mos_gem_bo_madvise_internal(&manager, &object, I915_MADV_WILLNEED) == 0);
+    CHECK(errno == EIO);
+    manager.native = true;
+}
+
+int main()
+{
+    struct mos_bufmgr_gem manager = {};
+    manager.fd = -1;
+    active_manager = &manager;
+    manager.native = manager.native_has_pat = true;
+    CHECK(pthread_mutex_init(&manager.lock, nullptr) == 0);
+    check_pat(manager);
+    check_advice(manager);
+    check_mapping(manager);
+    CHECK(pthread_mutex_destroy(&manager.lock) == 0);
+    std::puts("MOS exact-source PAT, backing-retention and synchronized-map checks passed (CPU only)");
+}
