+
+    [Theory]
+    [InlineData("{}")] // no administrator at all
+    [InlineData("""{ "Administrator": { "Name": "admin" } }""")] // no password
+    [InlineData("""{ "Administrator": { "Password": "hunter2" } }""")] // no name
