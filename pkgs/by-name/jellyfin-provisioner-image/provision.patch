+
+    [Theory]
+    [InlineData("null", "empty")]
+    [InlineData("""{ "Administrator": { "Name": " ", "Password": "hunter2" } }""", "Administrator.Name")]
+    [InlineData("""{ "Administrator": { "Name": "admin", "Password": "" } }""", "Administrator.Password")]
