# Generates the operator media runbook from policy JSON and public Arr settings.
{
  config,
  lib,
  ...
}:
let
  media = config.den.clusters.prod-home.settings.kubernetes.services.media;
  source = builtins.fromJSON (builtins.readFile ../../../assets/media-policy/source.json);
  preferred = builtins.fromJSON (builtins.readFile ../../../assets/media-policy/hd-preferred.json);
  preferredName = source.profiles.radarr."hd-preferred".name;
  quote = value: "`${value}`";
  revisionLink =
    repository: revision: "[`${builtins.substring 0 7 revision}`](${repository}/tree/${revision})";
  instances = lib.concatMap (
    kind: lib.mapAttrsToList (name: cfg: { inherit kind name cfg; }) media.${kind}
  ) (builtins.attrNames source.profiles);
  instanceRows = map (
    instance:
    let
      cfg = instance.cfg;
      profiles = source.profiles.${instance.kind};
      menu = lib.concatMapStringsSep ", " (key: quote profiles.${key}.name) cfg.qualityProfiles;
      default =
        if cfg.role == null then
          "not offered in Seerr"
        else
          quote profiles.${cfg.defaultQualityProfile}.name;
    in
    "| `${instance.kind}` | `${instance.name}` | ${menu} | ${default} |"
  ) instances;
  qualityRows = map (
    quality:
    "- `${quality.name}`"
    +
      lib.optionalString (quality ? qualities)
        " (${lib.concatMapStringsSep ", " quote quality.qualities}; one group)"
  ) preferred.qualities;
in
{
  perSystem =
    { ... }:
    {
      files.file."docs/operations/media.md".text = ''
        <!-- provenance: generated by modules/flake/docs/media.nix; edit that source and run nix run .#write-files. -->
        # Media operations

        ## Access and recovery

        Open Radarr, Sonarr, Prowlarr and SABnzbd from their Kanidm tiles. The
        Gateway requires membership in `homelab-admin`; the applications themselves
        have no browser login. Their APIs still require their own API keys.
        Open Seerr at the requests route listed in
        [Household operations](../operations.md#declared-routes), and use its native
        Jellyfin sign-in rather than Gateway OIDC.

        If Gateway or Kanidm is unavailable, use the host's cluster access with the
        Service and port from the
        [route/backend table](../operations.md#declared-routes):

        ```sh
        kubectl -n media port-forward svc/<app> <port>
        ```

        Port-forwarding bypasses NetworkPolicy. Forwarded Radarr, Sonarr, Prowlarr
        and SABnzbd ports still have no browser login; treat that access like the
        cluster access it comes from and do not expose it to other users. Do not
        broaden NetworkPolicy or media-directory modes to fix access. Arr and
        SABnzbd receive media access through their declared group.

        SABnzbd's managed download permissions are `2770`: directories retain
        setgid and inherit the shared media group; completed files use `660`.
        Do not replace this with `770`, which breaks group inheritance for later
        downloads. This policy covers fresh downloads; it does not repair existing
        content with incorrect ownership or permissions.

        ## Choose profiles

        The current managed menus and defaults are:

        | App | Instance | Profiles in the UI | New Seerr request default |
        | --- | --- | --- | --- |
        ${lib.concatStringsSep "\n" instanceRows}

        Choose the mixed-source `${preferredName}` profile for ordinary requests.
        The WEB-only choice deliberately excludes Blu-ray, HDTV and SD fallback.
        Choose the HD remux profile only when its larger releases are wanted; it is
        not the default. None of these profiles allows 2160p.

        Defaults apply to **new Seerr requests**. They do not reassign existing
        movies or series: change an existing title's profile explicitly in Arr if
        that is intended. Reconciliation does not issue search or download
        commands; changed policy can affect later normal Arr decisions.
        For a persistent menu/default change, edit the declared `qualityProfiles`
        and `defaultQualityProfile` settings rather than changing a managed Seerr
        server by hand.

        `${preferredName}` has the same declared fallback ladder in both apps,
        highest preference first. Members of one group share a quality preference:

        ${lib.concatStringsSep "\n" qualityRows}

        Upgrades target `${preferred.upgrade.until_quality}`, with minimum
        custom-format upgrade increment `${toString preferred.upgrade.min_format_score}`.
        DVD here is encoded DVD, not DVD-R/full-disc images. CAM, screeners, unknown,
        raw/full-disc and low-resolution Blu-ray qualities remain excluded.

        An allowed quality is not sufficient to accept a release. The unwanted-format
        penalties still apply: non-2160p x265 and AV1 can score below the minimum even
        for an allowed SD quality. Radarr and Sonarr intentionally have app-specific
        formats and scores, so a shared quality ladder does not mean identical
        release preferences. Review those differences before changing policy.

        Configarr reconciles managed profile names, quality structure and scores,
        but pinned Configarr 1.32 does **not** repair allowed-checkbox-only drift
        when names/grouping/order still match. Inspect allowed qualities after a
        policy change; do not expect a scheduled run to undo that isolated UI edit.

        ## Update managed policy

        The current source pins are TRaSH ${revisionLink source.repository source.revision}
        and templates ${revisionLink source.templateRepository source.templateRevision}.
        Their declarations and selected profiles are in
        [`source.json`](../../assets/media-policy/source.json); the shared fallback
        ladder is in [`hd-preferred.json`](../../assets/media-policy/hd-preferred.json).
        Per-app default/zero scores and exclusions are selected in
        [`required-formats.json`](../../assets/media-policy/required-formats.json).

        1. Review the candidate upstream changes. In `source.json`, update `revision`
           and/or `templateRevision` to full immutable Git commit SHAs; unchanged
           repositories need no pin bump. Keep a template revision compatible with
           Configarr 1.32's legacy template layout. Review selected profile IDs and
           each app's resulting qualities, custom formats and scores; a new SHA is
           not approval of changed guide preferences.
        2. Use [Deploy configuration](../operations.md#deploy-configuration) for
           manifest regeneration, tracking and deployment. This page is generated
           too; refresh and inspect it after changing the policy sources:

           ```sh
           nix run .#write-files
           nix run .#diff-files
           ```

           These commands cover all configured generated files, not a selected
           filename. Edit the JSON sources, not a rendered ConfigMap or cached Git
           checkout, and review the whole generated diff.
        3. Changing either pin selects a new cache namespace automatically; normal
           pin updates need no cache deletion. Ensure cold source access is
           available before deployment. Afterward, confirm Configarr and Seerr
           succeed and inspect the actual profile qualities, cutoff and scores
           in both apps.

        ## Reconciliation failures

        Configarr and the Seerr helper run after configuration sync and every six
        hours. First list actual Jobs and select the failed run:

        ```sh
        kubectl -n media get jobs --sort-by=.metadata.creationTimestamp
        ```

        PostSync Jobs use the fixed names `media-configarr` and
        `media-config-seerr`; scheduled executions have generated suffixes.
        Read the selected failed Job, not a possibly unrelated fixed-name run:

        ```sh
        kubectl -n media logs job/<failed-job-name>
        ```

        Repair an unhealthy dependency, rejected API write, missing retained mount
        or required credential before trying again. Do not create replacement
        application state or widen permissions to bypass a refusal. Use the
        retained-state and runtime-secret guidance in [Household operations](../operations.md)
        when restoring a mount or credential; never publish secret values.

        After repair, sync `media-configuration` again to rerun its PostSync Jobs.
        The Seerr helper requires healthy Jellyfin/Arr services, completed Jellyfin
        configuration and successful Configarr reconciliation. `Run Configarr
        before Seerr` means its declared profile does not exist yet.

        Managed connection records end in `(Homelab)`: `SABnzbd (Homelab)` in Arr,
        and `Radarr (Homelab)` / `Sonarr (Homelab)` in Seerr. Do not rename or edit
        these records by hand; reconciliation owns them. Other clients and servers
        are left alone, although Seerr clears another server's default flag when
        selecting the managed default for that tier.

        ### Source cache and offline recovery

        Both policy repositories live below
        `/coordination/configarr-repos/<guide SHA>-<template SHA>` on the
        integration-owned `media-seerr-configuration` claim. This is disposable
        performance state, not an Arr catalogue, Seerr identity or media library.
        The Jobs share the same process-held Configarr lock.

        A missing cache needs DNS/HTTPS access to the declared repositories. A warm
        partial clone can still need an absent object; immutable SHAs do not
        guarantee origin availability. **This configuration does not provide fully
        offline cold bootstrap.** Do not plan an offline restore from pins alone
        or treat the cache as a backup of application state.

        Old pin-pair directories are not collected automatically and have no growth
        bound; the PV capacity declaration is not a filesystem quota. Normal pin
        updates need no deletion. For source failures, check the declared revisions,
        repository access and Job logs, and preserve any surviving cache. Never
        delete coordination, lock files or retained application state as a workaround.

        ## Seerr first-owner and publication recovery

        In the `initial` publication phase the requests route is withheld. Only the
        PostSync Seerr Job may claim the first owner; its scheduled Job cannot.
        Fresh state uses the declared Jellyfin administrator. Initialized state
        keeps its existing owner: changing the declared administrator does not
        transfer ownership.

        1. Confirm the Seerr Job succeeds:

           ```sh
           kubectl -n media get job media-config-seerr
           ```

        2. Forward Seerr in one terminal:

           ```sh
           kubectl -n media port-forward service/seerr 5055:5055
           ```

           In another, confirm `initialized` is `true`:

           ```sh
           curl -s http://localhost:5055/api/v1/settings/public
           ```

        3. Sign in as the retained Seerr owner through the forwarded port. Check the
           declared Jellyfin libraries and the managed Arr services/defaults. Read
           the declared selections if needed:

           ```sh
           kubectl -n media get configmap media-configuration \
             -o jsonpath='{.data.seerr\.json}'
           ```

        4. Only then set `settings.kubernetes.services.seerr.phase = "ready"` in
           `modules/den/clusters/home.nix`, regenerate, review and deploy using the
           normal configuration procedure. This publishes the native sign-in route
           and removes first-owner authority without replacing retained state.

        If initialization is still false, repair the Job failure rather than
        completing the setup page by hand. Never publish the fresh setup page or
        reset retained Seerr state merely to obtain a new owner.
      '';
    };
}
