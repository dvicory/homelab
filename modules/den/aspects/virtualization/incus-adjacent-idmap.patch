+func TestEntryHostIDsIntersect(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		start      int64
+		size       int64
+		intersects bool
+	}{
+		{"adjacent below", 90, 10, false},
+		{"adjacent above", 110, 10, false},
+		{"overlap below", 99, 10, true},
+		{"overlap above", 109, 10, true},
+		{"equal", 100, 10, true},
+		{"contained", 102, 2, true},
+		{"containing", 99, 12, true},
+		{"single ID", 100, 1, true},
+		{"empty inside", 105, 0, false},
+		{"empty boundary", 100, 0, false},
+		{"empty outside", 120, 0, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			for _, kind := range []Entry{{IsUID: true}, {IsGID: true}, {IsUID: true, IsGID: true}} {
+				e, i := kind, kind
+				e.HostID, e.MapRange = 100, 10
+				i.HostID, i.MapRange = tc.start, tc.size
+				assert.Equal(t, tc.intersects, e.HostIDsIntersect(i))
+				assert.Equal(t, tc.intersects, i.HostIDsIntersect(e))
+				assert.Equal(t, tc.intersects, (&Set{Entries: []Entry{e}}).HostIDsIntersect(i))
+			}
+		})
+	}
+
+	uid := Entry{IsUID: true, HostID: 100, MapRange: 10}
+	gid := Entry{IsGID: true, HostID: 100, MapRange: 10}
+	assert.False(t, uid.HostIDsIntersect(gid))
+	assert.False(t, gid.HostIDsIntersect(uid))
+	assert.False(t, uid.HostIDsIntersect(Entry{HostID: 100, MapRange: 10}))
+}
+
+func TestSetAddSafeAdjacentHostRanges(t *testing.T) {
+	original := Set{Entries: []Entry{
+		{IsUID: true, HostID: 1065536, NSID: 0, MapRange: 65536},
+		{IsGID: true, HostID: 1065536, NSID: 0, MapRange: 65536},
+	}}
+	replacement := Entry{IsUID: true, IsGID: true, HostID: 1000000, NSID: 0, MapRange: 65536}
+	assert.NoError(t, original.AddSafe(replacement))
+	assert.Equal(t, []string{"u 0 1000000 65536", "g 0 1000000 65536"}, original.ToLXCString())
+
+	// Sharing even one host ID must still be rejected.
+	overlap := Set{Entries: []Entry{
+		{IsUID: true, HostID: 1065535, NSID: 0, MapRange: 65536},
+	}}
+	assert.ErrorIs(t, overlap.AddSafe(replacement), ErrHostIDIsSubID)
+}
