{ inputs, ... }:
{
  den.aspects.core.hoopsnake.nixos =
    { ... }:
    {
      imports = [
        (import (inputs.self + "/generated/hoopsnake/module.nix") {
          withSystem =
            system: f:
            f {
              config.packages.default = inputs.hoopsnake.packages.${system}.default;
            };
        })
      ];
    };

  perSystem =
    { pkgs, ... }:
    let
      source = pkgs.applyPatches {
        name = "hoopsnake-systemd-initrd-source";
        src = inputs.hoopsnake.outPath;
        patches = [ ./hoopsnake-systemd-initrd.patch ];
      };
    in
    {
      files.file = {
        "generated/hoopsnake/module.nix".source =
          pkgs.runCommand "hoopsnake-systemd-initrd-module.nix" { }
            ''
              printf '%s\n' \
                '# Generated by modules/den/aspects/core/hoopsnake.nix; do not edit.' \
                '# Modified from boinkor-net/hoopsnake for systemd-only initrd.' \
                '# Copyright 2024 Andreas Fuchs; Apache-2.0, see LICENSE.' > $out
              cat ${source}/nixos/module.nix >> $out
            '';
        "generated/hoopsnake/LICENSE".text = builtins.readFile (inputs.hoopsnake + "/LICENSE");
      };
    };
}
