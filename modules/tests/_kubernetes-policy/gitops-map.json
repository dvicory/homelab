{
  "policy": "verification-gitops",
  "policyFile": "gitops.yaml",
  "rules": [
    "gitops-population",
    "application-lifecycle",
    "application-directory-source",
    "application-source-confinement",
    "application-source-inventory",
    "application-source-coverage",
    "resource-retention",
    "resource-effective-identity",
    "root-project-ownership",
    "project-repository-destination-authority",
    "project-cluster-authority",
    "application-lifecycle-order",
    "bootstrap-provenance",
    "bootstrap-default-authority",
    "argocd-server-network-ingress",
    "root-project-source-ownership",
    "project-destination-coverage",
    "bootstrap-seed-identity"
  ],
  "classification": "offline-local-and-repository-only",
  "admission": {
    "enforced": false,
    "possibleFutureLocalRules": [
      "application-directory-source",
      "application-lifecycle",
      "application-source-confinement",
      "argocd-server-network-ingress",
      "bootstrap-default-authority",
      "project-repository-destination-authority",
      "root-project-ownership"
    ],
    "requirements": "Local rules already match actual resource GroupKinds and use native ConfigMap CEL parameters. Installing policies/parameters and deliberately scoping them for production admission is outside this offline gate; population, provenance, source-file and ownership joins remain repository-only."
  },
  "interface": {
    "anchor": {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "name": "verification-bundle",
      "namespace": "verification",
      "celBundle": "object.bundle",
      "jmespathBundle": "request.object.bundle"
    },
    "requiredRawFields": [
      "resources[].{file,document,object,content}",
      "files[] (all original relative files)",
      "directories[] (all relative directories excluding root)",
      "bootstrap[].{file,document,object,content} (independent actual bootstrapPackage)",
      "builtinScopes[].{group,kind,scope} (pinned built-in Kubernetes GroupKinds only)",
      "expected.{repository,revision,prefix,project,destination,appendNameWithEnv}"
    ],
    "scope": "Actual rendered CRD spec.group/spec.names.kind/spec.scope plus pinned known built-in scopes; namespace defaults to owner destination for namespaced objects. Identity ignores served version and preserves every document.",
    "content": "Exact original file text for independent byte-preserving seed comparison; helper must not copy canonical bootstrap into seed.",
    "parameters": {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "name": "policy-facts",
      "namespace": "verification",
      "parameterNotFoundAction": "Deny",
      "rawData": [
        "repository",
        "revision",
        "prefix",
        "project",
        "destination",
        "appendNameWithEnv"
      ],
      "provenance": "Packaging writes data strings from the actual evaluated raw Nixidy leaves for each variant; checked-in shared policy-facts.yaml is the observed normal-ready-trustedEdges snapshot, not a policy verdict."
    },
    "nativeFixtures": {
      "format": "Ordinary cli.kyverno.io/v1alpha1 Test with top-level policies/resources/paramResources/variables/results. Every result uses resources: [] and exact resourceSpecs identity.",
      "local": "Checked-in resources.yaml is an actual variant resource copy with development-time mechanical edits; CLI consumes that ordinary resource directly.",
      "crossObject": "Checked-in mutate.yq is an ordinary yq filter over .bundle only, applied to the complete actual variant anchor. Packaging then transports resulting .bundle.resources[].object and the independent seed default AppProject alongside the anchor, without semantic selection.",
      "positiveCatalog": "13 checked-in positive Tests independently name actual observed Application/AppProject/Argo NetworkPolicy identities and every anchor rule. Packaging supplies their complete actual variant resource population, not another phase snapshot.",
      "variant": "metadata.annotations verification.homelab/variant chooses the exact actual render."
    }
  },
  "nativeCapabilitySources": [
    "https://kyverno.io/docs/policy-types/cluster-policy/validate/#cel-variables",
    "https://raw.githubusercontent.com/kyverno/kyverno/v1.19.0/pkg/engine/handlers/validation/validate_cel.go",
