(.bundle.resources[] | select(.object.kind == "NetworkPolicy" and .object.metadata.name == "jellyfin-configuration-ingress" and .object.metadata.namespace == "jellyfin" and .object.apiVersion == "networking.k8s.io/v1")) |= (.object["spec"]["ingress"][0]["from"][0]["podSelector"]["matchLabels"]["app.kubernetes.io/name"] = "not-jellarr")
