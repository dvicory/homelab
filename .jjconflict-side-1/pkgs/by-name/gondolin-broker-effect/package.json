{
  "name": "gondolin-broker-effect",
  "version": "0.1.0",
  "private": true,
  "description": "Effect-based HTTP broker for Gondolin/QEMU sandboxes",
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "workspaces": [
    "policy-kernel"
  ],
  "bin": {
    "gondolin-broker-effect": "./dist/main.js"
  },
  "scripts": {
    "build:policy": "npm run build --workspace @agent-x/policy-kernel",
    "build": "npm run build:policy && tsc -p tsconfig.json",
    "test": "npm run build && node --test policy-kernel/test/*.test.mjs test/*.test.mjs"
  },
  "dependencies": {
    "@agent-x/policy-kernel": "0.1.0",
    "@earendil-works/gondolin": "0.12.0",
    "@effect/platform": "0.97.0",
    "@effect/platform-node": "0.108.0",
    "effect": "3.22.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "typescript": "5.7.3"
  }
}
